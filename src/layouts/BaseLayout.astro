---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import { entity } from "../data/entity";

interface Props {
  /** {Question or promise} — the "| WriteExpertBook" suffix is added here. */
  title: string;
  /** The direct answer, compressed to ~150 chars. */
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const fullTitle = `${title} | ${entity.brandName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <OrganizationSchema />
    <slot name="head" />
  </head>
  <body class="bg-ivory-50 text-ink-900 min-h-screen flex flex-col">
    <AnnouncementBar />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>
