---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import FinalDoorCTA from "../components/FinalDoorCTA.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import SpeakableSchema from "../components/schema/SpeakableSchema.astro";

interface Props {
  entry: CollectionEntry<"guides">;
}
const { entry } = Astro.props;
const g = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={g.title} description={g.description.slice(0, 150)}>
  <Fragment slot="head">
    <BreadcrumbSchema items={[{ name: "Guides", path: "/guides" }, { name: g.title, path: Astro.url.pathname }]} />
    <SpeakableSchema name={g.title} selectors={["article.prose > p:first-of-type"]} />
  </Fragment>

  <!-- Same hero as every other inner page (breadcrumbs, eyebrow, door-glow,
       proof card), with the "Updated" date as the meta line under the intro. -->
  <PageHero
    eyebrow={`Guide · ${g.stage}`}
    heading={g.title}
    lead={g.description}
    crumbs={[{ label: "Guides", href: "/guides" }, { label: g.title }]}
  >
    <p class="guide-meta">
      <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <rect x="2.5" y="3.5" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.4" />
        <path d="M2.5 7h13M5.5 2v3M12.5 2v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      </svg>
      <span>Updated <time datetime={g.updatedDate.toISOString().slice(0, 10)}>{g.updatedDate.toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" })}</time></span>
    </p>
  </PageHero>

  <article class="prose bg-ivory-50 max-w-[68ch] mx-auto px-4 py-14 md:py-20 border-b border-navy-100">
    <Content />
  </article>

  {g.faqs.length > 0 && <FAQAccordion faqs={g.faqs} />}

  <FinalDoorCTA />
</BaseLayout>

<style>
  /* Meta line under the hero intro: a quiet pill, gold icon, off-white text. */
  .guide-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid rgba(245, 241, 232, 0.18);
    border-radius: 999px;
    font-size: 0.85rem;
    line-height: 1.3;
    color: rgba(245, 241, 232, 0.8);
  }
  .guide-meta svg {
    flex-shrink: 0;
    color: var(--color-gold-300);
  }

  /*
    @tailwindcss/typography is installed and provides the base `.prose`
    styling; this block layers brand-specific colors/spacing on top of its
    generic defaults (navy headings, gold list markers/blockquote rule/link
    underline, matching src/styles/global.css tokens). Astro's scoped styles
    compile outside any @layer, so they win over the plugin's `@layer
    utilities` rules automatically, without needing !important. Astro's
    scoped styles don't reach markup produced by a child render (here, the
    Markdown-to-HTML output of <Content />), so descendants are reached via
    :global() — the documented Astro pattern for styling rendered Markdown.
  */
  .prose :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.75rem);
    color: var(--color-navy-900);
    /* An in-page jump to a heading lands clear of the sticky header. */
    scroll-margin-top: 6.5rem;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-navy-900);
  }
  .prose :global(p) {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .prose :global(p:first-child) {
    margin-top: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }
  .prose :global(li)::marker {
    color: var(--color-gold-500);
  }
  .prose :global(a) {
    color: var(--color-navy-700);
    text-decoration: underline;
    text-decoration-color: var(--color-gold-300);
    text-underline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .prose :global(a:hover) {
      color: var(--color-gold-500);
      text-decoration-color: var(--color-gold-500);
    }
  }
  .prose :global(strong) {
    color: var(--color-navy-900);
    font-weight: 700;
  }
  .prose :global(blockquote) {
    margin: 1.75rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-gold-300);
    font-style: italic;
    color: var(--color-slate-500);
  }
  .prose :global(hr) {
    margin: 2.5rem 0;
    border: none;
    border-top: 1px solid var(--color-navy-100);
  }
  .prose :global(code) {
    background: var(--color-navy-100);
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }
</style>
