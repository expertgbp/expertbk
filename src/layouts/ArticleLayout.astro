---
import { getEntry, render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import AuthorBox from "../components/AuthorBox.astro";
import FinalDoorCTA from "../components/FinalDoorCTA.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import ArticleSchema from "../components/schema/ArticleSchema.astro";
import PersonSchema from "../components/schema/PersonSchema.astro";
import SpeakableSchema from "../components/schema/SpeakableSchema.astro";

interface Props {
  entry: CollectionEntry<"blog">;
}
const { entry } = Astro.props;
const post = entry.data;
const { Content } = await render(entry);

const pillar = await getEntry("guides", post.pillar).catch(() => undefined);
---

<BaseLayout
  title={post.title}
  description={post.description.slice(0, 150)}
  ogImage={post.heroImage}
  ogImageAlt={post.heroImageAlt}
  ogType="article"
  publishDate={post.publishDate}
  updatedDate={post.updatedDate}
  authorName={post.author}
>
  <Fragment slot="head">
    <BreadcrumbSchema items={[{ name: "Blog", path: "/blog" }, { name: post.title, path: Astro.url.pathname }]} />
    <ArticleSchema headline={post.title} description={post.description} authorName={post.author} datePublished={post.publishDate} dateModified={post.updatedDate} image={post.heroImage} />
    <PersonSchema name={post.author} />
    <SpeakableSchema name={post.title} selectors={["article.prose > p:first-of-type"]} />
  </Fragment>

  <section class="bg-navy-900 text-offwhite-100">
    <div class="mx-auto max-w-3xl px-4 py-16">
      <p class="eyebrow mb-4">{post.cluster}</p>
      <h1 class="on-navy">{post.title}</h1>
      <p class="mt-4 text-sm opacity-70">
        By {post.author} &middot; {post.publishDate.toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" })}
      </p>
    </div>
  </section>

  {post.heroImage && (
    <div class="bg-navy-900">
      <div class="mx-auto max-w-4xl px-4 pb-10">
        <img
          src={post.heroImage}
          alt={post.heroImageAlt ?? post.title}
          width="1820"
          height="1024"
          loading="eager"
          fetchpriority="high"
          class="w-full h-auto rounded-2xl border border-navy-600"
        />
      </div>
    </div>
  )}

  <article class="prose bg-ivory-50 max-w-[68ch] mx-auto px-4 py-14 border-b border-navy-100">
    <Content />
  </article>

  <div class="max-w-[68ch] mx-auto px-4 pt-10 pb-4 bg-ivory-50">
    <AuthorBox authorName={post.author} />
  </div>

  {pillar && (
    <div class="mx-auto max-w-3xl px-4 pt-8 pb-2">
      <a href={`/guides/${pillar.id}`} class="inline-flex items-center gap-2 text-sm font-semibold text-navy-700 hover:text-gold-500">
        <span aria-hidden="true">&larr;</span> Back to the full guide: {pillar.data.title}
      </a>
    </div>
  )}

  <FAQAccordion faqs={post.faqs} heading="Quick answers" />

  <FinalDoorCTA secondaryLabel={post.ctaVariant.leadMagnetLabel} secondaryHref={post.ctaVariant.leadMagnetSlug} />
</BaseLayout>

<style>
  /*
    @tailwindcss/typography is installed and provides the base `.prose`
    styling; this block layers brand-specific colors/spacing on top of its
    generic defaults (navy headings, gold list markers/blockquote rule/link
    underline, matching src/styles/global.css tokens). Astro's scoped styles
    compile outside any @layer, so they win over the plugin's `@layer
    utilities` rules automatically, without needing !important. Astro's
    scoped styles don't reach markup produced by a child render (here, the
    Markdown-to-HTML output of <Content />), so descendants are reached via
    :global() — the documented Astro pattern for styling rendered Markdown.
  */
  .prose :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.75rem);
    color: var(--color-navy-900);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-navy-900);
  }
  .prose :global(p) {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .prose :global(p:first-child) {
    margin-top: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }
  .prose :global(li)::marker {
    color: var(--color-gold-500);
  }
  .prose :global(a) {
    color: var(--color-navy-700);
    text-decoration: underline;
    text-decoration-color: var(--color-gold-300);
    text-underline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .prose :global(a:hover) {
      color: var(--color-gold-500);
      text-decoration-color: var(--color-gold-500);
    }
  }
  .prose :global(strong) {
    color: var(--color-navy-900);
    font-weight: 700;
  }
  .prose :global(blockquote) {
    margin: 1.75rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-gold-300);
    font-style: italic;
    color: var(--color-slate-500);
  }
  /* Inline supporting photos (real, licensed Pexels photography, distinct
     from the on-brand illustrated hero) and their credit line. */
  .prose :global(figure) {
    margin: 2rem 0;
  }
  .prose :global(figure img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-navy-100);
  }
  .prose :global(figcaption) {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-slate-500);
    text-align: center;
  }
  .prose :global(figcaption a) {
    color: var(--color-slate-500);
    text-decoration: underline;
    text-decoration-color: var(--color-navy-100);
  }
  /* Inline comparison charts (inline SVG, dark-mode-safe, no library). */
  .prose :global(.chart-block) {
    margin: 2rem 0;
    padding: 1.25rem 1.25rem 0.75rem;
    background: var(--color-navy-100);
    border-radius: var(--radius-card);
  }
  .prose :global(.chart-block p) {
    margin-top: 0 !important;
  }
  .prose :global(.chart-source) {
    margin-top: 0.5rem !important;
    font-size: 0.78rem;
    color: var(--color-slate-500);
  }
  .prose :global(hr) {
    margin: 2.5rem 0;
    border: none;
    border-top: 1px solid var(--color-navy-100);
  }
  .prose :global(code) {
    background: var(--color-navy-100);
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }
</style>
