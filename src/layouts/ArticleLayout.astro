---
import { getEntry, render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import AuthorBox from "../components/AuthorBox.astro";
import FinalDoorCTA from "../components/FinalDoorCTA.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import ArticleSchema from "../components/schema/ArticleSchema.astro";
import PersonSchema from "../components/schema/PersonSchema.astro";
import SpeakableSchema from "../components/schema/SpeakableSchema.astro";

interface Props {
  entry: CollectionEntry<"blog">;
}
const { entry } = Astro.props;
const post = entry.data;
const { Content, headings } = await render(entry);
// Astro auto-assigns an id to every heading in the rendered markdown output
// (visible in the built HTML as <h2 id="...">), so these slugs are already
// real anchors on the page — no separate slugify step needed here.
const tocItems = headings.filter((h) => h.depth === 2);

const pillar = await getEntry("guides", post.pillar).catch(() => undefined);

// Initials avatar in the meta line (same honest stand-in AuthorBox uses:
// no invented headshot).
const authorInitials = post.author.split(" ").map((w) => w[0]).join("");

// Each hero ships as three files (scripts/optimize-blog-images.mjs):
// <name>.webp (1600w), <name>-800.webp for small screens, and
// <name>-og.jpg (1200x630) for social shares and the Article schema.
const heroSrcset = post.heroImage?.endsWith(".webp")
  ? `${post.heroImage.replace(/.webp$/, "-800.webp")} 800w, ${post.heroImage} 1600w`
  : undefined;
const shareImage = post.heroImage?.endsWith(".webp") ? post.heroImage.replace(/.webp$/, "-og.jpg") : post.heroImage;
---

<BaseLayout
  title={post.title}
  description={post.description.slice(0, 150)}
  ogImage={shareImage}
  ogImageAlt={post.heroImageAlt}
  ogType="article"
  publishDate={post.publishDate}
  updatedDate={post.updatedDate}
  authorName={post.author}
>
  <Fragment slot="head">
    <BreadcrumbSchema items={[{ name: "Blog", path: "/blog" }, { name: post.title, path: Astro.url.pathname }]} />
    <ArticleSchema headline={post.title} description={post.description} authorName={post.author} datePublished={post.publishDate} dateModified={post.updatedDate} image={shareImage} />
    <PersonSchema name={post.author} />
    <SpeakableSchema name={post.title} selectors={["article.prose > p:first-of-type"]} />
  </Fragment>

  <!-- Same look as PageHero (breadcrumbs, eyebrow, door-glow), built here
       rather than with that component because a post's hero image needs a
       full half of the row, wider than PageHero's fixed proof-card column. -->
  <section class="relative overflow-hidden bg-navy-900 text-offwhite-100">
    <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
      <div class="absolute inset-y-0 right-[-10%] w-[60%] bg-gradient-to-l from-gold-300/20 via-gold-300/5 to-transparent"></div>
      <div class="absolute -bottom-1/3 -left-1/4 h-[70%] w-[55%] rounded-full bg-navy-600/40 blur-3xl"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-6xl px-4 py-12 md:py-16 lg:py-20 grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-10 lg:gap-14 items-center">
      <div class="hero-enter min-w-0">
        <nav class="article-crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-hidden="true">/</span><a href="/blog">Blog</a></li>
            <li><span aria-hidden="true">/</span><span class="article-crumb-current" aria-current="page">{post.title}</span></li>
          </ol>
        </nav>
        <p class="eyebrow mb-4">{post.cluster}</p>
        <h1 class="on-navy article-hero-title">{post.title}</h1>
        <p class="mt-5 opacity-80 text-lg leading-relaxed">{post.description}</p>
        <div class="article-meta">
          <span class="article-meta-avatar" aria-hidden="true">{authorInitials}</span>
          <p>
            By {post.author} &middot; <time datetime={post.publishDate.toISOString().slice(0, 10)}>{post.publishDate.toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" })}</time>
          </p>
          {post.updatedDate && (
            <p class="article-meta-updated">
              Updated <time datetime={post.updatedDate.toISOString().slice(0, 10)}>{post.updatedDate.toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" })}</time>
            </p>
          )}
        </div>
      </div>

      {post.heroImage && (
        <div class="article-hero-media">
          <img
            src={post.heroImage}
            srcset={heroSrcset}
            sizes="(min-width: 1100px) 1040px, 100vw"
            alt={post.heroImageAlt ?? post.title}
            width="1600"
            height="900"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="article-hero-img"
          />
        </div>
      )}
    </div>
  </section>

  <div class="bg-ivory-50 border-b border-navy-100">
    <div class="mx-auto max-w-5xl px-4 py-14 md:py-20 grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-x-12 gap-y-8 items-start">
      {tocItems.length > 0 && (
        <details class="toc-mobile lg:hidden card p-4">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-semibold text-navy-900 min-h-11 -m-1 p-1 rounded-lg">
            On this page
            <svg width="12" height="12" viewBox="0 0 14 14" class="toc-chevron shrink-0 text-navy-600" aria-hidden="true">
              <path d="M1 3l6 6 6-6" stroke="currentColor" stroke-width="1.5" fill="none" />
            </svg>
          </summary>
          <ul class="toc-mobile-list mt-3 text-sm">
            {tocItems.map((h) => (
              <li><a href={`#${h.slug}`} class="text-navy-700 hover:text-gold-500">{h.text}</a></li>
            ))}
          </ul>
        </details>
      )}

      <article class="prose order-2 lg:order-1 max-w-[68ch]">
        <Content />
      </article>

      {tocItems.length > 0 && (
        <aside class="toc-desktop hidden lg:block order-3 sticky top-24 text-sm" aria-label="Table of contents">
          <p class="eyebrow mb-3">On this page</p>
          <ul class="space-y-1 border-l border-navy-100">
            {tocItems.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="toc-link block pl-3 -ml-px border-l-2 border-transparent py-1.5 pr-2 rounded-r text-slate-500">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 pt-10 pb-4 bg-ivory-50 grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-x-12">
    <!-- The author box and the way back to the pillar guide share the
         article's own column, so both line up under the text they follow. -->
    <div class="max-w-[68ch] grid gap-4">
      <AuthorBox authorName={post.author} />
      {pillar && (
        <a href={`/guides/${pillar.id}`} class="pillar-link">
          <span class="pillar-link-arrow" aria-hidden="true">&larr;</span>
          <span>Back to the full guide: {pillar.data.title}</span>
        </a>
      )}
    </div>
  </div>

  <FAQAccordion faqs={post.faqs} heading="Quick answers" />

  <FinalDoorCTA secondaryLabel={post.ctaVariant.leadMagnetLabel} secondaryHref={post.ctaVariant.leadMagnetSlug} />
</BaseLayout>

<style>
  /*
    The sitewide h1 (global.css) clamps up to 4rem, sized for a full-width
    marketing hero. This hero now shares its row with the post's image in a
    two-column grid, so the heading column is roughly half that width —
    the sitewide size would wrap awkwardly. Scoped smaller clamp for this
    context only; other h1s on the site are untouched.
  */
  .article-hero-title {
    font-size: clamp(1.75rem, 1.4rem + 1.8vw, 2.75rem);
  }

  /* Breadcrumbs: same treatment as PageHero's. The last crumb is the post
     title, which is long, so it stays on one line and trails off. */
  .article-crumbs {
    margin-bottom: 1.5rem;
    font-size: 0.8rem;
  }
  .article-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
  }
  .article-crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    color: rgba(245, 241, 232, 0.6);
  }
  .article-crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    transition: color var(--duration-fast) var(--ease-hover);
  }
  .article-crumb-current {
    overflow: hidden;
    max-width: min(24rem, 52vw);
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-gold-300);
  }
  @media (hover: hover) and (pointer: fine) {
    .article-crumbs a:hover {
      color: var(--color-offwhite-100);
    }
  }

  /* Meta line: who wrote it and when, with the "Updated" date as a pill
     when the post has one. */
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.75rem;
    margin-top: 1.75rem;
    font-size: 0.9rem;
    line-height: 1.4;
    color: rgba(245, 241, 232, 0.8);
  }
  .article-meta-avatar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--color-gold-300);
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-navy-900);
  }
  .article-meta-updated {
    padding: 0.3rem 0.75rem;
    border: 1px solid rgba(245, 241, 232, 0.18);
    border-radius: 999px;
    font-size: 0.8rem;
  }

  /* Hero image: the same gold backing block as the homepage hero photo and
     the founders photo, peeking out of the top-left corner. No entrance
     animation on purpose: this image is the page's largest paint. */
  .article-hero-media {
    position: relative;
  }
  .article-hero-media::before {
    content: "";
    position: absolute;
    top: -0.6rem;
    left: -0.6rem;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 18px;
    background: var(--color-gold-300);
  }
  .article-hero-img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-navy-600);
    border-radius: 20px;
    box-shadow: 0 30px 60px -30px rgba(3, 12, 22, 0.9);
  }

  /*
    Static card look (background, border, shadow), deliberately not the
    shared .card class — .card's hover state lifts/shadows the whole
    element, which reads as an odd interaction for a nav box you scan and
    click links inside of, rather than a single clickable surface.
  */
  .toc-desktop {
    background-color: #fff;
    border: 1px solid var(--color-navy-100);
    border-radius: 18px;
    box-shadow: var(--shadow-sm);
    padding: 1.25rem;
    /* A long contents list scrolls inside the card instead of running off
       the bottom of a short screen. */
    max-height: calc(100vh - 7.5rem);
    overflow-y: auto;
  }
  /* Mobile contents list: full-width rows, each a 44px touch target. */
  .toc-mobile-list li + li {
    border-top: 1px solid var(--color-navy-100);
  }
  .toc-mobile-list a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 0;
    line-height: 1.35;
  }

  /* The way back to the pillar guide: a quiet card-row under the author
     box. The arrow steps back on hover, mirroring .arrow-link. */
  .pillar-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--color-navy-100);
    border-radius: var(--radius-card);
    background: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-navy-700);
    transition: border-color var(--duration-fast) var(--ease-hover), color var(--duration-fast) var(--ease-hover);
  }
  .pillar-link-arrow {
    flex-shrink: 0;
    color: var(--color-gold-500);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .pillar-link:hover {
      border-color: var(--color-gold-300);
      color: var(--color-navy-900);
    }
    .pillar-link:hover .pillar-link-arrow {
      transform: translateX(-3px);
    }
  }
  .toc-link {
    transition: background-color var(--duration-fast) var(--ease-hover), border-color var(--duration-fast) var(--ease-hover),
      color var(--duration-fast) var(--ease-hover);
  }
  @media (hover: hover) and (pointer: fine) {
    .toc-link:hover {
      background-color: var(--color-navy-100);
      border-color: var(--color-gold-300);
      color: var(--color-navy-900);
    }
  }

  /*
    @tailwindcss/typography is installed and provides the base `.prose`
    styling; this block layers brand-specific colors/spacing on top of its
    generic defaults (navy headings, gold list markers/blockquote rule/link
    underline, matching src/styles/global.css tokens). Astro's scoped styles
    compile outside any @layer, so they win over the plugin's `@layer
    utilities` rules automatically, without needing !important. Astro's
    scoped styles don't reach markup produced by a child render (here, the
    Markdown-to-HTML output of <Content />), so descendants are reached via
    :global() — the documented Astro pattern for styling rendered Markdown.
  */
  .prose :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.75rem);
    color: var(--color-navy-900);
    /* A jump from the contents list lands clear of the sticky header. */
    scroll-margin-top: 6.5rem;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-navy-900);
  }
  .prose :global(p) {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .prose :global(p:first-child) {
    margin-top: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }
  .prose :global(li)::marker {
    color: var(--color-gold-500);
  }
  .prose :global(a) {
    color: var(--color-navy-700);
    text-decoration: underline;
    text-decoration-color: var(--color-gold-300);
    text-underline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .prose :global(a:hover) {
      color: var(--color-gold-500);
      text-decoration-color: var(--color-gold-500);
    }
  }
  .prose :global(strong) {
    color: var(--color-navy-900);
    font-weight: 700;
  }
  .prose :global(blockquote) {
    margin: 1.75rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-gold-300);
    font-style: italic;
    color: var(--color-slate-500);
  }
  /*
    Key Takeaways callout: a scannable summary box, not a pull-quote, so it
    gets its own class rather than reusing <blockquote> (Tailwind Typography's
    default blockquote styling adds decorative smart-quote marks via
    ::before/::after, which reads oddly on a bulleted summary rather than an
    actual quotation).
  */
  .prose :global(.key-takeaways) {
    margin: 1.75rem 0;
    padding: 1.1rem 1.4rem;
    background-color: var(--color-gold-100);
    border-left: 3px solid var(--color-gold-500);
    border-radius: var(--radius-card);
  }
  .prose :global(.key-takeaways p) {
    margin: 0 0 0.6rem !important;
    font-weight: 700;
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }
  .prose :global(.key-takeaways ul) {
    margin: 0 !important;
  }
  .prose :global(.key-takeaways li) {
    margin-bottom: 0.4rem;
  }
  /* Inline supporting photos (real, licensed Pexels photography, distinct
     from the on-brand illustrated hero). Pexels' license doesn't require
     attribution, so these run without a visible credit line; .prose
     figcaption styling stays in place for any future descriptive caption. */
  .prose :global(figure) {
    margin: 2rem 0;
  }
  .prose :global(figure img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-navy-100);
  }
  .prose :global(figcaption) {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-slate-500);
    text-align: center;
  }
  .prose :global(figcaption a) {
    color: var(--color-slate-500);
    text-decoration: underline;
    text-decoration-color: var(--color-navy-100);
  }
  /* Inline comparison charts (inline SVG, dark-mode-safe, no library). */
  .prose :global(.chart-block) {
    margin: 2rem 0;
    padding: 1.25rem 1.25rem 0.75rem;
    background: var(--color-navy-100);
    border-radius: var(--radius-card);
  }
  .prose :global(.chart-block p) {
    margin-top: 0 !important;
  }
  .prose :global(.chart-source) {
    margin-top: 0.5rem !important;
    font-size: 0.78rem;
    color: var(--color-slate-500);
  }
  .prose :global(hr) {
    margin: 2.5rem 0;
    border: none;
    border-top: 1px solid var(--color-navy-100);
  }
  .prose :global(code) {
    background: var(--color-navy-100);
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }

  .toc-chevron {
    transition: transform var(--duration-base) var(--ease-out);
  }
  .toc-mobile[open] .toc-chevron {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .toc-chevron {
      transition: none;
    }
  }
</style>
