---
import { getEntry, render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SplitSection from "../components/SplitSection.astro";
import ObstacleCards from "../components/ObstacleCards.astro";
import ProofCards from "../components/ProofCards.astro";
import PathSteps from "../components/PathSteps.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CardGrid from "../components/CardGrid.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import FinalDoorCTA from "../components/FinalDoorCTA.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import SpeakableSchema from "../components/schema/SpeakableSchema.astro";

interface Props {
  entry: CollectionEntry<"professions">;
}
const { entry } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);
const label = p.professionLabel.toLowerCase();

const relatedBooks = (
  await Promise.all(p.relatedBooks.map((slug) => getEntry("books", slug)))
).filter((b): b is NonNullable<typeof b> => Boolean(b));
---

<BaseLayout title={p.title} description={p.answerBlock.slice(0, 150)}>
  <Fragment slot="head">
    <BreadcrumbSchema items={[{ name: "For Experts", path: "/for" }, { name: p.professionLabel, path: Astro.url.pathname }]} />
    <SpeakableSchema name={p.title} />
  </Fragment>

  <!-- 1. H1 + 2. Direct answer block -->
  <PageHero
    eyebrow={`For ${p.professionLabel}s`}
    heading={p.title}
    answer={p.answerBlock}
    crumbs={[{ label: "For Experts", href: "/for" }, { label: p.professionLabel }]}
    primaryLabel={p.cta.primaryLabel}
    secondaryLabel={p.cta.leadMagnetLabel}
    secondaryHref={p.cta.leadMagnetSlug}
    ctaId="profession-hero"
  />

  <!-- 3. Identity mirror -->
  <SplitSection eyebrow="Where you are now" heading="Sound familiar?">
    <p>{p.identityMirror}</p>
    {p.crossLinks && p.crossLinks.length > 0 && (
      <ul class="cross-links">
        {p.crossLinks.map((c) => (
          <li>
            {c.prefix} <a href={c.href} class="arrow-link">{c.linkLabel} <span class="arrow" aria-hidden="true">&rarr;</span></a>
          </li>
        ))}
      </ul>
    )}
  </SplitSection>

  <!-- 4. Obstacle map -->
  <section class="bg-navy-100">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <SectionHeading eyebrow="The obstacles" heading="What's actually in your way" />
      <div class="mt-10 md:mt-12">
        <ObstacleCards items={p.obstacles} />
      </div>
    </div>
  </section>

  <!-- 5. What your book does -->
  <SplitSection eyebrow="The payoff" heading={`What your book does for a ${label}`}>
    <p>{p.whatItDoes}</p>
  </SplitSection>

  <!-- 6. The path -->
  <section class="path-band relative overflow-hidden bg-navy-900 text-offwhite-100">
    <div class="relative mx-auto max-w-5xl px-4 py-16 md:py-24">
      <SectionHeading eyebrow="Our method" heading="The EPIC Publishing Path, for your calendar" align="center" dark />
      <div class="mt-14 md:mt-16">
        <PathSteps theme="dark" overrides={p.pathNote ? { engineer: p.pathNote } : {}} />
      </div>
    </div>
  </section>

  <!-- 7. Proof -->
  <section class="bg-ivory-50">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <SectionHeading eyebrow="Proof" heading="Proof from the path you're on" />
      <div class="mt-10 md:mt-12 grid gap-5">
        <TestimonialCard {...p.proof} />
        <ProofCards />
      </div>
    </div>
  </section>

  <!-- 8. Book types this profession writes -->
  {relatedBooks.length > 0 && (
    <section class="bg-navy-100">
      <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
        <SectionHeading eyebrow="Your book" heading={`Book types ${label}s write`} />
        <div class="mt-10 md:mt-12">
          <CardGrid items={relatedBooks.map((b) => ({ title: b.data.bookTypeLabel, description: b.data.answerBlock.slice(0, 90) + "…", href: `/books/${b.id}` }))} />
        </div>
      </div>
    </section>
  )}

  <!-- Optional extra body content (Markdown) -->
  <section class="bg-ivory-50 prose prose-lg max-w-3xl mx-auto px-4 py-6">
    <Content />
  </section>

  <!-- 9. FAQ -->
  <FAQAccordion faqs={p.faqs} heading={`Questions ${label}s ask us`} />

  <!-- 10. CTA band -->
  <FinalDoorCTA secondaryLabel={p.cta.leadMagnetLabel} secondaryHref={p.cta.leadMagnetSlug} />
</BaseLayout>

<style>
  .cross-links {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-navy-100);
    font-size: 1rem;
    color: var(--color-slate-500);
  }
  .cross-links a {
    font-weight: 600;
    color: var(--color-navy-700);
  }
  @media (hover: hover) and (pointer: fine) {
    .cross-links a:hover {
      color: var(--color-gold-500);
    }
  }
  /* The door-glow, quieter, so the method band isn't a flat navy slab. */
  .path-band::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 55% 70% at 100% 0%, rgba(255, 217, 138, 0.12), transparent 70%);
  }
</style>
