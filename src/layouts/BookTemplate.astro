---
import { getEntry, render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SplitSection from "../components/SplitSection.astro";
import ObstacleCards from "../components/ObstacleCards.astro";
import ProofCards from "../components/ProofCards.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CardGrid from "../components/CardGrid.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import FinalDoorCTA from "../components/FinalDoorCTA.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import SpeakableSchema from "../components/schema/SpeakableSchema.astro";
import { bookTypeGroups } from "../data/nav";

interface Props {
  entry: CollectionEntry<"books">;
}
const { entry } = Astro.props;
const b = entry.data;
const { Content } = await render(entry);

const relatedProfessions = (
  await Promise.all(b.relatedProfessions.map((slug) => getEntry("professions", slug)))
).filter((p): p is NonNullable<typeof p> => Boolean(p));

// The hub this book type sits beneath (change-spec Change 6/B13): looked
// up from the single nav.ts source of truth rather than duplicated here.
const hub = bookTypeGroups.find((g) => g.items.some((i) => i.href === `/books/${entry.id}`));
const breadcrumbItems = [
  { name: "Your Book", path: "/books" },
  ...(hub && hub.headingHref ? [{ name: hub.heading, path: hub.headingHref }] : []),
  { name: b.bookTypeLabel, path: Astro.url.pathname },
];
---

<BaseLayout title={b.title} description={b.answerBlock.slice(0, 150)}>
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbItems} />
    <SpeakableSchema name={b.title} />
  </Fragment>

  <PageHero
    eyebrow={b.bookTypeLabel}
    heading={b.title}
    answer={b.answerBlock}
    crumbs={breadcrumbItems.map((c, i) => ({ label: c.name, href: i < breadcrumbItems.length - 1 ? c.path : undefined }))}
    primaryLabel={b.cta.primaryLabel}
    secondaryLabel={b.cta.leadMagnetLabel}
    secondaryHref={b.cta.leadMagnetSlug}
    ctaId="book-hero"
  />

  <SplitSection eyebrow="The author" heading="Who writes this book">
    <p>{b.whoWritesThis}</p>
  </SplitSection>

  <section class="bg-navy-100">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <SectionHeading eyebrow="The obstacles" heading="The pains specific to this book" />
      <div class="mt-10 md:mt-12">
        <ObstacleCards items={b.painPoints} />
      </div>
    </div>
  </section>

  <SplitSection eyebrow="The process" heading="How the process differs for this book">
    <p>{b.processDifferences}</p>
  </SplitSection>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <SectionHeading eyebrow="Results" heading="Proof" />
      <div class="mt-10 md:mt-12 grid gap-5">
        <TestimonialCard {...b.proof} />
        <ProofCards />
      </div>
    </div>
  </section>

  {relatedProfessions.length > 0 && (
    <section class="bg-navy-100">
      <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
        <SectionHeading eyebrow="For experts" heading="Who else writes this kind of book" />
        <div class="mt-10 md:mt-12">
          <CardGrid items={relatedProfessions.map((p) => ({ title: p.data.professionLabel, description: p.data.answerBlock.slice(0, 90) + "…", href: `/for/${p.id}` }))} />
        </div>
      </div>
    </section>
  )}

  <section class="bg-ivory-50 prose prose-lg max-w-3xl mx-auto px-4 py-6">
    <Content />
  </section>

  <FAQAccordion faqs={b.faqs} heading={`Questions about writing a ${b.bookTypeLabel.toLowerCase()}`} />

  <FinalDoorCTA secondaryLabel={b.cta.leadMagnetLabel} secondaryHref={b.cta.leadMagnetSlug} />
</BaseLayout>
