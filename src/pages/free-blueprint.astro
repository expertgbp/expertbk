---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FormCard from "../components/FormCard.astro";
import LeadMagnetForm from "../components/LeadMagnetForm.astro";
import blueprintMockup from "../assets/images/homepage/blueprint-mockup.png";

// What's inside the guide: the page's original three bullet points.
const points = [
  "The three walls that stop most experts, and how to take each one down.",
  "An honest look at what publishing actually costs, no hidden number.",
  "The three decisions to make before you write a single word.",
];
---

<BaseLayout
  title="Get the Expert Book Blueprint (Free)"
  description="A free, plain-English guide: how professionals structure a book around a full calendar, what publishing actually costs, and the three decisions to make before you write a word."
>
  <!-- The homepage Blueprint section's model, as the whole page: the pitch
       and check-marked points on the left of the navy hero, the form on
       its own white card on the right, with the guide's cover standing out
       of the card's label strip. The form stays above the fold. -->
  <PageHero
    asideWidth="wide"
    eyebrow="FREE GUIDE"
    heading="The Expert Book Blueprint"
    lead="A free, plain-English guide: how professionals structure a book around a full calendar, what publishing actually costs, and the three decisions to make before you write a word."
    crumbs={[{ label: "Free Blueprint" }]}
  >
    <ul class="check-points">
      {points.map((point) => (
        <li>
          <span class="check-mark" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2l2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span>{point}</span>
        </li>
      ))}
    </ul>

    <FormCard slot="aside" title="Get your free copy" note="It takes less than a minute.">
      <Image slot="media" src={blueprintMockup} alt="The Expert Book Blueprint guide cover" width={260} height={260} loading="eager" />
      <LeadMagnetForm formId="free-blueprint-page" segmentTag="blueprint-general" />
    </FormCard>
  </PageHero>
</BaseLayout>

<style>
  /* Same check-marked list as the homepage Blueprint section. */
  .check-points {
    display: grid;
    gap: 0.9rem;
    max-width: 40rem;
    margin-top: 2rem;
  }
  .check-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.45;
  }
  .check-mark {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.05rem;
    border-radius: 999px;
    background: var(--color-gold-300);
    color: var(--color-navy-900);
  }
</style>
