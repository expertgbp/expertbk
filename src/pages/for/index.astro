---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import FinalDoorCTA from "../../components/FinalDoorCTA.astro";
import { professionGroupKeys } from "../../data/nav";

const all = (await getCollection("professions")).sort((a, b) => a.data.order - b.data.order);
const groups: Record<string, typeof all> = Object.fromEntries(
  professionGroupKeys.map((key) => [key, all.filter((p) => p.data.category === key)])
);
const groupLabels: Record<string, string> = {
  health: "Health",
  wealth: "Wealth",
  relationships: "Relationships",
  "leadership-and-career": "Leadership & Career",
  "service-providers": "Service Providers",
};
---

<BaseLayout
  title="Built for Experts Like You"
  description="Pick your world: health, wealth, relationships, leadership and career, or service. Each path is built around your real calendar and voice."
>
  <section class="bg-navy-900 text-offwhite-100">
    <div class="mx-auto max-w-3xl px-4 py-16 md:py-20 hero-enter">
      <h1 class="on-navy">Built for experts like you</h1>
      <p class="mt-4 text-lg opacity-90">Pick your world. The advice changes when the reader is you.</p>
    </div>
  </section>

  {Object.entries(groups).map(([key, items]) => items.length > 0 && (
    <section class="bg-ivory-50 border-t border-navy-100">
      <div class="mx-auto max-w-5xl px-4 py-14 md:py-16">
        <h2 class="mb-8">{groupLabels[key]}</h2>
        <CardGrid items={items.map((p) => ({ title: p.data.professionLabel, description: p.data.answerBlock.slice(0, 110) + "…", href: `/for/${p.id}` }))} />
      </div>
    </section>
  ))}

  <FinalDoorCTA
    heading="Don't see your field?"
    body="The path still fits. Every expert with decades of knowledge and no book faces the same three walls, and the same fix."
    secondaryLabel="Start here"
    secondaryHref="/start"
  />
</BaseLayout>
