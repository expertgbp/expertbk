---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConfirmationHero from "../../components/ConfirmationHero.astro";
import NextStepCard from "../../components/NextStepCard.astro";

// A page of text: the one next step here is the free guide.
const guideIcon =
  '<rect x="4" y="3" width="16" height="18" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>';
---

<BaseLayout title="You're In" description="You're subscribed to The Expert Book Letter." noindex>
  <ConfirmationHero
    eyebrow="The Expert Book Letter"
    heading="You're in."
    lead="The Expert Book Letter lands in your inbox with one useful idea about authorship, weekly."
  />

  <NextStepCard
    heading="Not ready to wait for the newsletter?"
    body="Get the Expert Book Blueprint now: how the process works and what it actually costs."
    ctaLabel="Get the free Blueprint"
    ctaHref="/free-blueprint"
    cta="thankyou-newsletter-blueprint"
    icon={guideIcon}
  />
</BaseLayout>
