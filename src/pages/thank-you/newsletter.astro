---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="You're In" description="You're subscribed to The Expert Book Letter." noindex>
  <section class="bg-navy-900 text-offwhite-100">
    <div class="mx-auto max-w-2xl px-4 py-20 text-center">
      <h1 class="on-navy">You're in.</h1>
      <p class="mt-4 text-lg opacity-90">
        The Expert Book Letter lands in your inbox with one useful idea about authorship, weekly.
      </p>
    </div>
  </section>

  <section class="bg-ivory-50">
    <div class="mx-auto max-w-2xl px-4 py-14 text-center">
      <h2 class="mb-4">Not ready to wait for the newsletter?</h2>
      <p class="text-slate-500 mb-6">
        Get the Expert Book Blueprint now: how the process works and what it actually costs.
      </p>
      <a href="/free-blueprint" class="btn-primary" data-cta="thankyou-newsletter-blueprint">Get the free Blueprint</a>
    </div>
  </section>
</BaseLayout>
