---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Your Blueprint Is On Its Way" description="Your Expert Book Blueprint is on its way to your inbox." noindex>
  <section class="bg-navy-900 text-offwhite-100">
    <div class="mx-auto max-w-2xl px-4 py-20 text-center">
      <h1 class="on-navy">Check your inbox.</h1>
      <p class="mt-4 text-lg opacity-90">
        The Expert Book Blueprint is on its way. If it doesn't land in a minute or two, check spam
        and mark it safe.
      </p>
    </div>
  </section>

  <section class="bg-ivory-50">
    <div class="mx-auto max-w-2xl px-4 py-14 text-center">
      <h2 class="mb-4">Ready to talk it through?</h2>
      <p class="text-slate-500 mb-6">
        One call. A real read on your idea, your positioning, and your path, whether or not we work together.
      </p>
      <a href="/book-a-call" class="btn-primary" data-cta="thankyou-blueprint-call">Book a Free Book Strategy Call</a>
    </div>
  </section>
</BaseLayout>
