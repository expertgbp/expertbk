---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConfirmationHero from "../../components/ConfirmationHero.astro";
import NextStepCard from "../../components/NextStepCard.astro";

// A calendar with a check: the one next step here is the strategy call.
const callIcon =
  '<rect x="3.5" y="5" width="17" height="15.5" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M3.5 9.5h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M9 14.6l2.2 2.2 4-4.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>';
---

<BaseLayout title="Your Blueprint Is On Its Way" description="Your Expert Book Blueprint is on its way to your inbox." noindex>
  <ConfirmationHero
    eyebrow="Free Blueprint"
    heading="Check your inbox."
    lead="The Expert Book Blueprint is on its way. If it doesn't land in a minute or two, check spam and mark it safe."
  />

  <NextStepCard
    heading="Ready to talk it through?"
    body="One call. A real read on your idea, your positioning, and your path, whether or not we work together."
    ctaLabel="Book a Free Book Strategy Call"
    ctaHref="/book-a-call"
    cta="thankyou-blueprint-call"
    icon={callIcon}
  />
</BaseLayout>
