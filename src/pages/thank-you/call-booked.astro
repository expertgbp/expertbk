---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConfirmationHero from "../../components/ConfirmationHero.astro";
import NextStepCard from "../../components/NextStepCard.astro";

// A page of text: the one next step here is the free guide.
const guideIcon =
  '<rect x="4" y="3" width="16" height="18" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>';
---

<BaseLayout title="Your Call Is Booked" description="Your strategy call is booked. Here's what happens next." noindex>
  <ConfirmationHero
    eyebrow="Strategy call"
    heading="Your call is booked."
    lead="Check your inbox for the confirmation and calendar invite. We'll come prepared to talk about your idea, not a script."
  />

  <NextStepCard
    heading="While you wait"
    body="Get the Expert Book Blueprint: a free, plain-English guide to how the process works and what it actually costs."
    ctaLabel="Get the free Blueprint"
    ctaHref="/free-blueprint"
    cta="thankyou-call-blueprint"
    icon={guideIcon}
  />
</BaseLayout>
