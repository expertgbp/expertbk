---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Your Call Is Booked" description="Your strategy call is booked. Here's what happens next." noindex>
  <section class="bg-navy-900 text-offwhite-100">
    <div class="mx-auto max-w-2xl px-4 py-20 text-center">
      <h1 class="on-navy">Your call is booked.</h1>
      <p class="mt-4 text-lg opacity-90">
        Check your inbox for the confirmation and calendar invite. We'll come prepared to talk about your
        idea, not a script.
      </p>
    </div>
  </section>

  <section class="bg-ivory-50">
    <div class="mx-auto max-w-2xl px-4 py-14 text-center">
      <h2 class="mb-4">While you wait</h2>
      <p class="text-slate-500 mb-6">
        Get the Expert Book Blueprint: a free, plain-English guide to how the process works and what it
        actually costs.
      </p>
      <a href="/free-blueprint" class="btn-primary" data-cta="thankyou-call-blueprint">Get the free Blueprint</a>
    </div>
  </section>
</BaseLayout>
