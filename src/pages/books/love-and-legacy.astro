---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BookTypeHub from "../../components/BookTypeHub.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import FinalDoorCTA from "../../components/FinalDoorCTA.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";

const bookTypes = [
  {
    label: "Memoir",
    href: "/books/memoir",
    body: "A memoir gets written safely by separating what happened from how it's told. People with a defining story, not necessarily a public career, write these to make sure it survives them. It's for the story itself, not for building a business.",
  },
  {
    label: "Legacy Book",
    href: "/books/legacy-book",
    body: "A legacy book gets written around your real deadline, not ours: an age, an anniversary, a promise made to family. Anyone who wants their history, values, or lessons to outlast them writes one of these. It's often written for a specific handful of readers, not a wide audience.",
  },
  {
    label: "Faith-Based Book",
    href: "/books/faith-based-book",
    body: "A faith-based book gets written as an act of stewardship, not a race. Pastors, ministry leaders, and people of deep personal faith write these to put a calling into a form others can carry. It asks for a patience the other book types here don't.",
  },
];

// The hub's direct answer, shown in the hero.
const answer =
  "A love or legacy book is written to keep something that matters: a life, a lesson, a faith, a family's story. Memoirs, legacy books, and faith-based books share one rule: separate what happened from how it is told, so the book stays true and the people in it stay safe. Your deadline is real (an age, an anniversary, a promise), and the path is built around it, not around ours. You keep 100% of your rights and royalties, and every word is yours before it ships.";

const faqs = [
  {
    question: "How do I write about real people without hurting them?",
    answer:
      "The same way our memoir process handles it: separate what happened from how it's told. Names, details, and timelines can be composited or changed while the truth of the lesson stays intact. You decide what's shared and what stays private.",
  },
  {
    question: "Is it too late to write my story?",
    answer:
      "No. We've published authors at 76 and at 85. The right time to write a legacy or love story is whenever you decide it matters, not a deadline anyone else sets for you.",
  },
  {
    question: "Can a memoir also build my professional authority?",
    answer:
      "Yes, when it's positioned that way from the start. A memoir written around a professional turning point can work as both a personal story and a credibility piece. That's a positioning decision, made before you write a word.",
  },
];
---

<BaseLayout
  title="Which Book Should You Write to Preserve a Story That Matters?"
  description="Memoir, legacy book, or faith-based book: written to keep something that matters. Find the right one for your story."
>
  <Fragment slot="head">
    <BreadcrumbSchema items={[{ name: "Your Book", path: "/books" }, { name: "Love & Legacy Books", path: Astro.url.pathname }]} />
  </Fragment>

  <PageHero
    eyebrow="Love & Legacy Books"
    heading="Which Book Should You Write to Preserve a Story That Matters?"
    answer={answer}
    crumbs={[{ label: "Your Book", href: "/books" }, { label: "Love & Legacy Books" }]}
    primaryLabel="Book a Free Book Strategy Call"
    secondaryLabel="Get the Expert Book Blueprint (free)"
    ctaId="hub-legacy-hero"
  />

  <BookTypeHub hubHref="/books/love-and-legacy" types={bookTypes} />

  <FAQAccordion faqs={faqs} heading="Love & legacy book questions" />

  <FinalDoorCTA />
</BaseLayout>
