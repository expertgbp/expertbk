---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BookTypeHub from "../../components/BookTypeHub.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import FinalDoorCTA from "../../components/FinalDoorCTA.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";

const bookTypes = [
  {
    label: "Children's Book",
    href: "/books/childrens-book",
    body: "A children's book gets written short, then built with an illustrator, not drawn by you. Parents, grandparents, and professionals who work with kids write these when the story matters more than the craft of drawing. It's a different production process from every other book type here.",
  },
  {
    label: "Novel",
    href: "/books/novel",
    body: "A novel gets finished by breaking the write-rewrite loop on purpose, with real developmental deadlines. Anyone with a finished or half-finished manuscript sitting in a drawer writes to get it out of the drawer and past the gatekeepers. It's the one book type here built for readers who want a story, not an answer.",
  },
];

// The hub's direct answer, shown in the hero.
const answer =
  "Novels and children's books follow a different path from expert nonfiction, and the differences matter. A novel gets finished by breaking the write-rewrite loop with real developmental deadlines. A children's book gets written short, then built with an illustrator, not drawn by you. Both are published under your name with 100% of your rights and royalties. These are the two lanes we serve outside expert nonfiction; the rest of this site is built for experts, and these pages show where the path bends.";

const faqs = [
  {
    question: "Do you publish fiction?",
    answer:
      "Yes. Novels and children's books sit outside expert nonfiction, but the same promise applies: you keep 100% of your rights and royalties, and the process is built around your real deadlines.",
  },
  {
    question: "How does a children's book get illustrated?",
    answer:
      "It's built with an illustrator as part of the process, not drawn by you. You don't need to be able to draw to write one.",
  },
  {
    question: "Can I publish under a pen name?",
    answer: "[NEEDS CONFIRMATION: pen name policy]",
  },
];
---

<BaseLayout
  title="Writing a Novel or a Children's Book? Here Is How the Path Changes."
  description="Novel or children's book: two lanes outside expert nonfiction, each with its own process. See how the path bends for fiction."
>
  <Fragment slot="head">
    <BreadcrumbSchema items={[{ name: "Your Book", path: "/books" }, { name: "Others", path: Astro.url.pathname }]} />
  </Fragment>

  <PageHero
    eyebrow="Others"
    heading="Writing a Novel or a Children's Book? Here Is How the Path Changes."
    answer={answer}
    crumbs={[{ label: "Your Book", href: "/books" }, { label: "Others" }]}
    primaryLabel="Book a Free Book Strategy Call"
    secondaryLabel="Get the Expert Book Blueprint (free)"
    ctaId="hub-other-hero"
  />

  <BookTypeHub hubHref="/books/other" types={bookTypes} />

  <FAQAccordion faqs={faqs} heading="Fiction & children's book questions" />

  <FinalDoorCTA />
</BaseLayout>
