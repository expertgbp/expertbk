---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import JumpChips from "../../components/JumpChips.astro";
import GroupSection from "../../components/GroupSection.astro";
import IconCardGrid from "../../components/IconCardGrid.astro";
import FinalDoorCTA from "../../components/FinalDoorCTA.astro";
import { bookTypeGroups } from "../../data/nav";

const all = await getCollection("books");
const byId = new Map(all.map((b) => [b.id, b]));

// Each hub section's anchor is the last part of its hub URL
// ("/books/love-and-legacy" -> "love-and-legacy"), used by the jump chips.
const groups = bookTypeGroups.map((group) => ({
  ...group,
  anchor: (group.headingHref ?? group.heading).split("/").pop()!.toLowerCase().replace(/[^a-z0-9]+/g, "-"),
}));
const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout
  title="Which Book Should You Write?"
  description="Brand and business books, love and legacy books, and everything else: the path differs by book type. Find yours."
>
  <PageHero
    eyebrow="Book types"
    heading="Your book"
    lead="Every book type has its own pains and its own process. Find yours."
    crumbs={[{ label: "Your Book" }]}
  >
    <JumpChips
      label="Jump to a book hub"
      items={groups.map((g) => ({ label: g.heading, href: `#${g.anchor}`, icon: g.icon }))}
    />
  </PageHero>

  {groups.map((group, i) => (
    <GroupSection
      id={group.anchor}
      heading={group.heading}
      headingHref={group.headingHref}
      description={group.description}
      icon={group.icon}
      index={`${pad(i + 1)} / ${pad(groups.length)}`}
      meta={`${group.items.length} book types`}
      tone={i % 2 === 0 ? "ivory" : "mist"}
    >
      <IconCardGrid
        columns={2}
        items={group.items.map((link) => {
          const id = link.href.replace("/books/", "");
          const entry = byId.get(id);
          return {
            title: link.label,
            description: entry ? entry.data.answerBlock.slice(0, 110) + "…" : undefined,
            href: link.href,
            icon: link.icon ?? group.icon,
          };
        })}
      />
    </GroupSection>
  ))}

  <FinalDoorCTA
    heading="Not sure which book is yours?"
    body="Some of the sharpest professionals we work with had too many ideas, not too few."
    secondaryLabel="Which book should I write first? →"
    secondaryHref="/guides/which-book-first"
  />
</BaseLayout>
