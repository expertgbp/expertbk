---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import FinalDoorCTA from "../../components/FinalDoorCTA.astro";
import { bookTypeGroups } from "../../data/nav";

const all = await getCollection("books");
const byId = new Map(all.map((b) => [b.id, b]));
---

<BaseLayout
  title="Which Book Should You Write?"
  description="Brand and business books, love and legacy books, and everything else: the path differs by book type. Find yours."
>
  <section class="bg-navy-900 text-offwhite-100">
    <div class="mx-auto max-w-3xl px-4 py-16 md:py-20 hero-enter">
      <h1 class="on-navy">Your book</h1>
      <p class="mt-4 text-lg opacity-90">Every book type has its own pains and its own process. Find yours.</p>
    </div>
  </section>

  {bookTypeGroups.map((group, i) => (
    <section class={i % 2 === 0 ? "bg-ivory-50 border-t border-navy-100" : "bg-navy-100"}>
      <div class="mx-auto max-w-5xl px-4 py-14 md:py-16">
        <h2 class="mb-8">
          {group.headingHref ? <a href={group.headingHref} class="hover:text-gold-500">{group.heading}</a> : group.heading}
        </h2>
        <CardGrid
          items={group.items.map((link) => {
            const id = link.href.replace("/books/", "");
            const entry = byId.get(id);
            return {
              title: link.label,
              description: entry ? entry.data.answerBlock.slice(0, 110) + "…" : undefined,
              href: link.href,
            };
          })}
        />
      </div>
    </section>
  ))}

  <FinalDoorCTA
    heading="Not sure which book is yours?"
    body="Some of the sharpest professionals we work with had too many ideas, not too few."
    secondaryLabel="Which book should I write first? →"
    secondaryHref="/guides/which-book-first"
  />
</BaseLayout>
