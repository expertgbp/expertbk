---
import BaseLayout from "../layouts/BaseLayout.astro";
import PersonSchema from "../components/schema/PersonSchema.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SplitSection from "../components/SplitSection.astro";
import PullNote from "../components/PullNote.astro";
import FounderCard from "../components/FounderCard.astro";
import FinalDoorCTA from "../components/FinalDoorCTA.astro";
import { entity } from "../data/entity";
import { stageIcons } from "../data/stage-icons";

const [sush, ash] = entity.founders;

// The four sentences that close the founding story, one per stage of the
// method: same words as before, now one tile each (icon keyed by stage).
const methodBeats = [
  { key: "engineer", lead: "Engineer", rest: "the positioning first." },
  { key: "produce", lead: "Produce", rest: "the manuscript through structured extraction." },
  { key: "ignite", lead: "Ignite", rest: "it with real publishing." },
  { key: "compound", lead: "Compound", rest: "it with a launch system that doesn't stop after week one." },
];

// Every value comes from entity.ts; the labels are the ones this strip
// already used.
const numbers = [
  { value: entity.proofBank.authorsCount, label: "authors published" },
  { value: entity.proofBank.countriesCount, label: "countries" },
  { value: entity.proofBank.tedxAshSolo, label: "TEDx talks" },
  { value: entity.proofBank.studentsTaught, label: "students taught" },
];
---

<BaseLayout
  title="About Sush Dutta and Ash Goel, Founders of Global Book Publishing"
  description="The founding story behind Global Book Publishing: two bestselling authors, 700+ authors published since, and why the company exists."
>
  <Fragment slot="head">
    <BreadcrumbSchema items={[{ name: "About", path: "/about" }]} />
    <PersonSchema name="Susmita Dutta" />
    <PersonSchema name="Ash Goel" />
  </Fragment>

  <PageHero
    eyebrow="ABOUT GLOBAL BOOK PUBLISHING"
    heading={`The People Behind ${entity.proofBank.authorsCount} Books`}
    lead={`${entity.legalName} was founded in ${entity.founded} by Susmita "Sush" Dutta and Ash Goel. Since then, ${entity.proofBank.authorsCount} authors across ${entity.proofBank.countriesCount} countries have used the EPIC Publishing Path to write, publish, and launch books that opened doors: clients, stages, and authority they didn't have before.`}
    crumbs={[{ label: "About" }]}
    primaryLabel="Book a Free Book Strategy Call"
    secondaryLabel="Get the free Blueprint"
    ctaId="about-hero"
  />

  <!-- Founding story -->
  <SplitSection eyebrow="Our story" heading="Why this company exists">
    <p>
      Sush and Ash didn't start as publishers. They started as authors who lived through the industry's
      lessons the hard way with their own first books: the confusion about what to write, the fear of
      losing control of the manuscript, and the discovery that a published book with no plan behind it
      sells quietly and then stops. [NEEDS CONFIRMATION: specific first-book details to publish here]
    </p>
    <p>
      Global Book Publishing was built in {entity.founded} to fix what they'd lived through: a publishing
      path built for experts, entrepreneurs, coaches, and consultants who have decades of knowledge and
      no time to become full-time writers or publishing professionals. The positioning line stuck because
      it's true:
    </p>
    <PullNote class="mt-6">
      <p class="story-line">{entity.positioningLine}</p>
    </PullNote>
    <p class="mt-8">The company runs on one method for every author: {entity.method.name}.</p>
    <ol class="beats">
      {methodBeats.map((beat, i) => (
        <li class="beat">
          <span class="beat-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" set:html={stageIcons[beat.key]} />
          </span>
          <span class="beat-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="beat-text"><strong>{beat.lead}</strong> {beat.rest}</span>
        </li>
      ))}
    </ol>
  </SplitSection>

  <!-- The founders: Sush Dutta, Ash Goel -->
  <section class="bg-navy-100">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <p class="eyebrow">The founders</p>
      <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
        <FounderCard
          name={`Susmita "Sush" Dutta`}
          jobTitle={sush.jobTitle}
          credentials={sush.credentials}
          photoLabel="[Photo placeholder: Sush Dutta, real photo pending]"
        >
          <p>
            Sush co-built the EPIC Publishing Path and reads applications from prospective authors personally,
            because she remembers being one. [NEEDS CONFIRMATION: extended bio, LinkedIn URL, TEDx talk URL]
          </p>
        </FounderCard>
        <FounderCard
          name="Ash Goel"
          jobTitle={ash.jobTitle}
          credentials={ash.credentials}
          photoLabel="[Photo placeholder: Ash Goel, real photo pending]"
        >
          <p>
            Ash has personally delivered {entity.proofBank.tedxAshSolo} TEDx talks, on top of the {entity.proofBank.tedxJoint} he and Sush have delivered together, and has taught alongside her
            toward the {entity.proofBank.studentsTaught} students the two have reached combined.
            [NEEDS CONFIRMATION: extended bio, LinkedIn URL, TEDx talk URL]
          </p>
        </FounderCard>
      </div>
    </div>
  </section>

  <!-- Credentials strip -->
  <section class="numbers-band relative overflow-hidden bg-navy-900 text-offwhite-100">
    <div class="relative mx-auto max-w-6xl px-4 py-16 md:py-24">
      <SectionHeading eyebrow="By the numbers" heading="What the numbers say" align="center" dark />
      <dl class="numbers mt-10 md:mt-12">
        {numbers.map((n) => (
          <div class="number-tile">
            <dd><span data-count-up>{n.value}</span></dd>
            <dt>{n.label}</dt>
          </div>
        ))}
      </dl>
      <p class="mt-8 text-center text-sm opacity-80">
        <a href="/disclaimer" class="underline underline-offset-2">{entity.incomeDisclaimerLine}</a>
      </p>
    </div>
  </section>

  <!-- Verifiability -->
  <section class="bg-ivory-50">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <div class="verify" data-reveal="item">
        <div class="verify-head">
          <span class="verify-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
              <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <div>
            <p class="eyebrow">Check us</p>
            <h2 class="mt-3">Don't take our word for it</h2>
          </div>
        </div>
        <p class="verify-text">
          Sush and Ash are public figures with a public record: bestseller lists, TEDx stages, and a company
          built in the open since {entity.founded}. Check the contract terms, the reviews, and the warning
          signs of a vanity press at <a href="/trust">/trust</a> before you
          ever book a call.
        </p>
      </div>
    </div>
  </section>

  <FinalDoorCTA
    heading="Ready to talk to the people who read every application?"
    body="One call. A real read on your idea, your positioning, and your path, whether or not we work together."
  />
</BaseLayout>

<style>
  /* The positioning line, set in the serif so it reads as the company's
     own sentence, not one more paragraph. */
  .story-line {
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-navy-900);
  }

  /* ---------- The method, one tile per stage ---------- */
  .beats {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 640px) {
    .beats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .beat {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.35rem 1rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--color-navy-100);
    border-radius: 18px;
    background: #fff;
    transition: border-color var(--duration-base) var(--ease-hover), transform var(--duration-base) var(--ease-out);
  }
  .beat-icon {
    display: flex;
    grid-row: span 2;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 14px;
    background: var(--color-navy-900);
    color: var(--color-gold-300);
    transition: background-color var(--duration-base) var(--ease-hover), color var(--duration-base) var(--ease-hover);
  }
  .beat-num {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--color-gold-700);
  }
  .beat-text {
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-slate-500);
  }
  .beat-text strong {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-navy-900);
  }
  @media (hover: hover) and (pointer: fine) {
    .beat:hover {
      border-color: var(--color-gold-300);
      transform: translateY(-2px);
    }
    .beat:hover .beat-icon {
      background: var(--color-gold-300);
      color: var(--color-navy-900);
    }
  }

  /* ---------- The numbers ---------- */
  /* The door glow, quieter, so the band isn't a flat navy slab. */
  .numbers-band::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 55% 70% at 100% 0%, rgba(255, 217, 138, 0.12), transparent 70%);
  }
  .numbers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  @media (min-width: 900px) {
    .numbers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  .number-tile {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem;
    border: 1px solid rgba(255, 217, 138, 0.16);
    border-radius: 22px;
    background: linear-gradient(160deg, rgba(27, 58, 102, 0.75), rgba(12, 37, 64, 0.75));
    transition: transform var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-hover);
  }
  @media (min-width: 768px) {
    .number-tile {
      padding: 2rem 1.75rem;
    }
  }
  .number-tile dd {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 1.8rem + 2.6vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-gold-300);
  }
  .number-tile dt {
    margin-top: 0.7rem;
    font-size: 0.95rem;
    line-height: 1.35;
    opacity: 0.8;
  }
  @media (hover: hover) and (pointer: fine) {
    .number-tile:hover {
      transform: translateY(-4px);
      border-color: rgba(255, 217, 138, 0.5);
    }
  }

  /* ---------- "Don't take our word for it" ---------- */
  /* A gold-100 card, not a navy one: the page's final CTA right below is
     the navy card, and two navy surfaces never sit next to each other. */
  .verify {
    display: grid;
    gap: 1.5rem;
    padding: 1.75rem 1.5rem;
    border: 1px solid rgba(230, 184, 92, 0.45);
    border-radius: 24px;
    background:
      radial-gradient(ellipse 60% 80% at 100% 0%, rgba(255, 255, 255, 0.7), transparent 65%),
      var(--color-gold-100);
  }
  @media (min-width: 768px) {
    .verify {
      padding: 2.5rem;
    }
  }
  @media (min-width: 1024px) {
    .verify {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: center;
      gap: 3.5rem;
      padding: 3.25rem 3.5rem;
      border-radius: 28px;
    }
  }
  .verify-head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .verify-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 16px;
    background: var(--color-navy-900);
    color: var(--color-gold-300);
  }
  .verify .eyebrow {
    color: var(--color-navy-700);
  }
  .verify-text {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  @media (min-width: 768px) {
    .verify-text {
      font-size: 1.125rem;
    }
  }
  .verify-text a {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-gold-500);
    transition: color var(--duration-fast) var(--ease-hover);
  }
  @media (hover: hover) and (pointer: fine) {
    .verify-text a:hover {
      color: var(--color-navy-600);
    }
  }
</style>
