---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="That page doesn't exist. Let's get you to the right place." noindex>
  <section class="bg-navy-900 text-offwhite-100 min-h-[60vh] flex items-center">
    <div class="w-full mx-auto max-w-xl px-4 py-24 text-center">
      <h1 class="on-navy">That page doesn't exist.</h1>
      <p class="mt-4 text-lg opacity-90">But your book still does. Let's find the right starting point.</p>
      <a href="/start" class="btn-primary mt-8 inline-flex" data-cta="404-start">Start here &rarr;</a>
    </div>
  </section>
</BaseLayout>
