---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SplitSection from "../components/SplitSection.astro";
import ProofCards from "../components/ProofCards.astro";
import PullNote from "../components/PullNote.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import VideoTestimonialSlider from "../components/VideoTestimonialSlider.astro";
import FinalDoorCTA from "../components/FinalDoorCTA.astro";

// The four written stories still waiting on their author's sign-off. Each
// note is the placeholder text exactly as it has always been marked.
const pendingStories = [
  "[CASE STUDY: pending permission: a doctor's first book, from idea to launch]",
  "[CASE STUDY: pending permission: the 60-day rescue of a stalled book]",
  "[CASE STUDY: pending permission: a lawyer's book that opened speaking invitations]",
  "[CASE STUDY: pending permission: 1,000+ books sold for one client in 5 days]",
];
---

<BaseLayout
  title="Author Case Studies"
  description="Real, permissioned author video testimonials, plus the written stories coming once each author has approved their own words."
>
  <PageHero
    eyebrow="CASE STUDIES"
    heading="The authors who walked this path"
    lead="Real authors, in their own words and their own voices, below. The full written story behind each one is still coming, one at a time, as each author approves it."
    crumbs={[{ label: "Case Studies" }]}
    primaryLabel="Book a Free Book Strategy Call"
    secondaryLabel="Get the free Blueprint"
    ctaId="case-studies-hero"
  />

  <!-- The videos sit on a navy card (the slider is built for a dark
       surface) inside an ivory section, so the card never touches the
       navy hero above it. -->
  <section class="bg-ivory-50 px-4 py-12 md:py-20">
    <div class="video-band">
      <SectionHeading eyebrow="Video testimonials" heading="Hear it from them directly" align="center" dark />
      <div class="mt-10 md:mt-12" data-reveal="item">
        <VideoTestimonialSlider />
      </div>
    </div>
  </section>

  <SplitSection eyebrow="Permission first" heading="Why the written stories aren't all here yet" tone="white">
    <p>
      We work with authors who trust us with a real story, sometimes a hard one. We don't publish a name,
      a number, or a quote in writing without that author's explicit permission first. That's slower than
      writing case studies ourselves, and it's the only version of this page worth publishing.
    </p>
    <p>
      So instead of inventing stories to fill the space, here's what's coming and how it will be marked
      while we wait on permission.
    </p>
  </SplitSection>

  <section class="bg-navy-100">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <SectionHeading
        eyebrow="Coming next"
        heading="Case studies in progress"
        intro="Each of these slots will become a full story once the author involved has approved it. Until then, they stay marked exactly like this."
        align="center"
      />
      <div class="mt-10 md:mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
        {pendingStories.map((note, i) => (
          <div class="slot" data-reveal="item">
            <div class="slot-head">
              <span class="slot-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="slot-status">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                In progress
              </span>
            </div>
            <TestimonialCard status="placeholder" placeholderNote={note} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ivory-50">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <SectionHeading
        eyebrow="On the record"
        heading="What we can tell you today"
        intro="These are results we can stand behind because they happened, but a result from one author is not a promise to the next one."
      />
      <!-- The two proof-bank results (rescueStat, fastSaleStat), with the
           linked income disclaimer line under them. -->
      <div class="mt-10 md:mt-12">
        <ProofCards />
      </div>
      <PullNote class="mt-10 md:mt-12">
        <p>
          Want to see the honest, checkable version of who we are while these stories come together? Read our{" "}
          <a href="/trust">trust page</a>, or check us out directly on our{" "}
          <a href="/reviews">reviews page</a>.
        </p>
      </PullNote>
    </div>
  </section>

  <FinalDoorCTA />
</BaseLayout>

<style>
  /* ---------- The video card ---------- */
  .video-band {
    max-width: 72rem;
    margin-inline: auto;
    padding: 2.5rem 1.25rem;
    border-radius: 28px;
    color: var(--color-offwhite-100);
    background:
      radial-gradient(ellipse 60% 70% at 100% 0%, rgba(255, 217, 138, 0.18), transparent 65%),
      radial-gradient(ellipse 45% 60% at 0% 100%, rgba(27, 58, 102, 0.7), transparent 70%),
      var(--color-navy-900);
    box-shadow: 0 40px 80px -40px rgba(8, 31, 51, 0.6);
  }
  @media (min-width: 640px) {
    .video-band {
      padding: 3rem 2rem;
    }
  }
  @media (min-width: 960px) {
    .video-band {
      padding: 4.5rem 4rem;
      border-radius: 36px;
    }
  }

  /* ---------- Stories in progress ---------- */
  /* Each slot is a white card holding the site's dashed "pending" frame,
     so an empty slot looks deliberate and is impossible to mistake for a
     finished story. */
  .slot {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.25rem;
    border: 1px solid rgba(27, 58, 102, 0.12);
    border-radius: 22px;
    background: #fff;
    transition: transform var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-hover),
      box-shadow var(--duration-base) var(--ease-out);
  }
  @media (min-width: 768px) {
    .slot {
      padding: 1.75rem;
    }
  }
  .slot-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .slot-num {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-gold-500);
  }
  .slot-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--color-navy-100);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-navy-700);
  }
  .slot > :global(.quote-pending) {
    flex: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .slot:hover {
      transform: translateY(-3px);
      border-color: var(--color-gold-300);
      box-shadow: var(--shadow-lg);
    }
  }
</style>
