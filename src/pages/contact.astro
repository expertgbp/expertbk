---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FormCard from "../components/FormCard.astro";
import { entity } from "../data/entity";

const chatIcon =
  '<path d="M4 5h16v11H9l-5 4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8.5 9.5h7M8.5 12.5h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>';
---

<BaseLayout
  title="Talk to a Real Person"
  description="No chatbot, no autoplaying widget. A quiet way to reach a real person at Global Book Publishing."
>
  <!-- The whole page in one hero: the promise and the other ways to reach
       us on the left, the message form on its own white card on the right
       (the homepage Blueprint section's model). -->
  <PageHero
    asideWidth="wide"
    eyebrow="Contact"
    heading="Talk to a real person"
    lead="No chatbot. No autoplaying widget. Just a real way to reach us."
    crumbs={[{ label: "Contact" }]}
  >
    <ul class="contact-details">
      <li>
        <span class="contact-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7" />
            <path d="M3.5 7l8.5 6 8.5-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <p>Prefer email? <!-- [NEEDS CONFIRMATION: public contact email address] --> {entity.contactEmail ? <a href={`mailto:${entity.contactEmail}`} class="contact-email">{entity.contactEmail}</a> : "[NEEDS CONFIRMATION: contact email]"}</p>
      </li>
      <li>
        <span class="contact-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
            <circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.7" />
          </svg>
        </span>
        <p>{entity.legalName}, {entity.address.locality}, {entity.address.region}</p>
      </li>
    </ul>

    <FormCard slot="aside" title="Send us a message" icon={chatIcon}>
      <form class="space-y-4 max-w-md" data-lead-form data-form-id="contact" data-segment-tag="contact-general" data-redirect="/thank-you/newsletter" novalidate>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1" for="contact-firstName">First name</label>
            <input id="contact-firstName" name="firstName" type="text" required autocomplete="given-name" class="contact-input w-full rounded-xl border border-navy-100 px-4 py-3 text-ink-900" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1" for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" required autocomplete="email" class="contact-input w-full rounded-xl border border-navy-100 px-4 py-3 text-ink-900" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="contact-message">What's on your mind?</label>
          <textarea id="contact-message" name="message" rows="5" required class="contact-input w-full rounded-xl border border-navy-100 px-4 py-3 text-ink-900"></textarea>
        </div>
        <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <p data-form-error class="hidden text-sm text-error-600" role="alert"></p>
        <button type="submit" class="btn-primary w-full sm:w-auto" data-cta="contact-submit">Send</button>
      </form>
    </FormCard>
  </PageHero>

  <script>
    import "../scripts/lead-form";
  </script>

  <style>
    /* The other ways to reach us, under the hero intro: an icon tile and
       one line each. */
    .contact-details {
      display: grid;
      gap: 0.9rem;
      max-width: 36rem;
      margin-top: 2.25rem;
      padding-top: 1.75rem;
      border-top: 1px solid rgba(245, 241, 232, 0.12);
    }
    .contact-details li {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      font-size: 1rem;
      line-height: 1.45;
      color: rgba(245, 241, 232, 0.85);
    }
    .contact-icon {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid rgba(255, 217, 138, 0.3);
      border-radius: 12px;
      color: var(--color-gold-300);
    }
    .contact-email {
      font-weight: 600;
      text-decoration: underline;
      text-decoration-color: var(--color-gold-500);
      text-underline-offset: 3px;
      transition: color var(--duration-fast) var(--ease-hover);
    }
    @media (hover: hover) and (pointer: fine) {
      .contact-email:hover {
        color: var(--color-gold-300);
      }
    }

    /* Fields match LeadMagnetForm's: a slightly tinted fill at rest so they
       read as inputs on the white card, turning white with a gold edge once
       in use. 16px text so iOS doesn't zoom the page on focus. */
    .contact-input {
      min-height: 3rem;
      font-size: 1rem;
      background-color: var(--color-ivory-50);
      transition: border-color var(--duration-fast) var(--ease-hover), background-color var(--duration-fast) var(--ease-hover);
    }
    textarea.contact-input {
      display: block;
      line-height: 1.5;
      resize: vertical;
    }
    .contact-input:hover {
      border-color: var(--color-gold-500);
    }
    .contact-input:focus {
      border-color: var(--color-gold-500);
      background-color: #fff;
    }

    /*
      lead-form.ts reveals this element by removing the `hidden` class; an
      animation on the "shown" state plays automatically the moment the
      element goes from display:none to rendered, giving the error a brief
      fade-in (feedback purpose) instead of a hard snap. Matches the same
      treatment already used on LeadMagnetForm.astro's error message, since
      this page hand-rolls the same [data-form-error] pattern.
    */
    @keyframes form-error-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
    [data-form-error]:not(.hidden) {
      animation: form-error-in var(--duration-fast) var(--ease-out);
    }
  </style>
</BaseLayout>
