---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";

const stageOptions = [
  { value: "idea", label: "Idea only", helper: "“Where do I even start?”" },
  { value: "half-written", label: "Half-written", helper: "A draft exists, but it stalled." },
  { value: "manuscript-done", label: "Manuscript done", helper: "Finished, and not sure what's next." },
  { value: "published", label: "Published", helper: "It's out, and it isn't selling." },
];

// Grouped per change-spec round 1 (Change 6/B13): three hubs, existing
// values preserved exactly (no routing/payload value changes this round),
// "Not sure yet" kept last, outside any group.
const bookTypeGroupOptions = [
  {
    heading: "Brand & Business Books",
    items: ["Business book", "Leadership book", "Nonfiction book", "Self-help book", "Health and wellness book"],
  },
  {
    heading: "Love & Legacy Books",
    items: ["Memoir", "Legacy book", "Faith-based book"],
  },
  {
    heading: "Others",
    items: ["Children's book", "Novel"],
  },
];
const bookTypeTrailingOption = "Not sure yet";

// Grouped per change-spec round 1 (Change 3/5, B10/B12): five markets,
// existing values preserved exactly, "Something else" kept last.
const fieldGroupOptions = [
  {
    heading: "Health",
    items: ["Doctor", "Nurse", "Therapist", "Dentist", "Health Coach", "Fitness & Nutrition Coach", "Holistic & Wellness Practitioner"],
  },
  {
    heading: "Wealth",
    items: ["Financial Advisor", "CEO / Founder", "Coach", "Real Estate Professional", "Accountant & Tax Professional", "Sales Leader", "Mortgage & Insurance Professional"],
  },
  {
    heading: "Relationships",
    items: ["Relationship & Marriage Coach", "Parenting Expert", "Family Counselor", "Dating Coach"],
  },
  {
    heading: "Leadership & Career",
    items: ["IT Leader", "HR Leader", "Retired Executive", "Career Coach"],
  },
  {
    heading: "Service Providers",
    items: ["Lawyer", "Educator", "Consultant", "Speaker", "Course Creator", "First Responder / Veteran"],
  },
];
const fieldTrailingOption = "Something else";

// One line icon per stage option, keyed by the option's value so the two
// can't drift apart (inner markup of a 24x24 icon, as in src/data/nav.ts):
// a light bulb, a pen, a finished page, an open book.
const stageOptionIcons: Record<string, string> = {
  idea: '<path d="M9 18h6M10 21h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5.9 1 .9 1.7v.4h5.2v-.4c0-.7.3-1.2.9-1.7A6 6 0 0 0 12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
  "half-written": '<path d="M12 20h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  "manuscript-done": '<path d="M6 3h8l4 4v14H6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v4h4" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 14.5l2 2 4-4.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  published: '<path d="M3 5c3-1 6-1 9 1 3-2 6-2 9-1v13c-3-1-6-1-9 1-3-2-6-2-9-1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 6v13" stroke="currentColor" stroke-width="1.5"/>',
};

// The four questions, in order. `legend` is the question as asked (used on
// its card and in the hero's preview); `short` is the label for the
// progress rail.
const questions = [
  { short: "Your stage", legend: "Where is your book today?" },
  { short: "Your book", legend: "What kind of book is it (or would it be)?" },
  { short: "Your field", legend: "What's your field?" },
  { short: "Your deadline", legend: "When does this need to exist by, and why?" },
];
---

<BaseLayout
  title="Start Here: Find Your Path to a Published Book"
  description="Four quick questions. One clear next step: the guide that matches where your book is today, and a real read on your path on a free call."
>
  <Fragment slot="head">
    <BreadcrumbSchema items={[{ name: "Start Here", path: "/start" }]} />
  </Fragment>

  <PageHero
    eyebrow="START HERE"
    heading="Where is your book today?"
    lead="Four quick questions. No email required. You'll land on the exact guide built for your stage, and a clear next step from there."
    crumbs={[{ label: "Start Here" }]}
  >
    <!-- In place of the proof card: a preview of the four questions. -->
    <aside slot="aside" class="ask" aria-label="The four questions">
      <p class="ask-kicker">The four questions</p>
      <ol class="ask-list">
        {questions.map((q, i) => (
          <li>
            <span class="ask-num" aria-hidden="true">{i + 1}</span>
            <span>{q.legend}</span>
          </li>
        ))}
      </ol>
    </aside>
  </PageHero>

  <section class="bg-ivory-50">
    <!-- An interactive tool, not content: it never fades in on scroll. -->
    <div class="quiz-layout mx-auto max-w-6xl px-4 py-12 md:py-20" data-reveal="none">
      <!-- Progress. A rail with the four steps on desktop; on phones just
           the bar and its label. The script hides this whole block when
           the results show. -->
      <aside class="quiz-rail" data-quiz-progress>
        <p class="eyebrow quiz-rail-title">Your progress</p>
        <ol class="steps">
          {questions.map((q, i) => (
            <li class="step" data-step={i + 1} data-state={i === 0 ? "current" : "todo"}>
              <span class="step-dot" aria-hidden="true">
                <span class="step-num">{i + 1}</span>
                <svg class="step-check" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2l2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <span class="step-label">{q.short}</span>
            </li>
          ))}
        </ol>
        <div class="quiz-bar h-2 rounded-full bg-navy-100 overflow-hidden">
          <div class="h-full bg-gold-300 transition-all" data-progress-bar style="width: 25%"></div>
        </div>
        <p class="mt-2 text-sm text-slate-500" data-progress-label>Question 1 of 4</p>
      </aside>

      <div class="quiz-main">
        <noscript>
          <div class="quiz-card mb-8">
            <p class="font-semibold">This quiz needs JavaScript to run interactively.</p>
            <p class="mt-2 text-slate-500">
              In the meantime, jump straight to a guide: <a class="underline font-semibold" href="/guides/where-to-start">Where do I even start?</a>,{" "}
              <a class="underline font-semibold" href="/guides/finish-your-book">Finish your book</a>,{" "}
              <a class="underline font-semibold" href="/guides/manuscript-ready-now-what">Manuscript in hand, now what?</a>, or{" "}
              <a class="underline font-semibold" href="/guides/book-not-selling">My book isn't selling</a>.
              Or skip straight to <a class="underline font-semibold" href="/book-a-call">booking a free call</a>.
            </p>
          </div>
        </noscript>

        <form id="start-quiz" novalidate>
          <!-- Question 1: stage -->
          <fieldset class="quiz-card" data-question="1">
            <legend class="quiz-legend">{questions[0].legend}</legend>
            <div class="quiz-body">
              <p class="quiz-hint">Pick the one that fits right now, not where you wish you were.</p>
              <div class="grid gap-3 sm:grid-cols-2">
                {stageOptions.map((opt) => (
                  <label class="quiz-option quiz-option-stage">
                    <span class="quiz-option-icon" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" set:html={stageOptionIcons[opt.value]} />
                    </span>
                    <span class="quiz-option-text">
                      <span class="font-semibold">{opt.label}</span>
                      <span class="text-sm text-slate-500">{opt.helper}</span>
                    </span>
                    <input type="radio" name="stage" value={opt.value} required class="quiz-radio" />
                  </label>
                ))}
              </div>
              <div class="quiz-actions sm:justify-end">
                <button type="button" class="btn-primary w-full sm:w-auto" data-next="1" data-cta="quiz-next-1">Next &rarr;</button>
              </div>
            </div>
          </fieldset>

          <!-- Question 2: book type -->
          <fieldset class="quiz-card hidden" data-question="2">
            <legend class="quiz-legend">{questions[1].legend}</legend>
            <div class="quiz-body">
              <p class="quiz-hint">Best guess is fine if it isn't locked in yet.</p>
              {bookTypeGroupOptions.map((group) => (
                <div class="quiz-group">
                  <p class="eyebrow quiz-group-title">{group.heading}</p>
                  <div class="grid gap-3 sm:grid-cols-2">
                    {group.items.map((label) => (
                      <label class="quiz-option">
                        <input type="radio" name="bookType" value={label} required class="quiz-radio" />
                        <span>{label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              ))}
              <div class="quiz-group grid gap-3 sm:grid-cols-2">
                <label class="quiz-option">
                  <input type="radio" name="bookType" value={bookTypeTrailingOption} required class="quiz-radio" />
                  <span>{bookTypeTrailingOption}</span>
                </label>
              </div>
              <div class="quiz-actions sm:justify-between">
                <button type="button" class="btn-secondary w-full sm:w-auto" data-back="2" data-cta="quiz-back-2">&larr; Back</button>
                <button type="button" class="btn-primary w-full sm:w-auto" data-next="2" data-cta="quiz-next-2">Next &rarr;</button>
              </div>
            </div>
          </fieldset>

          <!-- Question 3: field -->
          <fieldset class="quiz-card hidden" data-question="3">
            <legend class="quiz-legend">{questions[2].legend}</legend>
            <div class="quiz-body">
              <p class="quiz-hint">The advice changes when we know the world you work in.</p>
              {fieldGroupOptions.map((group) => (
                <div class="quiz-group">
                  <p class="eyebrow quiz-group-title">{group.heading}</p>
                  <div class="grid gap-3 sm:grid-cols-2">
                    {group.items.map((label) => (
                      <label class="quiz-option">
                        <input type="radio" name="field" value={label} required class="quiz-radio" />
                        <span>{label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              ))}
              <div class="quiz-group grid gap-3 sm:grid-cols-2">
                <label class="quiz-option">
                  <input type="radio" name="field" value={fieldTrailingOption} required class="quiz-radio" />
                  <span>{fieldTrailingOption}</span>
                </label>
              </div>
              <div class="quiz-actions sm:justify-between">
                <button type="button" class="btn-secondary w-full sm:w-auto" data-back="3" data-cta="quiz-back-3">&larr; Back</button>
                <button type="button" class="btn-primary w-full sm:w-auto" data-next="3" data-cta="quiz-next-3">Next &rarr;</button>
              </div>
            </div>
          </fieldset>

          <!-- Question 4: deadline / why (free text) -->
          <fieldset class="quiz-card hidden" data-question="4">
            <legend class="quiz-legend">{questions[3].legend}</legend>
            <div class="quiz-body">
              <p class="quiz-hint">
                A birthday, a retirement, a launch, a promise you made someone. Real deadlines help us give you
                a real answer. There's no wrong response here, including "no deadline, I just want it done."
              </p>
              <textarea
                name="deadline"
                rows="4"
                class="quiz-textarea"
                aria-label={questions[3].legend}
                placeholder="For example: my father's 80th birthday is next June, and I want to hand him the finished book."
              ></textarea>
              <div class="quiz-actions sm:justify-between">
                <button type="button" class="btn-secondary w-full sm:w-auto" data-back="4" data-cta="quiz-back-4">&larr; Back</button>
                <button type="button" class="btn-primary w-full sm:w-auto" data-next="4" data-cta="quiz-see-results">See my results &rarr;</button>
              </div>
            </div>
          </fieldset>
        </form>

        <!-- Results -->
        <div class="quiz-card quiz-results hidden" data-results>
          <div class="quiz-body">
            <p class="eyebrow mb-3">YOUR PATH</p>
            <h2 class="mb-4" data-results-heading>Here's where to go next</h2>
            <p class="text-lg leading-relaxed" data-results-body>
              Based on what you told us, this guide is the best next read for exactly where your book stands
              today.
            </p>
            <a
              class="result-guide"
              data-results-guide-link
              data-cta="quiz-result-guide"
              href="/guides/where-to-start"
            >
              <span class="result-guide-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M9 4v14M15 6v14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
              </span>
              <span class="result-guide-copy">
                <span class="result-guide-kicker">Your guide</span>
                <span class="result-guide-label" data-results-guide-label>Read the guide &rarr;</span>
              </span>
            </a>

            <div class="result-call">
              <div>
                <p class="font-serif text-xl font-semibold text-navy-900">Not ready to read? Talk it through instead.</p>
                <p class="mt-2 text-slate-500">
                  One call. A real read on your idea, your positioning, and your path, whether or not we work
                  together.
                </p>
              </div>
              <a class="btn-primary w-full sm:w-auto" data-results-call-link data-cta="quiz-result-call" href="/book-a-call">
                Book a Free Book Strategy Call
              </a>
            </div>

            <div class="mt-4 text-center">
              <button type="button" class="quiz-restart" data-restart data-cta="quiz-restart">
                Start over
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  type Answers = {
    stage: string;
    bookType: string;
    field: string;
    deadline: string;
  };

  const form = document.getElementById("start-quiz") as HTMLFormElement | null;
  const resultsPanel = document.querySelector<HTMLElement>("[data-results]");
  const progressBar = document.querySelector<HTMLElement>("[data-progress-bar]");
  const progressLabel = document.querySelector<HTMLElement>("[data-progress-label]");
  const progressWrap = document.querySelector<HTMLElement>("[data-quiz-progress]");

  const totalQuestions = 4;
  let current = 1;

  const answers: Answers = { stage: "", bookType: "", field: "", deadline: "" };

  // Guide routing keyed off answer 1 (brief section 3.2 journey stages).
  const guideByStage: Record<string, { href: string; label: string; heading: string; body: string }> = {
    idea: {
      href: "/guides/where-to-start",
      label: "Read: Where Do I Even Start? →",
      heading: "Start with the map.",
      body: "You're at the idea stage, which is exactly where about a quarter of the people who come looking for this kind of help start. This guide covers the three decisions to make before you write a word.",
    },
    "half-written": {
      href: "/guides/finish-your-book",
      label: "Read: Finish Your Book →",
      heading: "Let's get that draft to the finish line.",
      body: "A stalled draft is the most common place people get stuck. This guide covers the write-rewrite loop, why it happens to smart people, and the structure that actually ends it.",
    },
    "manuscript-done": {
      href: "/guides/manuscript-ready-now-what",
      label: "Read: I Finished My Manuscript, Now What? →",
      heading: "You're at the fastest stage to a real result.",
      body: "A finished manuscript is closer to a published, working book than most people realize. This guide covers positioning, editing, publishing, and launch, in the right order.",
    },
    published: {
      href: "/guides/book-not-selling",
      label: "Read: My Book Isn't Selling, What Now? →",
      heading: "A quiet launch isn't a verdict on the book.",
      body: "Most books that sell fewer copies than hoped have a visibility problem, not a quality one. This guide covers the honest diagnosis and what a real relaunch involves.",
    },
  };

  function showQuestion(n: number) {
    document.querySelectorAll<HTMLElement>("[data-question]").forEach((el) => {
      el.classList.toggle("hidden", Number(el.dataset.question) !== n);
    });
    if (progressBar) progressBar.style.width = `${(n / totalQuestions) * 100}%`;
    if (progressLabel) progressLabel.textContent = `Question ${n} of ${totalQuestions}`;
    // The desktop progress rail: earlier steps show as done, this one as current.
    document.querySelectorAll<HTMLElement>("[data-step]").forEach((el) => {
      const step = Number(el.dataset.step);
      el.dataset.state = step < n ? "done" : step === n ? "current" : "todo";
      if (step === n) el.setAttribute("aria-current", "step");
      else el.removeAttribute("aria-current");
    });
  }

  // Which hub each bookType answer belongs to (change-spec Change 6/B13,
  // item 4), passed through to the booking page alongside the answer
  // itself. Routing by stage is unchanged; this is additive.
  const bookGroupByType: Record<string, string> = {
    "Business book": "brand-and-business",
    "Leadership book": "brand-and-business",
    "Nonfiction book": "brand-and-business",
    "Self-help book": "brand-and-business",
    "Health and wellness book": "brand-and-business",
    "Memoir": "love-and-legacy",
    "Legacy book": "love-and-legacy",
    "Faith-based book": "love-and-legacy",
    "Children's book": "other",
    "Novel": "other",
  };

  function currentSelection(name: keyof Answers): string {
    if (name === "deadline") {
      const el = form?.querySelector<HTMLTextAreaElement>('textarea[name="deadline"]');
      return el?.value.trim() ?? "";
    }
    const el = form?.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
    return el?.value ?? "";
  }

  function showResults() {
    answers.stage = currentSelection("stage");
    answers.bookType = currentSelection("bookType");
    answers.field = currentSelection("field");
    answers.deadline = currentSelection("deadline");

    const match = guideByStage[answers.stage] ?? guideByStage.idea;

    const headingEl = document.querySelector<HTMLElement>("[data-results-heading]");
    const bodyEl = document.querySelector<HTMLElement>("[data-results-body]");
    const guideLink = document.querySelector<HTMLAnchorElement>("[data-results-guide-link]");
    const guideLabel = document.querySelector<HTMLElement>("[data-results-guide-label]");
    const callLink = document.querySelector<HTMLAnchorElement>("[data-results-call-link]");

    if (headingEl) headingEl.textContent = match.heading;
    if (bodyEl) bodyEl.textContent = match.body;
    if (guideLink) guideLink.href = match.href;
    if (guideLabel) guideLabel.textContent = match.label;

    const params = new URLSearchParams();
    if (answers.stage) params.set("stage", answers.stage);
    if (answers.bookType) {
      params.set("bookType", answers.bookType);
      const bookGroup = bookGroupByType[answers.bookType];
      if (bookGroup) params.set("bookGroup", bookGroup);
    }
    if (answers.field) params.set("field", answers.field);
    if (answers.deadline) params.set("deadline", answers.deadline);
    if (callLink) callLink.href = `/book-a-call?${params.toString()}`;

    form?.classList.add("hidden");
    progressWrap?.classList.add("hidden");
    resultsPanel?.classList.remove("hidden");
    resultsPanel?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function validateCurrent(n: number): boolean {
    const fieldset = form?.querySelector<HTMLFieldSetElement>(`[data-question="${n}"]`);
    if (!fieldset) return true;
    if (n === 4) return true; // free text is optional
    const checked = fieldset.querySelector<HTMLInputElement>("input:checked");
    if (!checked) {
      fieldset.classList.add("animate-pulse");
      window.setTimeout(() => fieldset.classList.remove("animate-pulse"), 400);
      return false;
    }
    return true;
  }

  document.querySelectorAll<HTMLButtonElement>("[data-next]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const n = Number(btn.dataset.next);
      if (!validateCurrent(n)) return;
      if (n < totalQuestions) {
        current = n + 1;
        showQuestion(current);
      } else {
        showResults();
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-back]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const n = Number(btn.dataset.back);
      current = Math.max(1, n - 1);
      showQuestion(current);
    });
  });

  document.querySelector("[data-restart]")?.addEventListener("click", () => {
    form?.reset();
    resultsPanel?.classList.add("hidden");
    progressWrap?.classList.remove("hidden");
    form?.classList.remove("hidden");
    current = 1;
    showQuestion(current);
    form?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // Initialize on load (progressive enhancement: everything above renders
  // statically; this just narrows the view to one question at a time).
  showQuestion(current);
</script>

<style>
  /* ---------- Hero aside: the four questions ---------- */
  .ask {
    padding: 1.6rem;
    border: 1px solid rgba(255, 217, 138, 0.2);
    border-radius: 22px;
    background: linear-gradient(160deg, rgba(27, 58, 102, 0.75), rgba(12, 37, 64, 0.75));
    box-shadow: 0 30px 60px -30px rgba(3, 12, 22, 0.9);
  }
  .ask-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-300);
  }
  .ask-list {
    display: grid;
    margin-top: 0.75rem;
  }
  .ask-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.85rem 0;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .ask-list li + li {
    border-top: 1px solid rgba(245, 241, 232, 0.12);
  }
  .ask-list li:last-child {
    padding-bottom: 0;
  }
  .ask-num {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 999px;
    background: var(--color-gold-300);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-navy-900);
  }

  /* ---------- Layout: progress rail + question card ---------- */
  /* Note for anything the script shows and hides (.quiz-rail, .quiz-card):
     no `display` is set on them here, so Tailwind's `hidden` keeps working. */
  .quiz-layout {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .quiz-layout {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
    }
    /* Results: the rail is hidden, so the card takes the stage alone. */
    .quiz-layout:has(> .quiz-rail.hidden) {
      grid-template-columns: minmax(0, 50rem);
      justify-content: center;
    }
    .quiz-rail {
      position: sticky;
      top: 6.5rem; /* clears the sticky header */
      padding: 1.5rem;
      border: 1px solid var(--color-navy-100);
      border-radius: 22px;
      background: #fff;
    }
  }
  .quiz-rail-title,
  .steps {
    display: none;
  }
  @media (min-width: 1024px) {
    .quiz-rail-title {
      display: block;
    }
    .steps {
      display: grid;
      margin: 1.1rem 0 1.5rem;
    }
  }

  /* The four steps, joined by a line. Done = gold check, current = navy. */
  .step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
