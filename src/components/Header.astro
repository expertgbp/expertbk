---
import { primaryNav } from "../data/nav";
---

<header class="sticky top-0 z-40 bg-navy-900 text-offwhite-100 border-b border-navy-700">
  <div class="mx-auto max-w-7xl px-4">
    <div class="flex items-center justify-between h-16 gap-4">
      <a href="/" class="font-serif font-bold text-lg shrink-0">WriteExpertBook</a>

      <nav class="hidden lg:flex items-center gap-1 text-sm">
        {primaryNav.map((item) => (
          "groups" in item || "links" in item ? (
            <div class="relative group">
              <button class="px-3 py-2 rounded hover:bg-navy-700 flex items-center gap-1" aria-haspopup="true">
                {item.label}
                <svg width="10" height="10" viewBox="0 0 10 10" class="mt-0.5" aria-hidden="true"><path d="M1 3l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
              </button>
              <div class="mega-panel invisible opacity-0 -translate-y-1 origin-top group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-[opacity,transform] duration-[var(--duration-base)] ease-[var(--ease-out)] absolute left-0 top-full pt-2 w-[min(90vw,50rem)] z-50">
                <div class="bg-white text-ink-900 rounded-xl border border-navy-100 shadow-xl overflow-hidden">
                  {"groups" in item && (
                    <div class:list={["grid gap-x-6 gap-y-7 p-6", item.groups.length >= 5 ? "sm:grid-cols-3 lg:grid-cols-5" : "sm:grid-cols-3"]}>
                      {item.groups.map((group) => (
                        <div class="min-w-0">
                          <div class="flex items-start gap-2.5">
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-navy-100 text-navy-700" aria-hidden="true">
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" set:html={group.icon ?? ""} />
                            </span>
                            <div class="min-w-0">
                              {group.headingHref ? (
                                <a href={group.headingHref} class="font-serif font-semibold text-[0.95rem] block hover:text-gold-500">{group.heading}</a>
                              ) : (
                                <p class="font-serif font-semibold text-[0.95rem]">{group.heading}</p>
                              )}
                              {group.description && <p class="mt-0.5 text-xs text-slate-500 leading-snug">{group.description}</p>}
                            </div>
                          </div>
                          <ul class="mt-3 space-y-1.5">
                            {group.items.map((link) => (
                              <li><a href={link.href} class="text-[0.85rem] text-slate-500 hover:text-gold-500 hover:underline underline-offset-2">{link.label}</a></li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  )}
                  {"links" in item && (
                    <div class="grid gap-x-6 gap-y-1 p-4 sm:grid-cols-2">
                      {item.links.map((link) => (
                        <a href={link.href} class="mega-link flex items-start gap-3 rounded-lg p-2.5 hover:bg-ivory-50" data-cta={`nav-${link.href.split("/").pop()}`}>
                          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-navy-100 text-navy-700" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" set:html={link.icon ?? ""} />
                          </span>
                          <span class="min-w-0">
                            <span class="block text-sm font-semibold text-ink-900">{link.label}</span>
                            {link.description && <span class="block text-xs text-slate-500 leading-snug mt-0.5">{link.description}</span>}
                          </span>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
                {"indexHref" in item && item.indexHref && (
                  <div class="bg-white text-ink-900 rounded-b-xl border-x border-b border-navy-100 px-6 py-3 -mt-1">
                    <a href={item.indexHref} class="text-sm font-semibold text-navy-700 hover:text-gold-500">See all {item.label.toLowerCase()} &rarr;</a>
                  </div>
                )}
              </div>
            </div>
          ) : (
            <a href={item.href} class="px-3 py-2 rounded hover:bg-navy-700">{item.label}</a>
          )
        ))}
      </nav>

      <div class="hidden lg:flex items-center gap-2 shrink-0">
        <a href="/free-blueprint" class="btn-secondary text-sm" data-cta="header-blueprint">Get the Free Blueprint</a>
        <a href="/book-a-call" class="btn-primary text-sm" data-cta="header-call">Book a Strategy Call</a>
      </div>

      <button id="mobile-nav-toggle" class="lg:hidden min-w-11 min-h-11 flex items-center justify-center -mr-1.5" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="lg:hidden mobile-nav-panel border-t border-navy-700 bg-navy-900">
    <div class="px-4 py-4 space-y-4 max-h-[70vh] overflow-y-auto">
      {primaryNav.map((item) => (
        <div>
          {"href" in item ? (
            <a href={item.href} class="block font-semibold py-2.5 min-h-11 flex items-center">{item.label}</a>
          ) : (
            <details>
              <summary class="font-semibold py-2.5 min-h-11 flex items-center cursor-pointer">{item.label}</summary>
              <div class="pl-3 pt-2 space-y-3">
                {"groups" in item && item.groups.map((group) => (
                  <div>
                    {group.headingHref ? (
                      <a href={group.headingHref} class="eyebrow mb-1 block hover:text-gold-300">{group.heading}</a>
                    ) : (
                      <p class="eyebrow mb-1">{group.heading}</p>
                    )}
                    <ul class="space-y-1">
                      {group.items.map((link) => (<li><a href={link.href} class="text-sm opacity-90 inline-block py-1.5">{link.label}</a></li>))}
                    </ul>
                  </div>
                ))}
                {"links" in item && (
                  <ul class="space-y-1">
                    {item.links.map((link) => (<li><a href={link.href} class="text-sm opacity-90 inline-block py-1.5">{link.label}</a></li>))}
                  </ul>
                )}
              </div>
            </details>
          )}
        </div>
      ))}
    </div>
  </div>
</header>

<style>
  /* Mega panels default to left-0 (anchored to the trigger's left edge,
     extending rightward) — correct for the first dropdowns (For Experts,
     Your Book) which sit near the header's left side. The last dropdown
     (Resources) sits further right, so a rightward-extending panel there
     risks overflowing the viewport; flip it to anchor its right edge to
     the trigger instead, extending leftward into the space that's
     actually available. No JS measurement needed for either case. */
  nav .group:last-of-type .mega-panel {
    left: auto;
    right: 0;
  }

  /* Mobile nav open/close: an accordion-style reveal, one of the few cases
     where animating a layout property (max-height) is the accepted
     exception, since there's no transform equivalent for "how much of a
     variable-height panel is visible." Kept fast (tens-of-times-a-session
     tier) and gated by the global prefers-reduced-motion rule. */
  .mobile-nav-panel {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height var(--duration-base) var(--ease-out),
      opacity var(--duration-base) var(--ease-out);
  }
  .mobile-nav-panel.is-open {
    max-height: 80vh;
    opacity: 1;
  }

  /* Escape-to-close for the desktop dropdowns: these open on CSS
     :focus-within, so a forced-closed override is needed while focus
     returns to the trigger (otherwise :focus-within on the button would
     immediately reopen the panel). Cleared once focus leaves the group. */
  .group.force-closed > div {
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Keyboard focus should be clearly visible against navy, matching the
     brand's gold accent rather than the browser default. */
  header a:focus-visible,
  header button:focus-visible {
    outline: 2px solid var(--color-gold-300);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Safe-area aware sticky mobile CTA bar (notched phones: iOS home
     indicator etc., requires viewport-fit=cover, set in BaseLayout). */
  .mobile-sticky-cta {
    padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom));
  }
  .mobile-sticky-cta-spacer {
    height: calc(3.5rem + env(safe-area-inset-bottom));
  }
  /* Keep the two CTAs comfortably legible on the narrowest phones. */
  @media (max-width: 360px) {
    .mobile-sticky-cta .btn-primary,
    .mobile-sticky-cta .btn-secondary {
      padding-inline: 1rem;
    }
  }
</style>

<!-- Mobile sticky dual CTA bar (brief 5.1) -->
<div class="mobile-sticky-cta lg:hidden fixed bottom-0 inset-x-0 z-40 bg-navy-900 border-t border-navy-700 flex gap-2">
  <a href="/free-blueprint" class="btn-secondary text-offwhite-100 flex-1 text-sm" data-cta="mobile-sticky-blueprint">Free Blueprint</a>
  <a href="/book-a-call" class="btn-primary flex-1 text-sm" data-cta="mobile-sticky-call">Book a Call</a>
</div>
<div class="mobile-sticky-cta-spacer lg:hidden" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const panel = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const isOpen = panel?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(!!isOpen));
  });

  // Desktop dropdowns: Escape returns focus to the trigger and closes the
  // panel (see .force-closed in the <style> above for why a class is
  // needed alongside :focus-within).
  document.querySelectorAll<HTMLElement>("header nav .group").forEach((group) => {
    group.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      group.classList.add("force-closed");
      group.querySelector("button")?.focus();
    });
    group.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !group.contains(next)) {
        group.classList.remove("force-closed");
      }
    });
  });
</script>
