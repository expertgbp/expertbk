---
import { primaryNav } from "../data/nav";
---

<header class="sticky top-0 z-40 bg-navy-900 text-offwhite-100 border-b border-navy-700">
  <div class="mx-auto max-w-7xl px-4">
    <div class="flex items-center justify-between h-16 gap-4">
      <a href="/" class="font-serif font-bold text-lg shrink-0">WriteExpertBook</a>

      <nav class="hidden lg:flex items-center gap-1 text-sm">
        {primaryNav.map((item) => (
          "groups" in item || "links" in item ? (
            <div class="relative group">
              <button class="px-3 py-2 rounded hover:bg-navy-700 flex items-center gap-1" aria-haspopup="true">
                {item.label}
                <svg width="10" height="10" viewBox="0 0 10 10" class="mt-0.5" aria-hidden="true"><path d="M1 3l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
              </button>
              <div class="mega-panel invisible opacity-0 -translate-y-1 origin-top group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-[opacity,transform] duration-[var(--duration-base)] ease-[var(--ease-out)] fixed top-16 w-[min(94vw,64rem)] z-50">
                <div class="mega-surface relative bg-white text-ink-900 rounded-xl border border-navy-100 shadow-2xl overflow-hidden">
                  <span class="mega-top-accent" aria-hidden="true"></span>
                  {"groups" in item && (
                    <div class:list={["grid gap-x-8 gap-y-8 p-7", item.groups.length >= 5 ? "sm:grid-cols-3 lg:grid-cols-5" : "sm:grid-cols-3"]}>
                      {item.groups.map((group, gi) => {
                        const tint = gi % 2 === 0 ? "navy" : "gold";
                        return (
                          <div class="min-w-0">
                            {group.headingHref ? (
                              <a href={group.headingHref} class="mega-group-heading font-serif font-semibold text-base block hover:text-gold-500">{group.heading}</a>
                            ) : (
                              <p class="mega-group-heading font-serif font-semibold text-base">{group.heading}</p>
                            )}
                            <ul class="mt-3 space-y-2 border-t border-navy-100 pt-3">
                              {group.items.map((link) => (
                                <li>
                                  <a href={link.href} class="mega-shine -mx-2 flex items-center gap-2.5 rounded-md px-2 py-1 text-[0.85rem] text-slate-500 hover:text-navy-900">
                                    <span class:list={["flex h-6 w-6 shrink-0 items-center justify-center rounded-full", tint === "navy" ? "bg-navy-100 text-navy-700" : "bg-gold-100 text-navy-900"]} aria-hidden="true">
                                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" set:html={link.icon ?? group.icon ?? ""} />
                                    </span>
                                    {link.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        );
                      })}
                    </div>
                  )}
                  {"links" in item && (
                    <div class="grid gap-x-6 gap-y-1 p-5 sm:grid-cols-2">
                      {item.links.map((link, li) => (
                        <a href={link.href} class="mega-link mega-shine relative flex items-start gap-3 rounded-lg p-3 hover:bg-ivory-50" data-cta={`nav-${link.href.split("/").pop()}`}>
                          <span class:list={["flex h-9 w-9 shrink-0 items-center justify-center rounded-full", li % 2 === 0 ? "bg-navy-100 text-navy-700" : "bg-gold-100 text-navy-900"]} aria-hidden="true">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" set:html={link.icon ?? ""} />
                          </span>
                          <span class="min-w-0">
                            <span class="block text-sm font-semibold text-ink-900">{link.label}</span>
                            {link.description && <span class="block text-xs text-slate-500 leading-snug mt-0.5">{link.description}</span>}
                          </span>
                        </a>
                      ))}
                    </div>
                  )}
                  {"indexHref" in item && item.indexHref && (
                    <div class="border-t border-navy-100 px-7 py-3">
                      <a href={item.indexHref} class="text-sm font-semibold text-navy-700 hover:text-gold-500">{("seeAllLabel" in item && item.seeAllLabel) || "See all"} &rarr;</a>
                    </div>
                  )}
                </div>
              </div>
              <div class="nav-scrim invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity duration-[var(--duration-base)] ease-[var(--ease-out)] fixed inset-x-0 top-16 bottom-0 z-30 bg-navy-900/45" aria-hidden="true"></div>
            </div>
          ) : (
            <a href={item.href} class="px-3 py-2 rounded hover:bg-navy-700">{item.label}</a>
          )
        ))}
      </nav>

      <div class="hidden lg:flex items-center gap-2 shrink-0">
        <a href="/free-blueprint" class="btn-secondary text-sm" data-cta="header-blueprint">Get the Free Blueprint</a>
        <a href="/book-a-call" class="btn-primary text-sm" data-cta="header-call">Book a Strategy Call</a>
      </div>

      <button id="mobile-nav-toggle" class="lg:hidden min-w-11 min-h-11 flex items-center justify-center -mr-1.5" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="lg:hidden mobile-nav-panel border-t border-navy-700 bg-navy-900">
    <div class="px-4 py-4 space-y-4 max-h-[70vh] overflow-y-auto">
      {primaryNav.map((item) => (
        <div>
          {"href" in item ? (
            <a href={item.href} class="block font-semibold py-2.5 min-h-11 flex items-center">{item.label}</a>
          ) : (
            <details>
              <summary class="font-semibold py-2.5 min-h-11 flex items-center cursor-pointer">{item.label}</summary>
              <div class="pl-3 pt-2 space-y-3">
                {"groups" in item && item.groups.map((group) => (
                  <div>
                    {group.headingHref ? (
                      <a href={group.headingHref} class="eyebrow mb-1 block hover:text-gold-300">{group.heading}</a>
                    ) : (
                      <p class="eyebrow mb-1">{group.heading}</p>
                    )}
                    <ul class="space-y-1">
                      {group.items.map((link) => (<li><a href={link.href} class="text-sm opacity-90 inline-block py-1.5">{link.label}</a></li>))}
                    </ul>
                  </div>
                ))}
                {"links" in item && (
                  <ul class="space-y-1">
                    {item.links.map((link) => (<li><a href={link.href} class="text-sm opacity-90 inline-block py-1.5">{link.label}</a></li>))}
                  </ul>
                )}
              </div>
            </details>
          )}
        </div>
      ))}
    </div>
  </div>
</header>

<style>
  /* Mega panels are position:fixed (so they render above everything
     regardless of ancestor stacking/overflow contexts) but that means
     they have no reliable default horizontal position — a fixed element
     with no `left` set falls back to an inconsistent, browser-dependent
     "static position" guess, not the trigger's actual location. The
     <script> below measures each trigger and sets `left` in JS instead,
     clamped so the panel never overflows either edge of the viewport
     (this is what broke before: the two widest panels, For Experts and
     Your Book, could run past the right edge with no visible scrollbar
     because <html> uses `overflow-x: clip` sitewide). */

  /* Reserves 2 lines' worth of height for every group heading in a
     grouped mega panel (For Experts, Your Book), regardless of whether
     that particular heading actually wraps ("Leadership & Career" does,
     the rest don't). Without this, the one column with a wrapping
     heading pushes its description/list down while its neighbors don't,
     breaking the row alignment across the whole panel. */
  .mega-group-heading {
    display: block;
    min-height: 2.3rem;
  }

  /* The dimmed backdrop behind an open mega panel: keeps the panel
     reading as a clear top layer against a busy page (large serif
     headline text, etc.) instead of visually blending into it. Sits
     below the header's own z-40 stacking context by not overlapping the
     header bar at all (top-16 = the header's own height), so the bar
     itself always stays fully lit; only the page content below it dims. */
  .nav-scrim {
    pointer-events: none;
  }

  /* A thin navy-gold-navy gradient bar across the top of every mega
     panel — a static styling touch (not motion), the same restraint
     principle as one signature button treatment: spend the "stylish"
     budget in one deliberate place rather than decorating every edge. */
  .mega-top-accent {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-navy-700), var(--color-gold-300) 50%, var(--color-navy-700));
  }

  .mega-icon-badge {
    box-shadow: inset 0 0 0 1px rgba(8, 31, 51, 0.06);
  }

  /*
    "3D shine" hover: the same one-shot diagonal sheen already used on
    every .card sitewide (global.css), applied here to mega-menu links
    instead of inventing a new hover effect. Gold-tinted, single sweep on
    hover-enter (not a looping shimmer), transform/opacity-adjacent
    (background-position + opacity only) so it stays in the site's
    established low-motion tier.
  */
  .mega-shine {
    position: relative;
    overflow: hidden;
  }
  .mega-shine::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 30%, rgba(255, 217, 138, 0.35) 48%, transparent 66%);
    background-size: 250% 100%;
    background-position: 150% 0;
    opacity: 0;
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .mega-shine::before {
      transition: background-position var(--duration-slow) var(--ease-out), opacity var(--duration-fast) var(--ease-hover);
    }
    .mega-shine:hover::before {
      background-position: -50% 0;
      opacity: 1;
    }
  }

  /* Mobile nav open/close: an accordion-style reveal, one of the few cases
     where animating a layout property (max-height) is the accepted
     exception, since there's no transform equivalent for "how much of a
     variable-height panel is visible." Kept fast (tens-of-times-a-session
     tier) and gated by the global prefers-reduced-motion rule. */
  .mobile-nav-panel {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height var(--duration-base) var(--ease-out),
      opacity var(--duration-base) var(--ease-out);
  }
  .mobile-nav-panel.is-open {
    max-height: 80vh;
    opacity: 1;
  }

  /* Escape-to-close for the desktop dropdowns: these open on CSS
     :focus-within, so a forced-closed override is needed while focus
     returns to the trigger (otherwise :focus-within on the button would
     immediately reopen the panel). Cleared once focus leaves the group. */
  .group.force-closed > div {
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Keyboard focus should be clearly visible against navy, matching the
     brand's gold accent rather than the browser default. */
  header a:focus-visible,
  header button:focus-visible {
    outline: 2px solid var(--color-gold-300);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Safe-area aware sticky mobile CTA bar (notched phones: iOS home
     indicator etc., requires viewport-fit=cover, set in BaseLayout). */
  .mobile-sticky-cta {
    padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom));
  }
  .mobile-sticky-cta-spacer {
    height: calc(3.5rem + env(safe-area-inset-bottom));
  }
  /* Keep the two CTAs comfortably legible on the narrowest phones. */
  @media (max-width: 360px) {
    .mobile-sticky-cta .btn-primary,
    .mobile-sticky-cta .btn-secondary {
      padding-inline: 1rem;
    }
  }
</style>

<!-- Mobile sticky dual CTA bar (brief 5.1) -->
<div class="mobile-sticky-cta lg:hidden fixed bottom-0 inset-x-0 z-40 bg-navy-900 border-t border-navy-700 flex gap-2">
  <a href="/free-blueprint" class="btn-secondary text-offwhite-100 flex-1 text-sm" data-cta="mobile-sticky-blueprint">Free Blueprint</a>
  <a href="/book-a-call" class="btn-primary flex-1 text-sm" data-cta="mobile-sticky-call">Book a Call</a>
</div>
<div class="mobile-sticky-cta-spacer lg:hidden" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const panel = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const isOpen = panel?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(!!isOpen));
  });

  // Desktop mega panels are position:fixed with no default `left`, so
  // measure each trigger and set it in JS, clamped to the viewport. Kept
  // close to the trigger (not viewport-centered) so the mouse never has
  // to cross a dead zone between the button and the panel on the way
  // down — that gap would break the CSS group-hover chain and close the
  // menu before the pointer arrives.
  function positionMegaPanels() {
    document.querySelectorAll<HTMLElement>("header nav .group").forEach((group) => {
      const trigger = group.querySelector<HTMLElement>("button");
      const panel = group.querySelector<HTMLElement>(".mega-panel");
      if (!trigger || !panel) return;
      const margin = 16;
      const triggerLeft = trigger.getBoundingClientRect().left;
      const maxLeft = window.innerWidth - panel.offsetWidth - margin;
      panel.style.left = `${Math.max(margin, Math.min(triggerLeft, maxLeft))}px`;
    });
  }
  positionMegaPanels();
  window.addEventListener("resize", positionMegaPanels);

  // Desktop dropdowns: Escape returns focus to the trigger and closes the
  // panel (see .force-closed in the <style> above for why a class is
  // needed alongside :focus-within).
  document.querySelectorAll<HTMLElement>("header nav .group").forEach((group) => {
    group.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      group.classList.add("force-closed");
      group.querySelector("button")?.focus();
    });
    group.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !group.contains(next)) {
        group.classList.remove("force-closed");
      }
    });
  });
</script>
