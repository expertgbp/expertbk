---
/**
 * One founder: a clearly-labeled photo placeholder across the top (real
 * photos are supplied later, never generated), then the name, job title,
 * credentials as chips, and the bio.
 *
 *   name / jobTitle / credentials   pass straight from entity.founders
 *   photoLabel   the placeholder's visible text
 *   default slot: the bio paragraph(s)
 *
 * The name is the card's <h2>, as it was when each founder had a section
 * of their own.
 */
import { Image, type ImageMetadata } from "astro:assets";

interface Props {
  name: string;
  jobTitle: string;
  credentials: readonly string[];
  photoLabel: string;
  photo?: ImageMetadata;
}
const { name, jobTitle, credentials, photoLabel, photo } = Astro.props;
---

<!-- data-reveal="item": the card scrolls in as one piece, not part by part. -->
<article class="founder" data-reveal="item">
  {photo ? (
    <div class="founder-photo founder-photo-real">
      <span class="founder-photo-accent" aria-hidden="true"></span>
      <Image src={photo} alt={`${name}, ${jobTitle}`} width={640} class="founder-photo-img" />
    </div>
  ) : (
    <div class="founder-photo" role="img" aria-label={photoLabel}>
      <span class="founder-photo-accent" aria-hidden="true"></span>
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="12" cy="12" r="3.5"></circle><path d="M8 5l1.5-2h5L16 5"></path>
      </svg>
      <p>{photoLabel}</p>
    </div>
  )}
  <div class="founder-body">
    <h2 class="founder-name">{name}</h2>
    <p class="founder-title">{jobTitle}</p>
    <ul class="founder-chips">
      {credentials.map((c) => (
        <li>
          <svg width="13" height="13" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {c}
        </li>
      ))}
    </ul>
    <div class="founder-bio"><slot /></div>
  </div>
</article>

<style>
  .founder {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-navy-100);
    border-radius: 24px;
    background: #fff;
    transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .founder:hover {
      transform: translateY(-4px);
      border-color: var(--color-gold-300);
      box-shadow: var(--shadow-lg);
    }
  }

  /* The placeholder: navy with the door glow, so the empty slot still
     looks designed, and labeled so nobody mistakes it for a finished photo. */
  .founder-photo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 13rem;
    padding: 2rem 1.5rem;
    text-align: center;
    color: rgba(245, 241, 232, 0.7);
    background:
      radial-gradient(ellipse 70% 90% at 100% 0%, rgba(255, 217, 138, 0.22), transparent 65%),
      linear-gradient(160deg, var(--color-navy-700), var(--color-navy-900));
  }
  @media (min-width: 768px) {
    .founder-photo {
      min-height: 16rem;
    }
  }
  .founder-photo p {
    max-width: 18rem;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .founder-photo-accent {
    position: absolute;
    left: 1.25rem;
    top: 1.25rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    background: var(--color-gold-300);
    z-index: 1;
  }
  .founder-photo-real {
    padding: 0;
    overflow: hidden;
  }
  .founder-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .founder-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.75rem 1.5rem 2rem;
  }
  @media (min-width: 768px) {
    .founder-body {
      padding: 2.25rem 2.25rem 2.5rem;
    }
  }
  .founder-name {
    font-size: clamp(1.6rem, 1.4rem + 0.8vw, 2rem);
  }
  .founder-title {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-navy-700);
  }
  .founder-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .founder-chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem 0.4rem 0.65rem;
    border-radius: 999px;
    background: var(--color-navy-100);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-navy-900);
  }
  .founder-chips svg {
    flex-shrink: 0;
    color: var(--color-gold-500);
  }
  .founder-bio {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-navy-100);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-slate-500);
  }
</style>
