---
/**
 * Sitewide accessibility drawer: a labeled bottom-right pill button opening
 * a right-side slide-in drawer (not a bottom-left icon grid), so every
 * control reads as an explained choice rather than a cryptic glyph — in
 * keeping with this brand's "explain, don't abbreviate" voice. Logic lives
 * in src/scripts/accessibility-widget.ts; this component is markup only.
 */
const toggles = [
  { key: "contrast", label: "Boost contrast", hint: "Increases contrast and color intensity." },
  { key: "grayscale", label: "Grayscale", hint: "Removes color from the page." },
  { key: "invert", label: "Invert colors", hint: "Flips light and dark." },
  { key: "underline", label: "Underline links", hint: "Adds an underline to every link." },
  { key: "simpleType", label: "Simplified type", hint: "Switches headings to plain, non-serif text." },
  { key: "spacing", label: "More spacing", hint: "Adds space between lines and letters." },
  { key: "bigCursor", label: "Bigger cursor", hint: "Enlarges the mouse pointer." },
  { key: "guide", label: "Reading guide", hint: "Shows a highlighted line that follows your cursor." },
  { key: "strongFocus", label: "Stronger focus outline", hint: "Thickens the keyboard focus ring." },
  { key: "reduceMotion", label: "Stop animations", hint: "Turns off motion across the site." },
] as const;
---

<button
  type="button"
  id="a11y-toggle-button"
  class="a11y-pill"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="a11y-drawer"
>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <line x1="4" y1="6" x2="20" y2="6"></line>
    <circle cx="9" cy="6" r="1.6" fill="currentColor" stroke="none"></circle>
    <line x1="4" y1="12" x2="20" y2="12"></line>
    <circle cx="15" cy="12" r="1.6" fill="currentColor" stroke="none"></circle>
    <line x1="4" y1="18" x2="20" y2="18"></line>
    <circle cx="11" cy="18" r="1.6" fill="currentColor" stroke="none"></circle>
  </svg>
  <span>Accessibility</span>
  <span id="a11y-count-badge" class="a11y-badge" hidden></span>
</button>

<div id="a11y-drawer" class="a11y-drawer" role="dialog" aria-label="Accessibility settings" aria-modal="true" hidden>
  <div class="a11y-drawer-head">
    <h2 class="font-serif text-lg font-bold on-navy">Accessibility settings</h2>
    <button type="button" id="a11y-close-button" class="a11y-drawer-close" aria-label="Close accessibility settings">&times;</button>
  </div>

  <div class="a11y-drawer-body">
    <div class="a11y-font-row">
      <div>
        <p class="font-semibold text-sm">Text size</p>
        <p class="text-xs text-slate-500">Applies to the whole site.</p>
      </div>
      <div class="a11y-font-stepper">
        <button type="button" data-a11y-font="dec" aria-label="Decrease text size">A&minus;</button>
        <span id="a11y-font-value">100%</span>
        <button type="button" data-a11y-font="inc" aria-label="Increase text size">A+</button>
      </div>
    </div>

    <ul class="a11y-toggle-list">
      {toggles.map((t) => (
        <li>
          <label class="a11y-toggle-row">
            <span>
              <span class="block font-semibold text-sm">{t.label}</span>
              <span class="block text-xs text-slate-500">{t.hint}</span>
            </span>
            <span class="a11y-switch">
              <input type="checkbox" data-a11y-toggle={t.key} />
              <span class="a11y-switch-track" aria-hidden="true"></span>
            </span>
          </label>
        </li>
      ))}
    </ul>

    <button type="button" id="a11y-reset-button" class="btn-secondary w-full justify-center mt-2">Reset all</button>
    <p class="text-xs text-slate-500 mt-3">Saved on this device only. Press <kbd class="a11y-kbd">Esc</kbd> to close.</p>
  </div>
</div>

<div id="a11y-reading-guide" aria-hidden="true" hidden></div>

<style>
  .a11y-pill {
    position: fixed;
    right: 1.1rem;
    bottom: var(--a11y-lift, 1.1rem);
    z-index: 2147482999;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-navy-900);
    color: var(--color-offwhite-100);
    border: 1.5px solid var(--color-gold-300);
    border-radius: 999px;
    padding: 0.65rem 1.1rem 0.65rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: var(--shadow-lg);
    transition: bottom var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .a11y-pill { transition: bottom var(--duration-base) linear; }
  }
  @media (hover: hover) and (pointer: fine) {
    .a11y-pill:hover {
      box-shadow: 0 8px 28px -6px rgba(230, 184, 92, 0.5);
      transform: translateY(-1px);
    }
  }
  @media (max-width: 480px) {
    .a11y-pill span:not(.a11y-badge) { display: none; }
    .a11y-pill { padding: 0.7rem; }
  }

  .a11y-badge {
    display: inline-grid;
    place-items: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding-inline: 0.25rem;
    border-radius: 999px;
    background-color: var(--color-gold-300);
    color: var(--color-navy-900);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .a11y-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 2147483002;
    width: min(23rem, 100vw);
    background-color: var(--color-ivory-50);
    box-shadow: -20px 0 40px -20px rgba(8, 31, 51, 0.4);
    display: flex;
    flex-direction: column;
    transform: translateX(0);
    animation: a11y-drawer-in var(--duration-base) var(--ease-out) both;
  }
  @keyframes a11y-drawer-in {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .a11y-drawer { animation: none; }
  }

  .a11y-drawer-head {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.25rem;
    background-color: var(--color-navy-900);
  }
  .a11y-drawer-close {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--color-offwhite-100);
    font-size: 1.4rem;
    line-height: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .a11y-drawer-close:hover { background-color: var(--color-navy-700); color: var(--color-gold-300); }
  }

  .a11y-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
  }

  .a11y-font-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.1rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--color-navy-100);
  }
  .a11y-font-stepper {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .a11y-font-stepper button {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1.5px solid var(--color-navy-100);
    font-weight: 700;
    font-size: 0.85rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .a11y-font-stepper button:hover { border-color: var(--color-gold-300); color: var(--color-gold-500); }
  }
  #a11y-font-value {
    min-width: 3rem;
    text-align: center;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .a11y-toggle-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .a11y-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid var(--color-navy-100);
    cursor: pointer;
  }
  .a11y-toggle-list li:last-child .a11y-toggle-row {
    border-bottom: none;
  }

  .a11y-switch {
    position: relative;
    flex-shrink: 0;
    display: inline-block;
    width: 2.6rem;
    height: 1.5rem;
  }
  .a11y-switch input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .a11y-switch-track {
    position: absolute;
    inset: 0;
    background-color: var(--color-navy-100);
    border-radius: 999px;
    transition: background-color var(--duration-fast) var(--ease-hover);
  }
  .a11y-switch-track::before {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background-color: #fff;
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .a11y-switch input:checked + .a11y-switch-track {
    background-color: var(--color-gold-300);
  }
  .a11y-switch input:checked + .a11y-switch-track::before {
    transform: translateX(1.1rem);
  }
  .a11y-switch input:focus-visible + .a11y-switch-track {
    outline: 2px solid var(--color-gold-500);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .a11y-switch-track, .a11y-switch-track::before { transition: none; }
  }

  .a11y-kbd {
    border: 1px solid var(--color-navy-100);
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
  }

  #a11y-reading-guide {
    position: fixed;
    left: 0;
    right: 0;
    height: 2.5rem;
    pointer-events: none;
    z-index: 2147483003;
    background-color: rgba(255, 217, 138, 0.18);
    border-top: 2px solid var(--color-gold-500);
    border-bottom: 2px solid var(--color-gold-500);
  }
</style>
