---
/**
 * Homepage-only "Built for experts like you" router. Deliberately NOT a
 * 5-card grid (the generic "SaaS card kit" default: identical rounded
 * cards, one shadow, one radius) — an editorial row list instead, using
 * the brand's own door-rule motif (BRAND.md: "a thin gold vertical rule
 * opening into content") so each category reads as a distinct row of
 * information, not a tile in a set. Reads professionGroups from
 * src/data/nav.ts (including its icon/description fields) so the header
 * mega menu and this section never drift apart.
 */
import { professionGroups, professionGroupKeys } from "../data/nav";
---

<section class="bg-navy-100">
  <div class="mx-auto max-w-6xl px-4 py-20 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <p class="eyebrow">Built for experts like you</p>
        <h2 class="mt-3">Pick your world. The advice changes.</h2>
      </div>
      <a href="/start" class="arrow-link font-semibold text-navy-700 hover:text-gold-500 shrink-0" data-cta="router-start-here">
        Don't see your field? Start here <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="mt-10 rounded-2xl bg-white border border-navy-100 shadow-lg overflow-hidden">
      {professionGroups.map((group, i) => {
        const key = professionGroupKeys[i];
        const shown = group.items.slice(0, 4);
        const remaining = group.items.length - shown.length;
        return (
          <div
            class:list={["router-row door-rule flex flex-col gap-5 py-7 pr-6 md:flex-row md:items-center md:gap-10 md:pr-8", i > 0 && "border-t border-navy-100"]}
          >
            <div class="flex items-start gap-4 md:w-[19rem] md:shrink-0">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-navy-900 text-gold-300" aria-hidden="true">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" set:html={group.icon ?? ""} />
              </span>
              <div>
                <h3 class="font-serif text-xl font-semibold text-navy-900">{group.heading}</h3>
                {group.description && <p class="mt-1 text-sm text-slate-500 leading-snug">{group.description}</p>}
              </div>
            </div>
            <div class="flex flex-1 flex-wrap items-center gap-2">
              {shown.map((item) => (
                <a
                  href={item.href}
                  class="rounded-full border border-navy-100 px-4 py-1.5 text-sm font-medium text-navy-700 hover:border-gold-300 hover:bg-gold-100/40 hover:text-navy-900"
                  data-cta={`router-${item.href.split("/").pop()}`}
                >
                  {item.label}
                </a>
              ))}
              {remaining > 0 && (
                <a href={`/for#${key}`} class="text-sm font-semibold text-navy-700 hover:text-gold-500 px-2" data-cta={`router-more-${key}`}>
                  +{remaining} more &rarr;
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Restrained static feedback only (no motion added): the row itself
     tints on hover so the whole category reads as one unit, on top of
     each pill link's own hover state. Background-color only, no
     transform/shadow — this section stays in the site's low-motion tier. */
  .router-row {
    transition: background-color var(--duration-base) var(--ease-hover);
  }
  @media (hover: hover) and (pointer: fine) {
    .router-row:hover {
      background-color: var(--color-ivory-50);
    }
  }

  /* The door-rule motif needs more left padding here than its default
     (built for text sitting directly against the rule) since the icon
     badge sits between the rule and the heading. */
  .router-row.door-rule::before {
    left: 0;
  }
  .router-row {
    padding-left: 2rem;
  }
  @media (min-width: 768px) {
    .router-row {
      padding-left: 2.5rem;
    }
  }
</style>
