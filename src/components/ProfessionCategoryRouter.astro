---
/**
 * Homepage-only "Built for experts like you" router, as an explorer: a navy
 * rail of the five fields on the left (a horizontal strip on phones), and
 * the chosen field's professions as tiles on the right. One field is shown
 * at a time, so the section reads as "pick yours" rather than a wall of 28
 * look-alike chips.
 *
 * Reads professionGroups from src/data/nav.ts (icons and descriptions
 * included) so the header mega menu and this section never drift apart.
 * Every link is in the HTML for all five fields (inactive panels are only
 * visually hidden), so crawlers and AI parsers still see all 28. Without
 * JS the rail is dropped and the five panels simply stack.
 */
import { professionGroups } from "../data/nav";
---

<section class="bg-navy-100">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <p class="eyebrow">Built for experts like you</p>
        <h2 class="mt-3">Pick your world. The advice changes.</h2>
      </div>
      <a href="/start" class="arrow-link font-semibold text-navy-700 hover:text-gold-500 shrink-0" data-cta="router-start-here">
        Don't see your field? Start here <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="router mt-12" data-router data-reveal="item">
      <div class="router-rail" role="tablist" aria-label="Fields we publish for">
        {professionGroups.map((group, i) => (
          <button
            type="button"
            role="tab"
            id={`router-tab-${i}`}
            class="router-tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`router-panel-${i}`}
            tabindex={i === 0 ? 0 : -1}
            data-router-tab
          >
            <span class="router-tab-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" set:html={group.icon ?? ""} />
            </span>
            <span class="router-tab-text">
              <span class="router-tab-title">{group.heading}</span>
              <span class="router-tab-count">{group.items.length} professions</span>
            </span>
            <svg class="router-tab-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3.5L10.5 8 6 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        ))}
      </div>

      <div class="router-panels">
        {professionGroups.map((group, i) => (
          <div
            role="tabpanel"
            id={`router-panel-${i}`}
            class="router-panel"
            aria-labelledby={`router-tab-${i}`}
            data-router-panel
            data-active={i === 0 ? "" : undefined}
          >
            <div class="router-panel-head">
              <h3 class="font-serif text-2xl font-semibold text-navy-900">{group.heading}</h3>
              {group.description && <p class="mt-2 max-w-xl text-slate-500 leading-relaxed">{group.description}</p>}
            </div>
            <ul class="router-grid">
              {group.items.map((item, ti) => (
                <li style={`--i:${ti}`}>
                  <a href={item.href} class="router-tile" data-cta={`router-${item.href.split("/").pop()}`}>
                    <span class="router-tile-icon" aria-hidden="true">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" set:html={item.icon ?? group.icon ?? ""} />
                    </span>
                    <span class="router-tile-label">{item.label}</span>
                    <span class="router-tile-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
            {group.headingHref && (
              <a href={group.headingHref} class="arrow-link router-panel-all">
                See all {group.heading} pages <span class="arrow" aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .router {
    display: grid;
    overflow: hidden;
    border-radius: 24px;
    background: #fff;
    border: 1px solid rgba(8, 31, 51, 0.08);
    box-shadow: 0 30px 60px -30px rgba(8, 31, 51, 0.35);
  }
  @media (min-width: 900px) {
    .router {
      grid-template-columns: 19.5rem minmax(0, 1fr);
    }
  }

  /* ---------- Rail ---------- */
  /* Navy, with the same warm door-glow as the hero and final CTA, so the
     explorer reads as part of this site rather than a stock tab widget. */
  .router-rail {
    position: relative;
    display: flex;
    gap: 0.4rem;
    padding: 0.75rem;
    color: var(--color-offwhite-100);
    background:
      radial-gradient(ellipse 120% 60% at 0% 0%, rgba(255, 217, 138, 0.16), transparent 65%),
      var(--color-navy-900);
    /* Phones: one swipeable strip of fields. */
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .router-rail::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 900px) {
    .router-rail {
      flex-direction: column;
      gap: 0.35rem;
      padding: 1.25rem;
      overflow: visible;
    }
  }

  .router-tab {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.55rem 1rem 0.55rem 0.6rem;
    border-radius: 14px;
    text-align: left;
    cursor: pointer;
    scroll-snap-align: start;
    color: rgba(245, 241, 232, 0.72);
    transition: background-color var(--duration-fast) var(--ease-hover), color var(--duration-fast) var(--ease-hover);
  }
  @media (min-width: 900px) {
    .router-tab {
      gap: 0.9rem;
      padding: 0.85rem 0.9rem 0.85rem 1.1rem;
    }
    /* The door motif: a gold rule opens on the selected field. */
    .router-tab::before {
      content: "";
      position: absolute;
      left: 0;
      top: 22%;
      bottom: 22%;
      width: 3px;
      border-radius: 2px;
      background: var(--color-gold-300);
      transform: scaleY(0);
      transition: transform var(--duration-base) var(--ease-out);
    }
    .router-tab[aria-selected="true"]::before {
      transform: scaleY(1);
    }
  }
  .router-tab-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 11px;
    background: var(--color-navy-700);
    color: var(--color-gold-300);
    transition: background-color var(--duration-base) var(--ease-hover), color var(--duration-base) var(--ease-hover);
  }
  .router-tab-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .router-tab-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
  }
  .router-tab-count {
    display: none;
    margin-top: 0.1rem;
    font-size: 0.78rem;
    opacity: 0.7;
  }
  .router-tab-arrow {
    display: none;
    margin-left: auto;
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
  }
  @media (min-width: 900px) {
    .router-tab-icon {
      width: 2.6rem;
      height: 2.6rem;
      border-radius: 12px;
    }
    .router-tab-title {
      white-space: normal;
    }
    .router-tab-count,
    .router-tab-arrow {
      display: block;
    }
  }

  .router-tab[aria-selected="true"] {
    background: var(--color-navy-700);
    color: var(--color-offwhite-100);
  }
  .router-tab[aria-selected="true"] .router-tab-icon {
    background: var(--color-gold-300);
    color: var(--color-navy-900);
  }
  .router-tab[aria-selected="true"] .router-tab-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-gold-300);
  }
  @media (hover: hover) and (pointer: fine) {
    .router-tab:hover {
      color: var(--color-offwhite-100);
      background: rgba(27, 58, 102, 0.55);
    }
    .router-tab[aria-selected="true"]:hover {
      background: var(--color-navy-700);
    }
  }
  .router-tab:focus-visible {
    outline: 2px solid var(--color-gold-300);
    outline-offset: -2px;
  }

  /* ---------- Panels ---------- */
  .router-panels {
    display: grid;
    min-width: 0;
  }
  .router-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.5rem 1.25rem 1.75rem;
  }
  @media (min-width: 640px) {
    .router-panel {
      padding: 2rem 2rem 2.25rem;
    }
  }
  @media (min-width: 900px) {
    .router-panel {
      padding: 2.5rem 2.75rem 2.5rem;
    }
  }
  /* No JS: the rail is hidden and all five panels stack, each under its
     own heading, with a rule between them. */
  .router:not([data-js]) .router-rail {
    display: none;
  }
  .router:not([data-js]) .router-panel + .router-panel {
    border-top: 1px solid var(--color-navy-100);
  }
  /* With JS, one panel at a time. On desktop the five share one grid cell,
     so the card is always as tall as the fullest field and nothing below
     it jumps when you switch. On phones the hidden ones collapse instead:
     a shorter list shouldn't leave a blank gap on a small screen. */
  .router[data-js] .router-panel:not([data-active]) {
    display: none;
  }
  @media (min-width: 900px) {
    .router[data-js] .router-panel {
      grid-area: 1 / 1;
    }
    .router[data-js] .router-panel:not([data-active]) {
      display: flex;
      visibility: hidden;
    }
  }

  .router-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .router-tile {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 100%;
    min-height: 4rem;
    padding: 0.7rem 0.9rem 0.7rem 0.7rem;
    border: 1px solid var(--color-navy-100);
    border-radius: 14px;
    background: #fff;
    transition: border-color var(--duration-fast) var(--ease-hover), background-color var(--duration-fast) var(--ease-hover),
      box-shadow var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
  }
  .router-tile-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 11px;
    background: var(--color-navy-900);
    color: var(--color-gold-300);
    transition: background-color var(--duration-fast) var(--ease-hover), color var(--duration-fast) var(--ease-hover);
  }
  .router-tile-label {
    flex: 1;
    min-width: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-navy-900);
  }
  .router-tile-arrow {
    flex-shrink: 0;
    color: var(--color-gold-700);
    opacity: 0.8;
    transition: opacity var(--duration-fast) var(--ease-hover), transform var(--duration-base) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .router-tile:hover {
      border-color: var(--color-gold-300);
      background: var(--color-ivory-50);
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }
    .router-tile:hover .router-tile-icon {
      background: var(--color-gold-300);
      color: var(--color-navy-900);
    }
    .router-tile:hover .router-tile-arrow {
      opacity: 1;
      transform: translateX(3px);
    }
  }
  .router-tile:active {
    transform: scale(0.98);
  }

  .router-panel-all {
    margin-top: auto;
    padding-top: 1.5rem;
    align-self: flex-start;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-navy-700);
  }

  /* Switching fields: the heading fades up and the tiles follow on a 30ms
     cascade. Only plays on a switch ([data-switched] is set by the script),
     never on first paint. */
  @keyframes router-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  .router[data-switched] .router-panel[data-active] .router-panel-head,
  .router[data-switched] .router-panel[data-active] .router-grid > li,
  .router[data-switched] .router-panel[data-active] .router-panel-all {
    animation: router-in 280ms var(--ease-out) both;
  }
  .router[data-switched] .router-panel[data-active] .router-grid > li {
    animation-delay: calc(var(--i, 0) * 30ms + 40ms);
  }
  .router[data-switched] .router-panel[data-active] .router-panel-all {
    animation-delay: 220ms;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-router]").forEach((router) => {
    const tabs = Array.from(router.querySelectorAll<HTMLButtonElement>("[data-router-tab]"));
    const panels = Array.from(router.querySelectorAll<HTMLElement>("[data-router-panel]"));
    if (!tabs.length || tabs.length !== panels.length) return;
    router.setAttribute("data-js", "");
    let current = 0;

    function select(index: number, focus = false) {
      if (index === current) return;
      current = index;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].toggleAttribute("data-active", on);
      });
      router.setAttribute("data-switched", "");
      const tab = tabs[index];
      if (focus) tab.focus();
      // Phones: keep the chosen field in view inside the swipeable strip
      // (scrolls the strip only, never the page).
      const rail = tab.parentElement;
      if (rail && rail.scrollWidth > rail.clientWidth) {
        rail.scrollTo({ left: tab.offsetLeft - 12, behavior: "smooth" });
      }
    }

    // Hover selects too, after a short pause, so sweeping the pointer down
    // the rail on the way to a tile doesn't flick through every field.
    let hoverTimer = 0;
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "mouse") return;
        hoverTimer = window.setTimeout(() => select(i), 110);
      });
      tab.addEventListener("pointerleave", () => window.clearTimeout(hoverTimer));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        let next = -1;
        if (event.key === "ArrowDown" || event.key === "ArrowRight") next = i === last ? 0 : i + 1;
        else if (event.key === "ArrowUp" || event.key === "ArrowLeft") next = i === 0 ? last : i - 1;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = last;
        if (next < 0) return;
        event.preventDefault();
        select(next, true);
      });
    });
  });
</script>
