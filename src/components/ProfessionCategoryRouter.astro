---
/**
 * Homepage-only "Built for experts like you" router: five category cards
 * (Health, Wealth, Relationships, Leadership & Career, Service Providers),
 * each linking to up to four of its professions plus a link to the rest.
 * Replaces the old flat 16-link grid with the same real data already
 * canonical in src/data/nav.ts (professionGroups) so the two never drift.
 */
import { professionGroups, professionGroupKeys } from "../data/nav";

const icons: Record<string, string> = {
  Health:
    '<path d="M12 21s-7-4.5-9-9.5C1.5 7 4.5 4 8 4c2 0 3.2 1 4 2 .8-1 2-2 4-2 3.5 0 6.5 3 5 7.5-2 5-9 9.5-9 9.5z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  Wealth:
    '<path d="M3 20h18M6 16v-6M11 16V6M16 16v-4M20 16V8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  Relationships:
    '<circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="16" cy="8" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6M14 14.3c.6-.2 1.3-.3 2-.3 3.3 0 6 2.7 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  "Leadership & Career":
    '<rect x="3" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  "Service Providers":
    '<path d="M12 3l8 4-8 4-8-4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 12l8 4 8-4M4 17l8 4 8-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
};
---

<section class="bg-navy-100">
  <div class="mx-auto max-w-6xl px-4 py-20 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <p class="eyebrow">Built for experts like you</p>
        <h2 class="mt-3">Pick your world. The advice changes.</h2>
      </div>
      <a href="/start" class="arrow-link font-semibold text-navy-700 hover:text-gold-500 shrink-0" data-cta="router-start-here">
        Don't see your field? Start here <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 md:gap-5">
      {professionGroups.map((group, i) => {
        const key = professionGroupKeys[i];
        const shown = group.items.slice(0, 4);
        const remaining = group.items.length - shown.length;
        return (
          <div class="stagger-card card p-6 flex flex-col gap-4" style={`--stagger-i: ${i}`}>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-navy-100 text-navy-700" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" set:html={icons[group.heading] ?? ""} />
            </span>
            <h3 class="font-serif text-xl font-semibold text-navy-900">{group.heading}</h3>
            <ul class="flex flex-col gap-2 text-[0.95rem]">
              {shown.map((item) => (
                <li>
                  <a href={item.href} class="text-slate-500 hover:text-navy-700" data-cta={`router-${item.href.split("/").pop()}`}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
            {remaining > 0 && (
              <a href={`/for#${key}`} class="mt-auto text-sm font-semibold text-navy-700 hover:text-gold-500" data-cta={`router-more-${key}`}>
                +{remaining} more &rarr;
              </a>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  @keyframes stagger-card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  :global(.reveal) .stagger-card {
    opacity: 0;
  }
  :global(.reveal.is-visible) .stagger-card {
    animation: stagger-card-in var(--duration-base) var(--ease-out) both;
    animation-delay: min(calc(var(--stagger-i, 0) * 45ms), 300ms);
  }
</style>
