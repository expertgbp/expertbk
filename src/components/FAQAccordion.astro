---
import FAQPageSchema from "./schema/FAQPageSchema.astro";

interface Props {
  faqs: { question: string; answer: string }[];
  heading?: string;
}
const { faqs, heading = "Frequently asked questions" } = Astro.props;
---

<section class="bg-ivory-50">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="text-center mb-8">{heading}</h2>
    <div class="space-y-3">
      {faqs.map((faq, i) => (
        <details class="card p-5 group" name="faq-accordion">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-semibold text-ink-900">
            {faq.question}
            <svg width="14" height="14" viewBox="0 0 14 14" class="shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">
              <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </summary>
          <p class="mt-3 text-slate-500 leading-relaxed">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<FAQPageSchema faqs={faqs} />
