---
/**
 * FAQ as a two-column block: the heading and a "still have a question?"
 * card stay pinned on the left while the questions scroll past on the
 * right. The questions are numbered rows divided by hairlines (not a stack
 * of separate cards), each opening with a gold rule on its left edge.
 *
 * Still native <details>, so it works with JS off, and only one answer is
 * open at a time (shared `name`). The first one starts open so the section
 * never reads as six closed doors. The two columns collapse to one based
 * on the width of the block itself (a container query), so this fits both
 * full-width pages and narrower article layouts without any props.
 */
import FAQPageSchema from "./schema/FAQPageSchema.astro";

interface Props {
  faqs: { question: string; answer: string }[];
  heading?: string;
}
const { faqs, heading = "Frequently asked questions" } = Astro.props;
---

<section class="bg-ivory-50">
  <div class="faq-wrap mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="faq-layout">
      <div class="faq-aside">
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-3">{heading}</h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-500">Straight answers to the questions we hear most.</p>

        <div class="faq-help on-navy-surface">
          <span class="faq-help-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M4 5h16v11H9l-5 4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
              <path d="M8.5 9.5h7M8.5 12.5h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </svg>
          </span>
          <div>
            <p class="font-serif text-lg font-semibold on-navy">Still have a question?</p>
            <a href="/contact" class="arrow-link faq-help-link" data-cta="faq-contact">
              Talk to a real person <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <div class="faq-list" data-reveal="children">
        {faqs.map((faq, i) => (
          <details class="faq-item group" name="faq-accordion" open={i === 0}>
            <summary class="faq-summary">
              <span class="faq-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="faq-question">{faq.question}</span>
              <span class="faq-toggle" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M1 7h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  <path class="faq-toggle-v" d="M7 1v12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <div class="faq-panel">
              <div class="faq-panel-inner">
                <p class="faq-answer">{faq.answer}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
<FAQPageSchema faqs={faqs} />

<style>
  .faq-wrap {
    container-type: inline-size;
  }
  .faq-layout {
    display: grid;
    gap: 2.5rem;
  }
  /* Two columns once the block itself is wide enough for both. */
  @container (min-width: 56rem) {
    .faq-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
      gap: 5rem;
    }
    .faq-aside {
      position: sticky;
      top: 6.5rem; /* clears the sticky header */
    }
  }

  /* ---------- Left: heading + help card ---------- */
  .faq-help {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1.25rem 1.4rem;
    border-radius: 18px;
    color: var(--color-offwhite-100);
    background:
      radial-gradient(ellipse 90% 90% at 100% 0%, rgba(255, 217, 138, 0.2), transparent 65%),
      var(--color-navy-900);
  }
  .faq-help-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    background: var(--color-gold-300);
    color: var(--color-navy-900);
  }
  .faq-help-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem; /* 44px touch target */
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-gold-300);
  }

  /* ---------- Right: numbered rows ---------- */
  .faq-list {
    border-top: 1px solid var(--color-navy-100);
  }
  .faq-item {
    position: relative;
    border-bottom: 1px solid var(--color-navy-100);
    transition: background-color var(--duration-base) var(--ease-hover);
  }
  /* The door rule: opens down the left edge of the question that's open. */
  .faq-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 2px;
    background: var(--color-gold-300);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .faq-item[open] {
    background: #fff;
  }
  .faq-item[open]::before {
    transform: scaleY(1);
  }
  .faq-summary {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.35rem 1rem 1.35rem 1.25rem;
    list-style: none;
    cursor: pointer;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-summary:focus-visible {
    outline: 2px solid var(--color-gold-500);
    outline-offset: -2px;
    border-radius: 6px;
  }
  .faq-num {
    flex-shrink: 0;
    width: 1.75rem;
    padding-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--color-gold-700);
  }
  .faq-question {
    flex: 1;
    min-width: 0;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-navy-900);
  }
  .faq-toggle {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--color-navy-100);
    color: var(--color-navy-700);
    transition: background-color var(--duration-base) var(--ease-hover), color var(--duration-base) var(--ease-hover),
      transform var(--duration-base) var(--ease-out);
  }
  /* Plus becomes minus: the vertical bar turns flat as the row opens. */
  .faq-toggle-v {
    transform-origin: center;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .faq-item[open] .faq-toggle {
    background: var(--color-gold-300);
    color: var(--color-navy-900);
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-toggle-v {
    transform: rotate(90deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .faq-item:not([open]):hover {
      background: rgba(255, 255, 255, 0.6);
    }
    .faq-item:not([open]):hover .faq-toggle {
      background: var(--color-navy-900);
      color: var(--color-gold-300);
    }
  }
  .faq-answer {
    /* Lines up under the question, past the number column. */
    padding: 0 1.25rem 1.6rem calc(1.25rem + 1.75rem + 1rem);
    max-width: 62ch;
    line-height: 1.7;
    color: var(--color-slate-500);
  }
  @media (max-width: 479px) {
    .faq-summary {
      gap: 0.75rem;
      padding-left: 1rem;
    }
    .faq-question {
      font-size: 1.1rem;
    }
    .faq-answer {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  /* Native <details> has no built-in transition for content height. Per
     Emil Kowalski's rule, height animation is tolerated only for
     accordions (there's no transform equivalent), so it's allowed here,
     kept short and gated the same way as the rest of the component's
     motion. The 0fr/1fr grid-row trick animates height without measuring
     it in JS. */
  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-base) var(--ease-out);
  }
  details[open] > .faq-panel {
    grid-template-rows: 1fr;
  }
  .faq-panel-inner {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-panel,
    .faq-toggle,
    .faq-toggle-v,
    .faq-item::before {
      transition: none;
    }
  }
</style>
