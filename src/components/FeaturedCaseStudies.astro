---
/**
 * Homepage-only "Featured case studies" spotlight: 3 real authors (picked
 * because their real published video titles name a real book, giving
 * something concrete to feature — not picked at random), presented as a
 * static editorial grid rather than the auto-advancing proof carousel
 * (VideoTestimonialSlider) elsewhere on this page. Distinct in form and
 * purpose: that carousel is broad social proof ("9 authors walked this
 * path"), this is depth on 3 specific stories, each linking to the fuller
 * write-up on /case-studies.
 */
import { videoTestimonials } from "../data/testimonials";

const spotlightIds = ["F6fEzTgmRJU", "wp_pjolLuOo", "UTyHmnS1RV0"]; // Annette, Gavin, Penny
const spotlight = spotlightIds
  .map((id) => videoTestimonials.find((t) => t.youtubeId === id))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
---

<section class="bg-ivory-50">
  <div class="mx-auto max-w-5xl px-4 py-20 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <p class="eyebrow">Featured case studies</p>
        <h2 class="mt-3">Three authors, three different books</h2>
      </div>
      <a href="/case-studies" class="arrow-link font-semibold text-navy-700 hover:text-gold-500 shrink-0" data-cta="case-studies-see-all">
        See all case studies <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6">
      {spotlight.map((t) => (
        <a href="/case-studies" class="case-study-card card flex flex-col gap-4 p-5" data-cta={`case-study-${t.youtubeId}`}>
          <button
            type="button"
            class="video-thumb"
            data-youtube-id={t.youtubeId}
            aria-label={`Play video: ${t.name}, author of ${t.bookTitle}`}
          >
            <img
              src={`https://i.ytimg.com/vi/${t.youtubeId}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              width="480"
              height="360"
            />
            <span class="play-badge" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M8 5v14l11-7z" fill="#081F33"/></svg>
            </span>
          </button>
          <div>
            <p class="font-serif text-lg font-semibold text-navy-900">{t.name}</p>
            <p class="mt-1 text-sm text-slate-500">Author of <em>{t.bookTitle}</em></p>
          </div>
          <span class="mt-auto text-sm font-semibold text-navy-700">Read the full story &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .case-study-card {
    text-decoration: none;
  }
  .video-thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    overflow: hidden;
    border: none;
    padding: 0;
    cursor: pointer;
    background: var(--color-navy-900);
    /* Frame ring via box-shadow (not `border`, to leave the button's box
       model alone) so the thumbnail reads as a distinct object inside
       the card, not a bare image — matches the navy-100 border already
       used on .card elsewhere on this light background. */
    box-shadow: 0 0 0 1px var(--color-navy-100);
    transition: box-shadow var(--duration-fast) var(--ease-hover);
  }
  @media (hover: hover) and (pointer: fine) {
    .video-thumb:hover {
      box-shadow: 0 0 0 1.5px var(--color-gold-300);
    }
  }
  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .play-badge {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .play-badge::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(8, 31, 51, 0.15);
  }
  .play-badge svg {
    position: relative;
    width: 48px;
    height: 48px;
    padding: 13px;
    box-sizing: border-box;
    border-radius: 999px;
    background: var(--color-gold-300);
    box-shadow: var(--shadow-lg);
  }
  @media (hover: hover) and (pointer: fine) {
    .video-thumb:hover .play-badge svg {
      background: var(--color-gold-500);
    }
  }
  .video-embed {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    overflow: hidden;
    border: none;
    box-shadow: 0 0 0 1.5px var(--color-gold-300), var(--shadow-lg);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".case-study-card [data-youtube-id]").forEach((btn) => {
    btn.addEventListener("click", (event) => {
      // The button sits inside a card that's otherwise a link to
      // /case-studies; clicking the thumbnail plays the video in place
      // instead of navigating away.
      event.preventDefault();
      event.stopPropagation();
      const id = btn.dataset.youtubeId;
      const iframe = document.createElement("iframe");
      iframe.className = "video-embed";
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = btn.getAttribute("aria-label") || "Video testimonial";
      iframe.allow = "accelerate-compute; autoplay; encrypted-media; picture-in-picture";
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });
</script>
