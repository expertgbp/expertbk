---
/**
 * A designed thumbnail for an author video, used instead of YouTube's raw
 * frame (a soft webcam still with a play button over the person's face).
 *
 * It is a navy card: the author's name and book set large on the left with
 * a "Watch the video" pill, and the real video frame on the right as a
 * framed portrait with a gold outline behind it. Shown small, the frame
 * looks sharp, and nothing sits on top of the face.
 *
 * Renders a <button data-youtube-id>. The parent's script swaps it for the
 * YouTube iframe on click (see VideoTestimonialSlider / FeaturedCaseStudies),
 * so no video loads until someone asks for it.
 *
 * Sizes itself from its own width (container query units), so the same
 * component works as a small slider card and as the large case-study stage.
 * The frame is always the real one from the video; no face is generated.
 */
interface Props {
  youtubeId: string;
  name: string;
  bookTitle?: string;
  /** YouTube has no 640px still for a few older uploads; set this to fall
   * back to the 480px one (see src/data/testimonials.ts). */
  lowResThumb?: boolean;
  eager?: boolean;
}
const { youtubeId, name, bookTitle, lowResThumb = false, eager = false } = Astro.props;
const still = `https://i.ytimg.com/vi/${youtubeId}/${lowResThumb ? "hqdefault" : "sddefault"}.jpg`;
---

<button
  type="button"
  class="vthumb"
  data-youtube-id={youtubeId}
  data-title={`Video testimonial: ${name}${bookTitle ? ", author of " + bookTitle : ""}`}
>
  <span class="vthumb-dots" aria-hidden="true"></span>

  <span class="vthumb-text">
    <span class="vthumb-kicker">Author story</span>
    <span class="vthumb-name">{name}</span>
    <span class="vthumb-book">
      {bookTitle ? <Fragment>Author of <em>{bookTitle}</em></Fragment> : "Global Book Publishing author"}
    </span>
    <span class="vthumb-play">
      <span class="vthumb-play-icon">
        <svg viewBox="0 0 24 24" fill="none"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
      </span>
      Watch the video
    </span>
  </span>

  <span class="vthumb-photo" aria-hidden="true">
    <span class="vthumb-frame">
      <img src={still} alt="" width="640" height="480" loading={eager ? "eager" : "lazy"} decoding="async" />
    </span>
  </span>
</button>

<style>
  .vthumb {
    container-type: inline-size;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 40%;
    align-items: center;
    gap: 4%;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 6% 6% 6% 7%;
    overflow: hidden;
    border: none;
    border-radius: 14px;
    text-align: left;
    color: var(--color-offwhite-100);
    cursor: pointer;
    background:
      radial-gradient(ellipse 70% 90% at 100% 0%, rgba(255, 217, 138, 0.26), transparent 65%),
      radial-gradient(ellipse 60% 80% at 0% 100%, rgba(27, 58, 102, 0.9), transparent 70%),
      var(--color-navy-900);
  }
  /* A fine dot field in the lower-left, behind the text. */
  .vthumb-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 217, 138, 0.2) 1px, transparent 1.5px);
    background-size: 18px 18px;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 0% 100%, #000, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 70% at 0% 100%, #000, transparent 75%);
  }

  /* ---------- Text ---------- */
  .vthumb-text {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .vthumb-kicker {
    font-size: clamp(0.55rem, 2.4cqw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-300);
  }
  .vthumb-name {
    margin-top: 0.35em;
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 6.6cqw, 2.9rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .vthumb-book {
    margin-top: 0.5em;
    font-size: clamp(0.7rem, 3cqw, 1.05rem);
    line-height: 1.35;
    opacity: 0.8;
    /* long book titles stay on two lines at most */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .vthumb-play {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    align-self: flex-start;
    margin-top: clamp(0.7rem, 4cqw, 1.75rem);
    padding: 0.35em 1em 0.35em 0.35em;
    border-radius: 999px;
    background: var(--color-gold-300);
    font-size: clamp(0.7rem, 2.9cqw, 1rem);
    font-weight: 700;
    white-space: nowrap;
    color: var(--color-navy-900);
    box-shadow: 0 0 0 0 rgba(255, 217, 138, 0.3);
    transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out),
      background-color var(--duration-fast) var(--ease-hover);
  }
  .vthumb-play-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2em;
    height: 2em;
    border-radius: 999px;
    background: var(--color-navy-900);
    color: var(--color-gold-300);
  }
  .vthumb-play-icon svg {
    width: 0.9em;
    height: 0.9em;
    margin-left: 0.08em; /* optical: a play triangle looks off-center when it's mathematically centered */
  }

  /* ---------- Portrait ---------- */
  .vthumb-photo {
    position: relative;
    align-self: stretch;
  }
  /* The gold outline, offset behind the frame. */
  .vthumb-photo::before {
    content: "";
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--color-gold-300);
    border-radius: 9% / 8%;
    translate: 5% 4%;
    transition: translate 400ms var(--ease-out);
  }
  /* The frame clips the still to its rounded shape. */
  .vthumb-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 9% / 8%;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
    background: var(--color-navy-700);
  }
  .vthumb-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The still is 4:3 with black bars baked in above and below; scaling
       it up inside the frame pushes those bars out of view. */
    scale: 1.36;
    transition: scale 600ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .vthumb:hover .vthumb-play {
      transform: translateY(-2px);
      background: var(--color-gold-500);
      box-shadow: 0 0 0 0.5em rgba(255, 217, 138, 0.18);
    }
    .vthumb:hover .vthumb-frame img {
      scale: 1.42;
    }
    .vthumb:hover .vthumb-photo::before {
      translate: 2.5% 2%;
    }
  }
  .vthumb:active .vthumb-play {
    transform: scale(0.97);
  }
  .vthumb:focus-visible {
    outline: 2px solid var(--color-gold-300);
    outline-offset: 3px;
  }
</style>
