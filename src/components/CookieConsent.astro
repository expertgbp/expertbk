---
/**
 * Sitewide cookie notice: a compact bottom-right popup card (not a
 * full-width bar), so it reads as a polite interruption rather than
 * chrome bolted across the whole viewport. Logic lives in
 * src/scripts/cookie-consent.ts; this component is markup + styling only.
 *
 * Text color is set once on .cc-card itself (not per-element) so nothing
 * inside it can silently fall back to the page's default dark ink color
 * against this card's navy background.
 */
---

<div id="cookie-consent-bar" class="cc-card" role="dialog" aria-live="polite" aria-label="Cookie notice" hidden>
  <div class="cc-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9"></circle>
      <circle cx="9" cy="9.5" r="1"></circle>
      <circle cx="14.5" cy="8.5" r="1"></circle>
      <circle cx="15" cy="14" r="1"></circle>
      <circle cx="9.5" cy="14.5" r="1"></circle>
    </svg>
  </div>
  <p class="cc-heading">We use a few cookies</p>
  <p class="cc-body">
    Necessary cookies keep this site working. With your OK, we also use cookies to see how the site
    is used and measure our ads. Read the <a href="/privacy">Privacy Policy</a>.
  </p>
  <div class="cc-actions">
    <button type="button" class="btn-primary w-full justify-center" data-cc="accept">Accept all</button>
    <div class="cc-actions-row">
      <button type="button" class="btn-secondary on-navy flex-1 justify-center" data-cc="manage">Manage</button>
      <button type="button" class="btn-secondary on-navy flex-1 justify-center" data-cc="reject">Necessary only</button>
    </div>
  </div>
</div>

<div id="cookie-preferences-modal" class="cc-modal" role="dialog" aria-modal="true" aria-labelledby="cc-modal-title" hidden>
  <div class="cc-modal-card card p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4 mb-1">
      <h2 id="cc-modal-title" class="text-xl font-serif font-bold">Cookie preferences</h2>
      <button type="button" class="cc-close" data-cc="close" aria-label="Close cookie preferences">&times;</button>
    </div>
    <p class="text-slate-500 mb-6">Necessary cookies keep the site working and can't be turned off.</p>

    <div class="space-y-4">
      <div class="cc-row">
        <div>
          <p class="font-semibold">Necessary</p>
          <p class="text-sm text-slate-500">Security, navigation, and remembering this choice.</p>
        </div>
        <input type="checkbox" checked disabled aria-label="Necessary cookies (always on)" />
      </div>
      <label class="cc-row">
        <div>
          <p class="font-semibold">Analytics</p>
          <p class="text-sm text-slate-500">Anonymous usage stats that help us improve the site.</p>
        </div>
        <input type="checkbox" data-cat="analytics" />
      </label>
      <label class="cc-row">
        <div>
          <p class="font-semibold">Marketing</p>
          <p class="text-sm text-slate-500">Ad measurement and personalization.</p>
        </div>
        <input type="checkbox" data-cat="marketing" />
      </label>
    </div>

    <div class="mt-7 flex flex-col sm:flex-row gap-3 sm:justify-end">
      <button type="button" class="btn-secondary" data-cc="reject">Necessary only</button>
      <button type="button" class="btn-primary" data-cc="save">Save choices</button>
    </div>
  </div>
</div>

<style>
  .cc-card {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    left: 1.1rem;
    z-index: 2147483000;
    margin-inline: auto;
    max-width: 23rem;
    background-color: var(--color-navy-900);
    color: var(--color-offwhite-100);
    border: 1px solid rgba(255, 217, 138, 0.25);
    border-left: 4px solid var(--color-gold-300);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    padding: 1.35rem 1.4rem 1.5rem;
    animation: cc-card-in var(--duration-base) var(--ease-out) both;
  }
  @keyframes cc-card-in {
    from { opacity: 0; transform: translateY(14px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cc-card { animation: none; }
  }
  @media (min-width: 640px) {
    .cc-card { left: auto; }
  }

  .cc-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background-color: rgba(255, 217, 138, 0.14);
    color: var(--color-gold-300);
    margin-bottom: 0.75rem;
  }
  .cc-heading {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-offwhite-100);
  }
  .cc-body {
    margin-top: 0.45rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-offwhite-100);
    opacity: 0.82;
  }
  .cc-body a {
    color: var(--color-gold-300);
    text-decoration: underline;
    text-underline-offset: 2px;
    opacity: 1;
  }

  .cc-actions {
    margin-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .cc-actions-row {
    display: flex;
    gap: 0.6rem;
  }
  .cc-actions .btn-primary,
  .cc-actions .btn-secondary {
    padding: 0.6rem 1rem;
    min-height: 40px;
    font-size: 0.85rem;
    white-space: normal;
  }

  .cc-modal {
    position: fixed;
    inset: 0;
    z-index: 2147483001;
    background-color: rgba(8, 31, 51, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .cc-modal-card {
    width: min(30rem, 100%);
    max-height: 90dvh;
    overflow-y: auto;
    background-color: var(--color-ivory-50);
    animation: cc-modal-in var(--duration-base) var(--ease-out) both;
  }
  @keyframes cc-modal-in {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cc-modal-card { animation: none; }
  }

  .cc-close {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--color-slate-500);
  }
  @media (hover: hover) and (pointer: fine) {
    .cc-close:hover {
      background-color: var(--color-navy-100);
      color: var(--color-navy-900);
    }
  }

  .cc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-navy-100);
    border-radius: var(--radius-card);
    cursor: default;
  }
  label.cc-row {
    cursor: pointer;
  }
  .cc-row input[type="checkbox"] {
    flex-shrink: 0;
    width: 1.35rem;
    height: 1.35rem;
    accent-color: var(--color-gold-500);
  }
</style>
