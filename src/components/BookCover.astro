---
/**
 * Renders one real (or AI-placeholder) book cover as a physical book: a
 * front cover with a pressed spine crease, a block of pages down the fore
 * edge, a back cover, and a soft ground shadow. Stands at a slight angle
 * and turns to face the visitor (and lifts) on hover.
 *
 * Takes the image as a prop so swapping a placeholder-<topic>.webp for a
 * real cover later means changing only the import in BookShelf.astro,
 * never this component. Pure CSS 3D, no script: nothing to lazy-load, and
 * the global reduced-motion / "Stop animations" rules already still it.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
}
const { image, alt } = Astro.props;
---

<div class="book">
  <div class="book-body">
    <span class="book-front">
      <Image src={image} alt={alt} width={360} height={540} class="book-cover-img" />
    </span>
  </div>
  <span class="book-shadow" aria-hidden="true"></span>
</div>

<style>
  .book {
    --book-depth: 20px;
    position: relative;
    height: 100%;
    perspective: 900px;
  }
  .book-body {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateY(-22deg);
    transition: transform 500ms var(--ease-out);
  }

  /* Front cover, pushed forward by half the book's thickness. */
  .book-front {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: 2px 5px 5px 2px;
    transform: translateZ(calc(var(--book-depth) / 2));
    background: var(--color-navy-100);
  }
  .book-front :global(.book-cover-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Spine crease + a faint sheen, so the cover reads as printed board
     catching light rather than a flat image. The sheen slides across once
     on hover (same one-shot gold-tinted sweep as .card, never a loop). */
  .book-front::before,
  .book-front::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .book-front::before {
    background: linear-gradient(
      90deg,
      rgba(8, 31, 51, 0.28) 0%,
      rgba(255, 255, 255, 0.22) 2.5%,
      rgba(8, 31, 51, 0.14) 5%,
      transparent 9%
    );
  }
  .book-front::after {
    background: linear-gradient(110deg, transparent 35%, rgba(255, 255, 255, 0.32) 50%, transparent 65%);
    background-size: 260% 100%;
    background-position: 160% 0;
  }

  /* The page block along the fore edge. */
  .book-body::before {
    content: "";
    position: absolute;
    top: 1.2%;
    bottom: 1.2%;
    right: calc(3px - var(--book-depth) / 2);
    width: var(--book-depth);
    transform: rotateY(90deg);
    background: repeating-linear-gradient(
      90deg,
      #fffdf8 0,
      #fffdf8 1.5px,
      #e6dfd0 1.5px,
      #e6dfd0 2.5px
    );
  }
  /* Back cover. */
  .book-body::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 2px 5px 5px 2px;
    transform: translateZ(calc(var(--book-depth) / -2));
    background: var(--color-navy-900);
    box-shadow: -10px 12px 28px -6px rgba(8, 31, 51, 0.38);
  }

  /* Ground shadow: tightens and darkens as the book lifts. */
  .book-shadow {
    position: absolute;
    left: 8%;
    right: 2%;
    bottom: -14px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(8, 31, 51, 0.3), transparent 70%);
    transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .book:hover .book-body {
      transform: rotateY(-6deg) translateY(-10px);
    }
    .book:hover .book-shadow {
      opacity: 0.6;
      transform: scale(0.88);
    }
    .book-front::after {
      transition: background-position 700ms var(--ease-out);
    }
    .book:hover .book-front::after {
      background-position: -60% 0;
    }
  }

  /* Phones: thinner book and a gentler angle so two fit side by side
     without the turned fore edge crowding its neighbor. */
  @media (max-width: 639px) {
    .book {
      --book-depth: 14px;
    }
    .book-body {
      transform: rotateY(-16deg);
    }
  }
</style>
