---
/**
 * Renders one real (or AI-placeholder) book cover image inside the
 * bookshelf's spine-shaped frame. Takes the image as a prop so swapping a
 * placeholder-<topic>.webp for a real cover later means changing only the
 * import in BookShelf.astro, never this component.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
}
const { image, alt } = Astro.props;
---

<Image src={image} alt={alt} width={214} height={300} class="book-cover-img" />

<style>
  .book-cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 3px 8px 8px 3px;
    box-shadow: 0 18px 30px rgba(8, 31, 51, 0.25);
  }
</style>
