---
import { entity } from "../data/entity";

interface Props {
  /** Optional per-page framing override for each stage's description. */
  overrides?: Partial<Record<string, string>>;
}
const { overrides = {} } = Astro.props;
---

<div class="relative grid grid-cols-1 gap-10 md:grid-cols-4 md:gap-6">
  <!-- Connects the four numbered stages into one path, not four disconnected
       cards. Sits behind the number badges, only on the row layout (md+)
       where the four are side by side. -->
  <div
    class="pointer-events-none absolute left-[12.5%] right-[12.5%] top-[18px] hidden h-[2px] bg-gold-300/50 md:block"
    aria-hidden="true"
  >
  </div>

  {entity.method.stages.map((stage, i) => (
    <div class="path-step relative flex flex-col items-center text-center">
      <span
        class="relative z-[1] flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-2 border-gold-300 bg-white font-serif text-lg font-bold text-gold-500"
        aria-hidden="true"
      >
        {i + 1}
      </span>
      <h3 class="mt-3 font-serif font-semibold text-lg">{stage.title}</h3>
      <p class="mt-2 max-w-[26ch] text-sm text-slate-500">{overrides[stage.key] ?? stage.description}</p>
    </div>
  ))}
</div>

<style>
  /* On mobile the four stages stack in one column already reading top to
     bottom; a short gold rule through the gap between each pair of numbers
     makes that order read as one path rather than four separate blocks.
     Sized to exactly fill the gap-10 (2.5rem) row gap. */
  @media (max-width: 767px) {
    .path-step:not(:first-child)::before {
      content: "";
      position: absolute;
      top: -2.5rem;
      left: 50%;
      width: 2px;
      height: 2.5rem;
      background: var(--color-gold-300);
      opacity: 0.5;
      transform: translateX(-50%);
    }
  }
</style>
