---
interface Props {
  faqs: { question: string; answer: string }[];
}
const { faqs } = Astro.props;

const data = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
