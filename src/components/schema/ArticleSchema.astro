---
import { entity } from "../../data/entity";

interface Props {
  headline: string;
  description: string;
  authorName: "Ash Goel" | "Susmita Dutta";
  datePublished: Date;
  dateModified?: Date;
}
const { headline, description, authorName, datePublished, dateModified } = Astro.props;

const data = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline,
  description,
  datePublished: datePublished.toISOString(),
  dateModified: (dateModified ?? datePublished).toISOString(),
  author: {
    "@type": "Person",
    name: authorName,
  },
  publisher: {
    "@type": "Organization",
    name: entity.legalName,
    alternateName: entity.brandName,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
