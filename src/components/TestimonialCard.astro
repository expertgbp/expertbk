---
/**
 * One testimonial slot. "confirmed" renders a real, permissioned quote as a
 * large pull-quote card. "placeholder" renders a clearly-marked empty slot
 * (never an invented quote): a dashed frame saying a real one is pending,
 * so nobody mistakes it for finished proof.
 */
interface Props {
  status: "placeholder" | "confirmed";
  quote?: string;
  attribution?: string;
  placeholderNote?: string;
}
const { status, quote, attribution, placeholderNote = "[TESTIMONIAL: pending permission]" } = Astro.props;
---

{status === "confirmed" && quote ? (
  <blockquote class="quote-card card">
    <svg width="36" height="26" viewBox="0 0 28 20" class="quote-mark" aria-hidden="true">
      <path
        d="M0 20V11.6C0 4.8 4.4 0.6 11 0L11.8 2.6C7.8 3.6 5.6 6 5.4 9.4H11V20H0ZM16.2 20V11.6C16.2 4.8 20.6 0.6 27.2 0L28 2.6C24 3.6 21.8 6 21.6 9.4H27.2V20H16.2Z"
        fill="currentColor"
      />
    </svg>
    <p class="quote-text">&ldquo;{quote}&rdquo;</p>
    {attribution && <footer class="quote-by">{attribution}</footer>}
  </blockquote>
) : (
  <div class="quote-pending" aria-label="Testimonial pending permission">
    <span class="quote-pending-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 3" />
        <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </span>
    <p>{placeholderNote}</p>
  </div>
)}

<style>
  .quote-card {
    padding: 1.75rem 1.5rem;
    border-radius: 24px;
  }
  @media (min-width: 768px) {
    .quote-card {
      padding: 2.5rem 2.75rem;
    }
  }
  /* Gold door rule down the left edge of the quote. */
  .quote-card::after {
    content: "";
    position: absolute;
    left: 0;
    top: 1.75rem;
    bottom: 1.75rem;
    width: 4px;
    border-radius: 0 3px 3px 0;
    background: var(--color-gold-300);
  }
  .quote-mark {
    color: var(--color-gold-300);
  }
  .quote-text {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.6rem);
    line-height: 1.45;
    color: var(--color-navy-900);
  }
  .quote-by {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-slate-500);
  }

  .quote-pending {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1.5px dashed rgba(27, 58, 102, 0.3);
    border-radius: 20px;
    background: rgba(232, 238, 245, 0.45);
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-slate-500);
  }
  .quote-pending-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: #fff;
    color: var(--color-slate-500);
  }
</style>
