---
/**
 * The four headline numbers, as a rounded navy card on a light band (the
 * same "navy card on a light page" language as the Blueprint and final
 * call-to-action cards) rather than a full-width strip. Each number has
 * its own icon tile and a plain label; thin gold dividers sit between
 * them on the 4-up row.
 *
 * Every value comes from src/data/entity.ts. The scroll entrance comes
 * from src/scripts/reveal.ts (each stat is one block), the count-up from
 * src/scripts/count-up.ts.
 */
import { entity } from "../data/entity";

const stats = [
  {
    value: entity.proofBank.authorsCount,
    label: "authors",
    // pen
    icon: '<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    value: entity.proofBank.countriesCount,
    label: "countries",
    // globe
    icon: '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.500 5.600 12 3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>',
  },
  {
    value: entity.proofBank.tedxAshSolo,
    label: "TEDx speaker",
    // microphone
    icon: '<rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.7"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
  },
  {
    value: entity.proofBank.studentsTaught,
    label: "students taught",
    // graduation cap
    icon: '<path d="M12 5L2 9l10 4 10-4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M6 11v4c0 1.500 3 3 6 3s6-1.500 6-3v-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
  },
];
---

<section class="bg-white px-4 py-10 md:py-14">
  <div class="trust-card">
    <p class="trust-kicker" data-reveal="none">
      <span aria-hidden="true"></span>
      {entity.legalName} in numbers
      <span aria-hidden="true"></span>
    </p>
    <div class="trust-grid" data-reveal="children">
      {stats.map((s) => (
        <div class="stat-item" data-reveal="item">
          <span class="stat-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" set:html={s.icon} />
          </span>
          <p class="stat-value"><span data-count-up>{s.value}</span></p>
          <p class="stat-label">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust-card {
    position: relative;
    overflow: hidden;
    max-width: 76rem;
    margin-inline: auto;
    padding: 2rem 1.25rem 2.25rem;
    border-radius: 28px;
    color: var(--color-offwhite-100);
    background:
      radial-gradient(ellipse 60% 90% at 50% -20%, rgba(255, 217, 138, 0.22), transparent 70%),
      radial-gradient(ellipse 35% 70% at 0% 100%, rgba(27, 58, 102, 0.9), transparent 70%),
      radial-gradient(ellipse 35% 70% at 100% 100%, rgba(27, 58, 102, 0.9), transparent 70%),
      var(--color-navy-900);
    box-shadow: 0 34px 70px -38px rgba(8, 31, 51, 0.7);
  }
  @media (min-width: 768px) {
    .trust-card {
      padding: 2.5rem 2.5rem 3rem;
      border-radius: 32px;
    }
  }

  /* A small centered label with a hairline running out to each side. */
  .trust-kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-gold-300);
  }
  .trust-kicker span {
    flex: 1;
    max-width: 7rem;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(255, 217, 138, 0.5));
  }
  .trust-kicker span:last-child {
    background: linear-gradient(to left, transparent, rgba(255, 217, 138, 0.5));
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1rem;
    margin-top: 2rem;
  }
  @media (min-width: 768px) {
    .trust-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      margin-top: 2.5rem;
    }
    .stat-item + .stat-item {
      border-left: 1px solid rgba(255, 217, 138, 0.18);
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-inline: 0.5rem;
    text-align: center;
  }
  .stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 14px;
    background: rgba(255, 217, 138, 0.14);
    color: var(--color-gold-300);
    transition: background-color var(--duration-base) var(--ease-hover), color var(--duration-base) var(--ease-hover),
      transform var(--duration-base) var(--ease-out);
  }
  .stat-value {
    margin-top: 1.1rem;
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 2rem + 2.6vw, 4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-gold-300);
  }
  .stat-label {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    font-weight: 500;
    opacity: 0.82;
  }
  /* Hovering a stat fills its icon tile gold and lifts it a touch. */
  @media (hover: hover) and (pointer: fine) {
    .stat-item:hover .stat-icon {
      background: var(--color-gold-300);
      color: var(--color-navy-900);
      transform: translateY(-3px);
    }
  }
</style>
