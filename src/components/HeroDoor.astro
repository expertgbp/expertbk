---
import { entity } from "../data/entity";

interface Props {
  eyebrow: string;
  heading: string;
  subhead: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  microTrust?: string;
  /**
   * Optional checkmark trust-strip directly under the CTA row. Real,
   * short facts only (pull from src/data/entity.ts) — never an invented
   * claim, discount, or urgency line. Structural pattern only, adapted
   * from a GHL roofing-niche reference site to this brand's own facts.
   */
  trustPoints?: string[];
  ctaId?: string;
  /** Homepage only: adds the drifting particle field + pointer-parallax on
   * the light beam. Kept off other pages' heroes so their JS/paint cost
   * stays minimal — see src/scripts/hero-particles.ts. */
  showParticles?: boolean;
  /**
   * The floating "method card" on the right (desktop, lg+ only). Visualizes
   * entity.method.stages — the real, named EPIC Publishing Path — as a
   * browser-chrome mockup panel. Adapted from the same GHL reference's
   * "live pipeline" dashboard card, but deliberately not a fake live feed
   * of invented customer activity: it shows this brand's own published
   * methodology, not a specific unverifiable claim. On by default since
   * it's brand-level, not homepage-specific; opt out per page if a hero's
   * layout can't spare the room.
   */
  showMethodCard?: boolean;
}
const {
  eyebrow,
  heading,
  subhead,
  primaryLabel = "Book a Free Book Strategy Call",
  primaryHref = "/book-a-call",
  secondaryLabel = "Get the Expert Book Blueprint (free)",
  secondaryHref = "/free-blueprint",
  microTrust,
  trustPoints,
  ctaId = "hero",
  showParticles = false,
  showMethodCard = true,
} = Astro.props;

// One consistent-stroke icon per stage, matched by key rather than index so
// this stays correct if entity.method.stages is reordered.
const stageIcons: Record<string, string> = {
  engineer:
    '<circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.4"/><circle cx="10" cy="10" r="1.6" fill="currentColor"/><path d="M10 3v2.2M10 14.8V17M17 10h-2.2M5.2 10H3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
  produce:
    '<path d="M4 16l.7-3L13.5 4.2a1.4 1.4 0 0 1 2 0l.3.3a1.4 1.4 0 0 1 0 2L7 15.3 4 16z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M12 5.8l2.2 2.2" stroke="currentColor" stroke-width="1.4"/>',
  ignite:
    '<path d="M10 3c1.2 2.3 3.6 3.8 3.6 7a3.6 3.6 0 1 1-7.2 0c0-1 .3-1.8.8-2.6.3.7 1 1.2 1 1.2-.3-2 .4-3.8 1.8-5.6z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>',
  compound:
    '<path d="M3.5 13.5l4-4 2.5 2.5 6-6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M12.5 4.5h3.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<section class="relative overflow-hidden bg-navy-900 text-offwhite-100" data-particles-host={showParticles ? "" : undefined}>
  <!-- The book-as-a-door motif: gold light through an opening spine, no stock photography.
       Two layered glows give it depth instead of one flat gradient; both stay behind the
       content column (z-0 vs z-10) and are toned down at narrow widths so they never compete
       with wrapped headline text on mobile. -->
  <div class="pointer-events-none absolute inset-0 z-0 opacity-60 md:opacity-90" aria-hidden="true">
    <div class="absolute inset-y-0 right-[-15%] w-[70%] bg-gradient-to-l from-gold-300/25 via-gold-300/5 to-transparent"></div>
    <div class="absolute -bottom-1/3 -left-1/4 h-[70%] w-[60%] rounded-full bg-navy-600/40 blur-3xl"></div>
    <div
      class="absolute inset-y-[8%] right-[18%] w-[3px] rounded-full bg-gold-300/80 blur-[0.5px]"
      data-hero-beam
    >
    </div>
  </div>

  {showParticles && (
    <canvas class="pointer-events-none absolute inset-0 z-[1]" aria-hidden="true" data-particles></canvas>
  )}

  <div class="relative z-10 mx-auto max-w-7xl px-4 py-20 md:py-32 hero-enter grid gap-12 lg:grid-cols-[1fr_380px] lg:items-center">
    <div>
      <p class="eyebrow mb-4">{eyebrow}</p>
      <h1 class="max-w-3xl on-navy">{heading}</h1>
      <p class="mt-6 max-w-2xl text-lg opacity-90">{subhead}</p>
      <div class="mt-9 flex flex-wrap gap-x-3 gap-y-4">
        <a href={primaryHref} class="btn-primary btn-signature" data-cta={`${ctaId}-call`} data-magnetic>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <rect x="2.5" y="3.5" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.4" />
            <path d="M2.5 7h13M5.5 2v3M12.5 2v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            <path d="M6.5 11l1.8 1.8L11.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {primaryLabel}
        </a>
        <a href={secondaryHref} class="btn-secondary on-navy" data-cta={`${ctaId}-blueprint`}>
          <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
            <path d="M8.5 2v9.5M4.5 8l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M2.5 13.5v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          {secondaryLabel}
        </a>
      </div>
      {trustPoints && trustPoints.length > 0 && (
        <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2" aria-label="At a glance">
          {trustPoints.map((point) => (
            <li class="inline-flex items-center gap-1.5 text-sm font-medium opacity-90">
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" class="shrink-0 text-gold-300" aria-hidden="true">
                <circle cx="7.5" cy="7.5" r="7" stroke="currentColor" stroke-width="1.3" />
                <path d="M4.5 7.7l2 2 4-4.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {point}
            </li>
          ))}
        </ul>
      )}
      {microTrust && (
        <p class="mt-8 inline-flex items-center gap-2 border-t border-offwhite-100/15 pt-5 text-sm opacity-70">
          {microTrust}
        </p>
      )}
    </div>

    <!-- The right-side visual: a floating mockup card, adapted from a GHL
         reference site's product-dashboard hero panel. What it shows is
         real and brand-specific rather than invented: the four named
         stages of entity.method (the EPIC Publishing Path), not a fake
         live feed of unverifiable customer activity. Hidden below `lg`
         rather than reflowed, so it never competes with headline text on
         tablet/mobile — the exact discipline the layered gradients above
         already follow. -->
    {showMethodCard && (
      <div class="hidden lg:block method-card" aria-hidden="true">
        <div class="method-card-bar">
          <span class="method-dot" style="background:#E6B85C"></span>
          <span class="method-dot"></span>
          <span class="method-dot"></span>
          <b>{entity.method.name}</b>
        </div>
        {entity.method.stages.map((stage, i) => (
          <div class="method-card-row">
            <span class="method-card-icon" set:html={`<svg width="20" height="20" viewBox="0 0 20 20" fill="none">${stageIcons[stage.key] ?? ""}</svg>`} />
            <span class="method-card-text">
              <strong>{stage.title}</strong>
              <small>{stage.description}</small>
            </span>
            <span class="method-card-badge">{i + 1}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  /*
    Floating method-mockup card. A lighter navy surface than the hero's
    own bg-navy-900 so it reads as a distinct panel, with a slow, subtle
    idle float (not an interaction effect, so no [data-magnetic]/GSAP
    needed) — gated by the sitewide prefers-reduced-motion override in
    global.css, which already zeroes every animation-duration.
  */
  .method-card {
    background: var(--color-navy-700);
    border: 1px solid var(--color-navy-600);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    padding: 1.1rem;
    animation: method-card-float 7s var(--ease-in-out) infinite alternate;
  }
  @keyframes method-card-float {
    from { transform: translateY(-4px); }
    to { transform: translateY(4px); }
  }
  .method-card-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.85rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-navy-600);
    font-size: 0.8rem;
    color: var(--color-offwhite-100);
    opacity: 0.85;
  }
  .method-card-bar b {
    margin-left: 0.35rem;
    font-weight: 600;
  }
  .method-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-navy-600);
  }
  .method-card-row {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.6rem 0;
  }
  .method-card-row + .method-card-row {
    border-top: 1px solid rgba(245, 241, 232, 0.06);
  }
  .method-card-icon {
    display: flex;
    flex-shrink: 0;
    color: var(--color-gold-300);
    margin-top: 0.1rem;
  }
  .method-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .method-card-text strong {
    font-family: var(--font-serif);
    font-size: 0.95rem;
  }
  .method-card-text small {
    font-size: 0.78rem;
    line-height: 1.4;
    opacity: 0.65;
  }
  .method-card-badge {
    margin-left: auto;
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-navy-900);
    background: var(--color-gold-300);
    border-radius: 999px;
    width: 1.4rem;
    height: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
