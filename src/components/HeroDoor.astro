---
/**
 * The homepage hero (inner pages use PageHero). Two columns on desktop:
 *
 *   left   a pill badge, the headline with one phrase picked out in gold
 *          (underlined by a line that draws itself in), the subhead, the
 *          two CTAs, and a short row of trust points
 *   right  a layered visual: the framed photo, a 3D book standing in front
 *          of its corner, and two floating proof chips
 *
 * Every number on the chips comes from src/data/entity.ts. The photo is a
 * real licensed one (hands only, no face; credit in design/image-log.md)
 * and the book is one of the bookshelf's placeholder covers.
 */
import { Image } from "astro:assets";
import { entity } from "../data/entity";
import BookCover from "./BookCover.astro";
import heroPhoto from "../assets/images/homepage/hero-book-photo.webp";
import heroBook from "../assets/images/placeholder-covers/placeholder-founder.webp";

interface Props {
  eyebrow: string;
  heading: string;
  /** A phrase inside `heading` to set in gold with the drawn underline.
   * Must match the heading text exactly; ignored if it doesn't. */
  highlight?: string;
  subhead: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  microTrust?: string;
  /** Short, real facts only (pull from src/data/entity.ts): never an
   * invented claim, discount, or urgency line. */
  trustPoints?: string[];
  ctaId?: string;
  /** Adds the cursor-reactive particle field (src/scripts/hero-particles.ts). */
  showParticles?: boolean;
  /** Shows the layered photo visual on the right (desktop only). */
  showPhoto?: boolean;
}
const {
  eyebrow,
  heading,
  highlight,
  subhead,
  primaryLabel = "Book a Free Book Strategy Call",
  primaryHref = "/book-a-call",
  secondaryLabel = "Get the Expert Book Blueprint (free)",
  secondaryHref = "/free-blueprint",
  microTrust,
  trustPoints,
  ctaId = "hero",
  showParticles = false,
  showPhoto = false,
} = Astro.props;

// Split the heading around the highlighted phrase, if there is one.
const at = highlight ? heading.indexOf(highlight) : -1;
const before = at >= 0 ? heading.slice(0, at) : heading;
const after = at >= 0 && highlight ? heading.slice(at + highlight.length) : "";
---

<section class="hero relative overflow-hidden bg-navy-900 text-offwhite-100" data-particles-host={showParticles ? "" : undefined}>
  <!-- Light: a warm gold pool behind the visual, a cooler navy one low on
       the left, and a fade into the next section along the bottom edge.
       All static, all behind the content. -->
  <div class="hero-light pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>

  {showParticles && (
    <canvas class="pointer-events-none absolute inset-0 z-[1]" aria-hidden="true" data-particles></canvas>
  )}

  <div class:list={["relative z-10 mx-auto max-w-7xl px-4 pt-12 pb-16 md:pt-16 md:pb-20 lg:pt-14 lg:pb-20 grid gap-14 lg:items-center", showPhoto && "lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)] lg:gap-10"]}>
    <div class="hero-enter min-w-0">
      <p class="hero-badge">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        {eyebrow}
      </p>
      <h1 class="hero-title on-navy">
        {before}{at >= 0 && <span class="hero-hl">{highlight}</span>}{after}
      </h1>
      <p class="direct-answer mt-5 max-w-2xl text-lg md:leading-relaxed opacity-90">{subhead}</p>
      <div class="mt-8 flex flex-col gap-3.5 sm:flex-row sm:flex-wrap sm:gap-x-4 sm:gap-y-4">
        <a href={primaryHref} class="btn-primary btn-signature hero-cta" data-cta={`${ctaId}-call`} data-magnetic>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <rect x="2.5" y="3.5" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.4" />
            <path d="M2.5 7h13M5.5 2v3M12.5 2v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            <path d="M6.5 11l1.8 1.8L11.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {primaryLabel}
        </a>
        <a href={secondaryHref} class="btn-secondary on-navy hero-cta" data-cta={`${ctaId}-blueprint`}>
          <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
            <path d="M8.5 2v9.5M4.5 8l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M2.5 13.5v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          {secondaryLabel}
        </a>
      </div>
      {((trustPoints && trustPoints.length > 0) || microTrust) && (
        <ul class="hero-trust" aria-label="At a glance">
          {trustPoints?.map((point) => (
            <li>
              <span class="hero-trust-check" aria-hidden="true">
                <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2l2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              {point}
            </li>
          ))}
          {microTrust && (
            <li>
              <span class="hero-trust-check" aria-hidden="true">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M12 2l2.7 6.1 6.6.6-5 4.5 1.5 6.5L12 16.6 6.2 19.7l1.5-6.5-5-4.5 6.6-.6z" fill="currentColor" /></svg>
              </span>
              {microTrust}
            </li>
          )}
        </ul>
      )}
    </div>

    <!-- Right-hand visual, desktop only (hidden rather than reflowed below
         lg, so it never competes with the headline on smaller screens). -->
    {showPhoto && (
      <div class="hero-visual hidden lg:block" aria-hidden="true">
        <div class="hero-frame">
          <Image src={heroPhoto} alt="" width={420} height={560} loading="eager" class="hero-photo" />
        </div>

        <div class="hero-book">
          <BookCover image={heroBook} alt="" />
        </div>

        <div class="hero-chip hero-chip-top">
          <span class="hero-chip-value">{entity.proofBank.authorsCount}</span>
          <span class="hero-chip-label">authors in {entity.proofBank.countriesCount} countries</span>
        </div>
        <div class="hero-chip hero-chip-bottom">
          <span class="hero-chip-icon">
            <svg width="16" height="16" viewBox="0 0 15 15" fill="none">
              <path d="M4.5 7.7l2 2 4-4.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="hero-chip-label"><strong>100%</strong> of rights and royalties stay yours</span>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hero-light {
    background:
      radial-gradient(ellipse 46% 62% at 78% 42%, rgba(255, 217, 138, 0.22), transparent 70%),
      radial-gradient(ellipse 50% 60% at 0% 100%, rgba(27, 58, 102, 0.75), transparent 70%),
      linear-gradient(to top, var(--color-navy-800), transparent 30%);
  }

  /* ---------- Left column ---------- */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    margin-bottom: 1.25rem;
    padding: 0.45rem 1rem 0.45rem 0.8rem;
    border: 1px solid rgba(255, 217, 138, 0.38);
    border-radius: 999px;
    background: rgba(27, 58, 102, 0.45);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--color-gold-300);
  }
  .hero-badge-dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-gold-300);
    box-shadow: 0 0 0 4px rgba(255, 217, 138, 0.2);
  }

  .hero-title {
    font-size: clamp(2.35rem, 1.75rem + 2.3vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  /* The one gold phrase in the headline. Its underline is a background
     strip (not a border or an SVG) so that when the phrase wraps, each
     line gets its own piece, and it draws in left to right once on load. */
  .hero-hl {
    color: var(--color-gold-300);
    font-style: italic;
    background-image: linear-gradient(var(--color-gold-500), var(--color-gold-500));
    background-repeat: no-repeat;
    background-position: 0 96%;
    background-size: 100% 3px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-bottom: 0.06em;
    animation: hero-hl-draw 900ms var(--ease-out) 650ms both;
  }
  @keyframes hero-hl-draw {
    from {
      background-size: 0% 3px;
    }
  }

  /* On phones both CTAs fill the row, stacked. */
  @media (max-width: 639px) {
    .hero-cta {
      width: 100%;
    }
  }

  .hero-trust {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(245, 241, 232, 0.14);
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .hero-trust li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    opacity: 0.92;
  }
  .hero-trust-check {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.02rem;
    border-radius: 999px;
    background: var(--color-gold-300);
    color: var(--color-navy-900);
  }
  @media (min-width: 768px) {
    .hero-trust {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.7rem 1.75rem;
    }
  }

  /* ---------- Right column: the layered visual ---------- */
  .hero-visual {
    position: relative;
    width: min(100%, 22.5rem);
    justify-self: center;
    animation: hero-visual-in 900ms var(--ease-out) 180ms both;
  }
  /* Arrives a beat after the headline, sliding in from the right: once
     per page load, transform/opacity only. */
  @keyframes hero-visual-in {
    from {
      opacity: 0;
      transform: translateX(32px);
    }
  }
  /* The photo, upright, with a gold outline offset behind it like a
     second frame. */
  .hero-frame {
    position: relative;
  }
  .hero-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--color-gold-300);
    border-radius: 30px;
    translate: 16px 16px;
    transition: translate 500ms var(--ease-out);
  }
  .hero-photo {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 30px;
    box-shadow: 0 40px 70px -30px rgba(3, 12, 22, 0.9);
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-visual:hover .hero-frame::before {
      translate: 8px 8px;
    }
  }

  /* A 3D book standing in front of the photo's lower-left corner. */
  .hero-book {
    position: absolute;
    left: -3.25rem;
    bottom: -1.75rem;
    width: 8.75rem;
    aspect-ratio: 2 / 3;
    animation: hero-chip-in 700ms var(--ease-out) 600ms both;
  }

  .hero-chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border-radius: 16px;
    background: #fff;
    color: var(--color-navy-900);
    box-shadow: 0 18px 36px -14px rgba(3, 12, 22, 0.7);
    animation: hero-chip-in 600ms var(--ease-out) both, hero-chip-float 6s var(--ease-in-out) infinite alternate;
  }
  .hero-chip-top {
    top: 2rem;
    left: -3rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    animation-delay: 750ms, 1.4s;
  }
  .hero-chip-bottom {
    right: -1.25rem;
    bottom: 3.5rem;
    max-width: 14.5rem;
    animation-delay: 900ms, 2.3s;
  }
  .hero-chip-value {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
  }
  .hero-chip-label {
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-slate-500);
  }
  .hero-chip-label strong {
    color: var(--color-navy-900);
  }
  .hero-chip-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--color-gold-300);
    color: var(--color-navy-900);
  }
  @keyframes hero-chip-in {
    from {
      opacity: 0;
      scale: 0.9;
    }
  }
  /* A slow idle drift (decorative, desktop-only since the whole visual is
     hidden below lg). Uses `translate` so it never fights the entrance. */
  @keyframes hero-chip-float {
    from { translate: 0 -4px; }
    to { translate: 0 5px; }
  }
</style>
