---
import { professionGroups } from "../data/nav";

interface Props {
  formId: string; // unique id, used for CRM tagging e.g. "free-blueprint"
  segmentTag: string; // e.g. "blueprint-doctor" — tags this variant in the CRM
  submitLabel?: string;
  redirectTo?: string;
}
const {
  formId,
  segmentTag,
  submitLabel = "Send me the Blueprint",
  redirectTo = "/thank-you/blueprint",
} = Astro.props;

// Slug (from the href) is the stable CRM tag value — a display label can
// be edited later without silently breaking existing tags. group is the
// heading's own slug, so leads can be segmented by market too (change-
// spec Change 5/B12, item 7).
const slugify = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<form
  class="space-y-4 max-w-md"
  data-lead-form
  data-form-id={formId}
  data-segment-tag={segmentTag}
  data-redirect={redirectTo}
  novalidate
>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium mb-1" for={`${formId}-firstName`}>First name</label>
      <input
        id={`${formId}-firstName`}
        name="firstName"
        type="text"
        required
        autocomplete="given-name"
        class="w-full rounded-lg border border-navy-100 px-3 py-2.5 bg-white text-ink-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
      />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for={`${formId}-email`}>Email</label>
      <input
        id={`${formId}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        class="w-full rounded-lg border border-navy-100 px-3 py-2.5 bg-white text-ink-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
      />
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium mb-1" for={`${formId}-profession`}>What best describes you?</label>
    <select
      id={`${formId}-profession`}
      name="profession"
      required
      class="w-full rounded-lg border border-navy-100 px-3 py-2.5 bg-white text-ink-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
    >
      <option value="">Choose one</option>
      {professionGroups.map((group) => (
        <optgroup label={group.heading}>
          {group.items.map((p) => (
            <option value={p.href.replace("/for/", "")} data-group={slugify(group.heading)}>{p.label}</option>
          ))}
        </optgroup>
      ))}
      <option value="something-else" data-group="">Something else</option>
    </select>
  </div>

  <!-- Honeypot: hidden from real users, catches basic bots -->
  <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  <p data-form-error class="hidden text-sm text-error-600" role="alert"></p>

  <button type="submit" class="btn-primary w-full sm:w-auto" data-cta={`form-${formId}`}>
    {submitLabel}
  </button>
  <p class="text-xs text-slate-500">No spam. Unsubscribe anytime.</p>
</form>

<script>
  import "../scripts/lead-form";
</script>

<style>
  /*
    lead-form.ts reveals this element by removing the `hidden` class; an
    animation on the "shown" state plays automatically the moment the
    element goes from display:none to rendered, giving the error a brief
    fade-in (feedback purpose) instead of a hard snap.
  */
  @keyframes form-error-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  [data-form-error]:not(.hidden) {
    animation: form-error-in var(--duration-fast) var(--ease-out);
  }
</style>
