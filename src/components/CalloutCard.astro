---
/**
 * A single statement that deserves its own card: icon tile and heading on
 * the left, the supporting text on the right. Used for "next step" and
 * "check us" moments that used to be a centered paragraph on a bare
 * background.
 *
 *   tone  "navy" (default): navy with the door glow, for the one moment on
 *         the page that should stop the eye.
 *         "gold": the quiet gold-100 highlight surface.
 *   icon  inner markup of a 24x24 line icon
 * The default slot is the body. Links inside it are styled for the tone.
 *
 * This is a card, not a section: put it inside a light section so two navy
 * surfaces never sit edge to edge.
 */
interface Props {
  heading: string;
  eyebrow?: string;
  icon?: string;
  tone?: "navy" | "gold";
}
const { heading, eyebrow, icon, tone = "navy" } = Astro.props;
---

<div class:list={["callout", `callout-${tone}`]} data-reveal="item">
  <div class="callout-head">
    {icon && (
      <span class="callout-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" set:html={icon} />
      </span>
    )}
    <div>
      {eyebrow && <p class="callout-eyebrow">{eyebrow}</p>}
      <h2 class="callout-title">{heading}</h2>
    </div>
  </div>
  <div class="callout-body">
    <slot />
  </div>
</div>

<style>
  .callout {
    position: relative;
    display: grid;
    gap: 1.5rem;
    overflow: hidden;
    padding: 1.75rem 1.5rem;
    border-radius: 24px;
  }
  @media (min-width: 768px) {
    .callout {
      padding: 2.5rem;
    }
  }
  @media (min-width: 1024px) {
    .callout {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: center;
      gap: 3.5rem;
      padding: 3.25rem 3.5rem;
      border-radius: 28px;
    }
  }
  .callout-head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .callout-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 16px;
  }
  .callout-eyebrow {
    margin-bottom: 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .callout-title {
    font-size: clamp(1.5rem, 1.3rem + 0.9vw, 2.1rem);
  }
  .callout-body {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  @media (min-width: 768px) {
    .callout-body {
      font-size: 1.125rem;
    }
  }
  .callout-body :global(p + p) {
    margin-top: 1rem;
  }
  .callout-body :global(a) {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transition: color var(--duration-fast) var(--ease-hover), text-decoration-color var(--duration-fast) var(--ease-hover);
  }

  /* Navy, with the same door glow as the hero and the final CTA. */
  .callout-navy {
    color: var(--color-offwhite-100);
    background:
      radial-gradient(ellipse 70% 80% at 100% 0%, rgba(255, 217, 138, 0.2), transparent 65%),
      radial-gradient(ellipse 50% 60% at 0% 100%, rgba(27, 58, 102, 0.7), transparent 70%),
      var(--color-navy-900);
    box-shadow: 0 40px 80px -40px rgba(8, 31, 51, 0.6);
  }
  .callout-navy .callout-icon {
    background: var(--color-gold-300);
    color: var(--color-navy-900);
  }
  .callout-navy .callout-eyebrow {
    color: var(--color-gold-300);
  }
  .callout-navy .callout-title {
    color: var(--color-offwhite-100);
  }
  .callout-navy .callout-body {
    color: rgba(245, 241, 232, 0.88);
  }
  .callout-navy .callout-body :global(a) {
    color: var(--color-gold-300);
    text-decoration-color: rgba(255, 217, 138, 0.45);
  }

  /* Gold-100: the quiet highlight. */
  .callout-gold {
    border: 1px solid rgba(230, 184, 92, 0.45);
    background:
      radial-gradient(ellipse 60% 80% at 100% 0%, rgba(255, 255, 255, 0.7), transparent 65%),
      var(--color-gold-100);
    color: var(--color-ink-900);
  }
  .callout-gold .callout-icon {
    background: var(--color-navy-900);
    color: var(--color-gold-300);
  }
  .callout-gold .callout-eyebrow {
    color: var(--color-navy-700);
  }
  .callout-gold .callout-body :global(a) {
    color: var(--color-navy-900);
    text-decoration-color: var(--color-gold-500);
  }

  @media (hover: hover) and (pointer: fine) {
    .callout-navy .callout-body :global(a:hover) {
      color: var(--color-offwhite-100);
      text-decoration-color: var(--color-gold-300);
    }
    .callout-gold .callout-body :global(a:hover) {
      color: var(--color-navy-600);
      text-decoration-color: var(--color-navy-600);
    }
  }
</style>
