---
/**
 * The "final door" every page ends on. No longer a flat full-width navy
 * band that melted into the navy footer: it is now its own rounded navy
 * card on the ivory page, lit by one warm gold glow from above over a
 * fine dotted field, with a gold hairline around its edge.
 *
 * Props are unchanged, so every page that already uses this keeps working.
 * The three points under the buttons are lines already used in the
 * homepage hero, nothing new is claimed here.
 */
interface Props {
  heading?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  heading = "Your book has waited long enough.",
  body = "One call. A real read on your idea, your positioning, and your path, whether or not we work together.",
  primaryLabel = "Book a Free Book Strategy Call",
  primaryHref = "/book-a-call",
  secondaryLabel = "Or start with the free Blueprint",
  secondaryHref = "/free-blueprint",
} = Astro.props;

const points = [
  "Keep 100% of your rights and royalties",
  "6 to 12 months, guided start to finish",
  "Founded by USA Today and Wall Street Journal bestselling authors",
];
---

<section class="final-door bg-ivory-50 px-4 pt-6 pb-16 md:pt-10 md:pb-24">
  <div class="door-card">
    <!-- Decorative layers: a soft gold light from above, and a dot field. -->
    <div class="door-light" aria-hidden="true"></div>
    <div class="door-dots" aria-hidden="true"></div>

    <div class="door-content">
      <p class="door-chip">
        <svg width="15" height="15" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <rect x="2.5" y="3.5" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.5" />
          <path d="M2.5 7h13M5.5 2v3M12.5 2v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        Free strategy call
      </p>
      <h2 class="on-navy door-heading">{heading}</h2>
      <p class="door-body">{body}</p>

      <div class="door-actions">
        <a href={primaryHref} class="btn-primary btn-signature" data-cta="final-door-call" data-magnetic>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <rect x="2.5" y="3.5" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.4" />
            <path d="M2.5 7h13M5.5 2v3M12.5 2v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            <path d="M6.5 11l1.8 1.8L11.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {primaryLabel}
        </a>
        <a href={secondaryHref} class="btn-secondary on-navy" data-cta="final-door-blueprint">{secondaryLabel}</a>
      </div>

      <ul class="door-points">
        {points.map((point) => (
          <li>
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
              <circle cx="7.5" cy="7.5" r="7" stroke="currentColor" stroke-width="1.3" />
              <path d="M4.5 7.7l2 2 4-4.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {point}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .door-card {
    position: relative;
    overflow: hidden;
    max-width: 76rem;
    margin-inline: auto;
    padding: 4rem 1.25rem 3.5rem;
    border-radius: 28px;
    text-align: center;
    color: var(--color-offwhite-100);
    background: var(--color-navy-900);
    box-shadow: 0 40px 80px -40px rgba(8, 31, 51, 0.65);
  }
  @media (min-width: 768px) {
    .door-card {
      padding: 6.5rem 3rem 5.5rem;
      border-radius: 40px;
    }
  }

  /* A fine gold dot field, faded out toward the edges so it reads as
     texture behind the door, not a pattern over the whole card. */
  .door-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 217, 138, 0.16) 1px, transparent 1.6px);
    background-size: 28px 28px;
    /* visible around the edges, cleared out behind the text */
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, transparent 45%, #000 100%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, transparent 45%, #000 100%);
  }

  /* Light: one warm gold glow falling from the top center (like a lamp
     over the card), with two cooler navy pools in the lower corners for
     depth. No shapes or lines behind the text, just light. */
  .door-light {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 55% 60% at 50% -8%, rgba(255, 217, 138, 0.34), transparent 70%),
      radial-gradient(ellipse 40% 55% at 0% 100%, rgba(27, 58, 102, 0.85), transparent 70%),
      radial-gradient(ellipse 40% 55% at 100% 100%, rgba(27, 58, 102, 0.85), transparent 70%);
  }
  /* A thin gold hairline inside the card's edge, brightest at the top. */
  .door-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255, 217, 138, 0.55), rgba(255, 217, 138, 0.06) 60%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }

  .door-content {
    position: relative;
    z-index: 1;
    max-width: 44rem;
    margin-inline: auto;
  }
  .door-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(255, 217, 138, 0.45);
    border-radius: 999px;
    background: rgba(8, 31, 51, 0.55);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-300);
  }
  .door-heading {
    margin-top: 1.5rem;
    font-size: clamp(2rem, 1.5rem + 2.4vw, 3.4rem);
    line-height: 1.1;
  }
  .door-body {
    max-width: 36rem;
    margin: 1.25rem auto 0;
    font-size: 1.125rem;
    line-height: 1.65;
    opacity: 0.88;
  }
  .door-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }
  @media (min-width: 640px) {
    .door-actions {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }
  }
  /* A solid backing so the dot field never shows through the label. */
  .door-actions .btn-secondary {
    background-color: rgba(8, 31, 51, 0.6);
  }
  .door-points {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.5rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .door-points li {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.5rem;
    text-align: left;
    opacity: 0.85;
  }
  .door-points svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--color-gold-300);
  }
  @media (min-width: 900px) {
    .door-points {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem 1.75rem;
    }
  }
</style>
