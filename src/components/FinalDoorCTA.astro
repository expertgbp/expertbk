---
interface Props {
  heading?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  heading = "Your book has waited long enough.",
  body = "One call. A real read on your idea, your positioning, and your path, whether or not we work together.",
  primaryLabel = "Book a Free Book Strategy Call",
  primaryHref = "/book-a-call",
  secondaryLabel = "Or start with the free Blueprint",
  secondaryHref = "/free-blueprint",
} = Astro.props;
---

<section class="relative overflow-hidden bg-navy-900 text-offwhite-100">
  <!-- Same door-glow language as the hero, quieter here: one signature
       treatment for the site's two primary-CTA moments, not two different
       inventions. -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-full w-[140%] -translate-x-1/2 bg-[radial-gradient(ellipse_60%_60%_at_50%_0%,rgba(255,217,138,0.16),transparent_70%)]"></div>
  </div>
  <div class="relative z-10 mx-auto max-w-3xl px-4 py-16 sm:py-20 text-center">
    <h2 class="on-navy">{heading}</h2>
    <p class="mt-4 text-lg opacity-90">{body}</p>
    <div class="mt-8 flex flex-col items-center gap-4">
      <a href={primaryHref} class="btn-primary btn-signature" data-cta="final-door-call" data-magnetic>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <rect x="2.5" y="3.5" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.4" />
          <path d="M2.5 7h13M5.5 2v3M12.5 2v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          <path d="M6.5 11l1.8 1.8L11.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {primaryLabel}
      </a>
      <a
        href={secondaryHref}
        class="inline-flex items-center justify-center min-h-11 px-2 text-sm underline underline-offset-2 opacity-80 hover:opacity-100"
        data-cta="final-door-blueprint"
      >
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>
