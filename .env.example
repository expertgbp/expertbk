# Copy to .env and fill in when providers are chosen. Nothing here is
# required for the site to build or run locally — every feature that
# depends on these degrades to a clear placeholder state without them.

# Where lead-magnet, quiz, and contact form submissions are POSTed
# (Zapier webhook, HubSpot form endpoint, a custom API route, etc).
# See src/scripts/lead-form.ts. Set to /api/submit-lead to use this
# project's own GoHighLevel integration (functions/api/submit-lead.js)
# instead of an external webhook.
PUBLIC_FORM_ENDPOINT_URL=/api/submit-lead

# Embed URL for the /book-a-call calendar (e.g. a Calendly single-event
# embed link). See src/pages/book-a-call.astro.
PUBLIC_BOOKING_EMBED_URL=

# Live Cloudflare Pages preview URL for the current deployment (the
# expertbk.pages.dev project). Not the final production domain — see
# `site` in astro.config.mjs for that.
PUBLIC_CF_PAGES_URL=

# GoHighLevel (LeadConnector) API key and location ID. Server-side only:
# never reference these from client-side code or prefix them PUBLIC_. Read
# by functions/api/submit-lead.js to upsert a tagged contact on every form
# submission. Set as environment variables in the Cloudflare Pages
# dashboard for the deployed site (this file has no effect there); for
# local `wrangler pages dev` testing, put the real values in .dev.vars
# instead (also gitignored).
GHL_API_KEY=
GHL_LOCATION_ID=
